@{
    ViewData["Title"] = "备件生命周期";
}
<div class="layui-fluid" style="padding:12px;">
    <div class="layui-card">
        <div class="layui-card-header"><strong>备件生命周期</strong>
            <button class="layui-btn layui-btn-sm" id="btnAdd" style="float:right;margin-top:6px;">登记事件</button>
        </div>
        <div class="layui-card-body"><table id="GridMain" lay-filter="GridMain"></table></div>
    </div>
</div>
<script type="text/html" id="barRow">
    <a class="layui-btn layui-btn-xs layui-btn-danger" lay-event="del">删除</a>
</script>
<script type="text/html" id="tplForm">
    <div style="padding:16px;"><form class="layui-form" lay-filter="f">
        <div class="layui-form-item">
            <div class="layui-inline"><label class="layui-form-label">备件Id</label><div class="layui-input-inline"><input type="number" name="SpareId" class="layui-input" lay-verify="required"></div></div>
            <div class="layui-inline"><label class="layui-form-label">事件类型</label><div class="layui-input-inline"><select name="EventType">
                <option value="采购入库">采购入库</option><option value="领用出库">领用出库</option><option value="报废">报废</option><option value="退库">退库</option><option value="盘盈">盘盈</option><option value="盘亏">盘亏</option>
            </select></div></div>
        </div>
        <div class="layui-form-item">
            <div class="layui-inline"><label class="layui-form-label">数量</label><div class="layui-input-inline"><input type="number" step="0.001" name="Qty" class="layui-input"></div></div>
            <div class="layui-inline"><label class="layui-form-label">关联单号</label><div class="layui-input-inline"><input type="text" name="RefBillNo" class="layui-input"></div></div>
        </div>
        <div class="layui-form-item layui-form-text"><label class="layui-form-label">备注</label><div class="layui-input-block"><textarea name="Remark" class="layui-textarea"></textarea></div></div>
        <div style="text-align:center;margin-top:10px;"><button class="layui-btn" lay-submit lay-filter="save">保存</button><button class="layui-btn layui-btn-primary" type="button" id="cancel">关闭</button></div>
    </form></div>
</script>
@section Script{
<script>
    var U_LIST='@Url.Action("GetMainList")',U_SAVE='@Url.Action("Save")',U_DEL='@Url.Action("Delete")';
    layui.use(['table','form','layer'],function(){
        var table=layui.table,form=layui.form,layer=layui.layer,$=layui.$;
        function ok(r){return r&&(r.code===0||r.code===200);}
        function dt(v){return v?String(v).replace('T',' ').substring(0,19):'';}
        function render(){table.render({elem:'#GridMain',id:'GridMain',url:U_LIST,method:'post',where:{page:1,limit:20,searchParam:[]},page:true,height:'full-150',cols:[[
            {type:'numbers',title:'#'},{field:'SpareId',title:'备件Id',width:100},{field:'EventType',title:'事件类型',width:130},
            {field:'EventDate',title:'时间',width:170,templet:function(d){return dt(d.EventDate);}},{field:'Qty',title:'数量',width:110,align:'right'},
            {field:'RefBillNo',title:'关联单号',width:160},{field:'Operator',title:'操作人',width:110},{field:'Remark',title:'备注',minWidth:160},
            {title:'操作',width:100,toolbar:'#barRow',fixed:'right'}]]});}
        function openForm(){layer.open({type:1,area:['640px','auto'],title:'登记生命周期事件',content:$('#tplForm').html(),success:function(l,idx){
            form.render();$('#cancel').on('click',function(){layer.close(idx);});
            form.on('submit(save)',function(data){var f=data.field;var p={Id:0,SpareId:parseInt(f.SpareId||0,10),EventType:f.EventType,Qty:f.Qty?parseFloat(f.Qty):null,RefBillNo:f.RefBillNo||null,Remark:f.Remark||null};
                $.ajax({url:U_SAVE,method:'POST',contentType:'application/json',data:JSON.stringify(p)}).done(function(r){if(ok(r)){layer.msg('已登记',{icon:1});layer.close(idx);table.reload('GridMain');}else layer.msg((r&&r.msg)||'失败',{icon:2});});return false;});
        }});}
        $('#btnAdd').on('click',openForm);
        table.on('tool(GridMain)',function(o){if(o.event==='del')layer.confirm('确认删除?',function(idx){$.post(U_DEL,{id:o.data.Id},function(){layer.close(idx);o.del();});});});
        render();
    });
</script>
}
