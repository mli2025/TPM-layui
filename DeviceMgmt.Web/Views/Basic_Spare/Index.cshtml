@{
    ViewData["Title"] = "\u5907\u4ef6\u8d44\u6599 Basic_Spare";
}
<div class="layui-fluid" style="padding:0;margin-top:10px">
    <div class="layui-row layui-col-space15">
        <div class="layui-col-md12">
            <div class="layui-card">
                <div class="layui-card-header">
                    <div class="pull-left">@("\u5907\u4ef6\u8d44\u6599 Basic_Spare")</div>
                    <div class="demoTable pull-right no-print">
                        <div class="layui-inline" id="searchPanel"></div>
                        <div class="layui-btn-group">
                            <button class="layui-btn layui-btn-sm layui-btn-warm" id="btn_Export">@("\u5bfc\u51fa")</button>
                        </div>
                    </div>
                </div>
                <div class="layui-card-body" style="padding:0">
                    <div class="layui-inline" style="width:100%">
                        <table class="layui-hide" lay-filter="GridMain" id="GridMain"></table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Script{
    <script type='text/html' class="no-print" id='barDemo'>
        <a class='layui-btn layui-btn-xs layui-btn-normal' lay-event='viewModel'>&#x67e5;&#x770b;</a>
    </script>
    <script>
        var URLThisGetList = '@Url.Action("GetMainList")';
        var URLThisExportList = '@Url.Action("ExportExcel")';
        var Cols = [
            { field: 'Id', title: 'Id', width: 80, sort: true },
            { field: 'Code', title: 'Code', search: 'input', width: 130 },
            { field: 'Name', title: 'Name', search: 'input', width: 170 },
            { field: 'Specs', title: 'Specs', search: 'input', width: 130 },
            { field: 'SafeStock', title: 'SafeStock', search: 'input', width: 110 },
            { field: 'Remark', title: 'Remark', search: 'input', width: 170 },
            { field: 'Status', title: 'Status', search: 'input', width: 110 },
            { field: 'Leibie', title: 'Leibie', search: 'input', width: 130 },
            { field: 'Danjia', title: 'Danjia', search: 'input', width: 110 },
            { field: 'Kehu', title: 'Kehu', search: 'input', width: 130 },
            { field: 'Danwei', title: 'Danwei', search: 'input', width: 130 },
            { fixed: 'right', title: '\u64cd\u4f5c', width: 90, align: 'center', toolbar: '#barDemo' }
        ];
        function viewModel(obj) {
            var Id = obj.data.Id || obj.data.id;
            layui.layer.open({
                title: '\u5907\u4ef6\u8d44\u6599 Basic_Spare - \u67e5\u770b',
                content: '@Url.Action("ViewList")?id=' + Id,
                type: 2,
                area: ['90%', '90%'],
                btn: ['\u5173\u95ed']
            });
        }
    </script>
    <script src="~/js/Page/NomalListPage.js"></script>
}