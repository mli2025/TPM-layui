@{
    ViewData["Title"] = "设备保养模板列表";
}
<div class="layui-fluid" style="padding:12px;">
    <div class="layui-card">
        <div class="layui-card-header"><strong>设备保养模板列表</strong></div>
        <div class="layui-card-body">
            <div class="layui-form layui-row layui-col-space10" style="margin-bottom:8px;">
                <div class="layui-col-md6">
                    <input type="text" id="kwTpl" class="layui-input" placeholder="输入模板编号、模板名称关键字">
                </div>
                <div class="layui-col-md6" style="text-align:right;">
                    <button class="layui-btn layui-btn-sm" id="btnTplAdd"><i class="layui-icon layui-icon-add-1"></i> 新建</button>
                    <button class="layui-btn layui-btn-sm layui-btn-primary" id="btnTplReload"><i class="layui-icon layui-icon-refresh-3"></i> 刷新</button>
                </div>
            </div>
            <table id="GridTpl" lay-filter="GridTpl"></table>
        </div>
    </div>
</div>

<script type="text/html" id="barTpl">
    <a class="layui-btn layui-btn-xs" lay-event="detail">编辑明细</a>
    <a class="layui-btn layui-btn-xs layui-btn-danger" lay-event="del">删除</a>
</script>

<script type="text/html" id="tplMainForm">
    <form class="layui-form" lay-filter="mainForm" style="padding:14px 16px 0 0;">
        <input type="hidden" name="Id">
        <input type="hidden" name="Type" value="2">
        <div class="layui-form-item">
            <label class="layui-form-label">模板编号</label>
            <div class="layui-input-block"><input name="HNumber" required lay-verify="required" class="layui-input"></div>
        </div>
        <div class="layui-form-item">
            <label class="layui-form-label">模板名称</label>
            <div class="layui-input-block"><input name="HName" required lay-verify="required" class="layui-input"></div>
        </div>
        <div class="layui-form-item">
            <label class="layui-form-label">日期</label>
            <div class="layui-input-block"><input name="Hdate" id="hdateInput" class="layui-input"></div>
        </div>
        <div class="layui-form-item">
            <label class="layui-form-label">状态</label>
            <div class="layui-input-block">
                <select name="Status">
                    <option value="1">启用</option>
                    <option value="0">禁用</option>
                </select>
            </div>
        </div>
    </form>
</script>

<script type="text/html" id="tplSubForm">
    <form class="layui-form" lay-filter="subForm" style="padding:14px 16px 0 0;">
        <input type="hidden" name="Id">
        <input type="hidden" name="MainId">
        <div class="layui-form-item">
            <label class="layui-form-label">项目</label>
            <div class="layui-input-block"><input name="HContent" required lay-verify="required" class="layui-input"></div>
        </div>
        <div class="layui-form-item">
            <label class="layui-form-label">方法</label>
            <div class="layui-input-block"><input name="HMethods" class="layui-input"></div>
        </div>
        <div class="layui-form-item">
            <label class="layui-form-label">标准描述</label>
            <div class="layui-input-block"><input name="HStandard" class="layui-input"></div>
        </div>
        <div class="layui-form-item">
            <label class="layui-form-label">控件类型</label>
            <div class="layui-input-block">
                <select name="ControlType">
                    <option value="0">是否类型</option>
                    <option value="1">数值类型</option>
                </select>
            </div>
        </div>
        <div class="layui-form-item">
            <label class="layui-form-label">最小值</label>
            <div class="layui-input-block"><input name="MinValue" type="number" step="0.01" class="layui-input"></div>
        </div>
        <div class="layui-form-item">
            <label class="layui-form-label">最大值</label>
            <div class="layui-input-block"><input name="MaxValue" type="number" step="0.01" class="layui-input"></div>
        </div>
    </form>
</script>

@section Script{
    <script>
        layui.use(['table', 'form', 'layer', 'laydate'], function () {
            var table = layui.table, form = layui.form, layer = layui.layer, laydate = layui.laydate;
            function ok(res) { return res && (res.code === 0 || res.code === 200); }

            function getMainWhere() {
                var list = [{ field: 'Type', conditional: 'eq', value: '2' }];
                var kw = $('#kwTpl').val();
                if (kw) list.push({ field: 'HName', conditional: 'like', value: kw });
                return { page: 1, limit: 20, searchParam: list };
            }

            function renderMain() {
                table.render({
                    elem: '#GridTpl',
                    id: 'GridTpl',
                    url: '@Url.Action("GetMainList")',
                    method: 'post',
                    where: getMainWhere(),
                    page: true,
                    height: 'full-250',
                    cols: [[
                        { type: 'numbers', title: '#' },
                        { field: 'HNumber', title: '设备保养模板编号', width: 190 },
                        { field: 'HName', title: '设备保养模板名称', minWidth: 220 },
                        { field: 'MaintenanceType', title: '保养类型', width: 120 },
                        { field: 'Maker', title: '制单人', width: 100 },
                        { field: 'CheckDate', title: '创建时间', width: 160, templet: function (d) { return d.CheckDate ? d.CheckDate.substring(0, 16).replace('T', ' ') : ''; } },
                        { field: 'Status', title: '状态', width: 90, templet: function (d) { return d.Status == 1 ? '启用' : '禁用'; } },
                        { title: '操作', width: 150, toolbar: '#barTpl', fixed: 'right' }
                    ]]
                });
            }

            function openMainForm(data, next) {
                var payload = data || { Id: 0, Status: 1, Type: 2, Hdate: new Date().toISOString().substring(0, 10) };
                layer.open({
                    type: 1,
                    area: ['600px', '380px'],
                    title: payload.Id ? '编辑设备保养模板' : '新增设备保养模板',
                    content: $('#tplMainForm').html(),
                    btn: ['保存', '关闭'],
                    success: function () {
                        form.render();
                        laydate.render({ elem: '#hdateInput' });
                        form.val('mainForm', payload);
                    },
                    yes: function (idx) {
                        var row = form.val('mainForm');
                        row.Type = 2;
                        $.post('@Url.Action("SaveTemplate")', row, function (res) {
                            if (ok(res)) {
                                layer.close(idx);
                                table.reload('GridTpl', { where: getMainWhere() });
                                App.success('保存成功');
                                if (next) next(res.data || row.Id);
                            } else App.error(res.msg || '保存失败');
                        });
                    }
                });
            }

            function openSubForm(mainId, data, reloadFn) {
                var payload = data || { Id: 0, MainId: mainId, ControlType: 0 };
                layer.open({
                    type: 1,
                    area: ['560px', '480px'],
                    title: payload.Id ? '模板编辑明细' : '模板新增明细',
                    content: $('#tplSubForm').html(),
                    btn: ['保存', '关闭'],
                    success: function () {
                        form.render();
                        form.val('subForm', payload);
                    },
                    yes: function (idx) {
                        var row = form.val('subForm');
                        row.MainId = mainId;
                        $.post('@Url.Action("SaveTemplateSub")', row, function (res) {
                            if (ok(res)) {
                                layer.close(idx);
                                reloadFn();
                                App.success('保存成功');
                            } else App.error(res.msg || '保存失败');
                        });
                    }
                });
            }

            function openDetail(mainRow) {
                var html = '' +
                    '<div style="padding:12px;">' +
                    '<div class="layui-form layui-row layui-col-space8" style="margin-bottom:8px;">' +
                    '<div class="layui-col-md3"><input id="dNo" class="layui-input" readonly value="' + (mainRow.HNumber || '') + '"></div>' +
                    '<div class="layui-col-md3"><input id="dName" class="layui-input" readonly value="' + (mainRow.HName || '') + '"></div>' +
                    '<div class="layui-col-md2"><input id="dDate" class="layui-input" readonly value="' + ((mainRow.Hdate || '').toString().substring(0, 10)) + '"></div>' +
                    '<div class="layui-col-md4" style="text-align:right;"><button class="layui-btn layui-btn-sm" id="btnSubAdd">新增</button><button class="layui-btn layui-btn-sm layui-btn-primary" id="btnSubRefresh">刷新</button></div>' +
                    '</div><table id="GridSub" lay-filter="GridSub"></table></div>';

                layer.open({
                    type: 1,
                    area: ['1100px', '680px'],
                    title: '设备保养模板明细',
                    content: html,
                    btn: ['保存模板', '关闭'],
                    success: function () {
                        renderSub(mainRow.Id);
                        $('#btnSubAdd').on('click', function () { openSubForm(mainRow.Id, null, function () { table.reload('GridSub'); }); });
                        $('#btnSubRefresh').on('click', function () { table.reload('GridSub'); });
                    },
                    yes: function (idx) {
                        layer.close(idx);
                    }
                });
            }

            window.subBar = function (d) {
                return '<a class="layui-btn layui-btn-xs" lay-event="edit">编辑</a><a class="layui-btn layui-btn-xs layui-btn-danger" lay-event="del">删除</a>';
            };

            function renderSub(mainId) {
                table.render({
                    elem: '#GridSub',
                    id: 'GridSub',
                    url: '@Url.Action("GetTemplateSubs")?mainId=' + mainId,
                    method: 'get',
                    page: false,
                    cols: [[
                        { type: 'numbers', title: '#' },
                        { field: 'HContent', title: '项目', minWidth: 200 },
                        { field: 'HMethods', title: '方法', minWidth: 220 },
                        { field: 'HStandard', title: '标准', minWidth: 160 },
                        { field: 'ControlType', title: '控件类型', width: 100, templet: function (d) { return d.ControlType == 1 ? '数值类型' : '是否类型'; } },
                        { field: 'MaxValue', title: '最大值', width: 90 },
                        { field: 'MinValue', title: '最小值', width: 90 },
                        { title: '操作', width: 130, templet: function (d) { return subBar(d); } }
                    ]]
                });

                table.on('tool(GridSub)', function (obj) {
                    if (obj.event === 'edit') openSubForm(mainId, obj.data, function () { table.reload('GridSub'); });
                    if (obj.event === 'del') {
                        layer.confirm('确认删除该明细？', function (idx) {
                            $.post('@Url.Action("DeleteTemplateSub")', { id: obj.data.Id }, function (res) {
                                layer.close(idx);
                                if (ok(res)) {
                                    obj.del();
                                    App.success('删除成功');
                                } else App.error(res.msg || '删除失败');
                            });
                        });
                    }
                });
            }

            $('#btnTplAdd').on('click', function () {
                openMainForm(null, function (id) {
                    if (id) {
                        $.get('@Url.Action("GetMainInfo")', { Id: id }, function (res) {
                            if (ok(res) && res.data) openDetail(res.data);
                        });
                    }
                });
            });
            $('#btnTplReload').on('click', function () { table.reload('GridTpl', { where: getMainWhere() }); });
            $('#kwTpl').on('keydown', function (e) { if (e.keyCode === 13) $('#btnTplReload').click(); });

            table.on('tool(GridTpl)', function (obj) {
                if (obj.event === 'detail') openDetail(obj.data);
                if (obj.event === 'del') {
                    layer.confirm('确认删除该模板及其明细？', function (idx) {
                        $.post('@Url.Action("DeleteTemplate")', { id: obj.data.Id }, function (res) {
                            layer.close(idx);
                            if (ok(res)) {
                                obj.del();
                                App.success('删除成功');
                            } else App.error(res.msg || '删除失败');
                        });
                    });
                }
            });

            renderMain();
            form.render();
        });
    </script>
}