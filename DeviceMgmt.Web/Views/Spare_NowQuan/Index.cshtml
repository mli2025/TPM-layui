@{
    ViewData["Title"] = "备件库存查询";
}
<div class="layui-fluid" style="padding:12px;">
    <div class="layui-card">
        <div class="layui-card-header">
            <strong>备件库存查询</strong>
        </div>
        <div class="layui-card-body">
            <div class="layui-form layui-row layui-col-space10" style="margin-bottom:8px;">
                <div class="layui-col-md4">
                    <input type="text" id="kw" class="layui-input" placeholder="备件编码 / 名称 / 规格 搜索" />
                </div>
                <div class="layui-col-md4">
                    <input type="number" id="whId" class="layui-input" placeholder="仓库 Id (可选)" />
                </div>
                <div class="layui-col-md4" style="text-align:right;">
                    <button class="layui-btn layui-btn-sm" id="btnSearch"><i class="layui-icon layui-icon-search"></i> 查询</button>
                    <button class="layui-btn layui-btn-sm layui-btn-primary" id="btnReload"><i class="layui-icon layui-icon-refresh-3"></i> 刷新</button>
                </div>
            </div>
            <table id="GridMain" lay-filter="GridMain"></table>
        </div>
    </div>
</div>

@section Script {
<script>
(function(){
    layui.use(['table'], function(){
        var table = layui.table, $ = layui.$;
        function build(){
            var arr = [];
            var kw = ($('#kw').val()||'').trim();
            var wh = ($('#whId').val()||'').trim();
            if (kw) arr.push({ field:'Kw', value: kw });
            if (wh) arr.push({ field:'WarehouseId', value: wh, conditional:'=' });
            return JSON.stringify(arr);
        }
        function load(){
            table.render({
                elem:'#GridMain', url:'@Url.Action("GetMainList")', method:'post',
                where:{ searchParam: build() },
                contentType:'application/x-www-form-urlencoded',
                page:true, limit:20, even:true,
                response:{ statusCode:0, statusName:'code', countName:'count', dataName:'data', msgName:'msg' },
                cols:[[
                    { field:'SpareCode', title:'备件编码', width:160 },
                    { field:'SpareName', title:'备件名称', width:200 },
                    { field:'Specs', title:'规格型号', width:160 },
                    { field:'Danwei', title:'单位', width:80 },
                    { field:'WarehouseId', title:'仓库Id', width:100 },
                    { field:'Qty', title:'当前库存', width:120, templet: function(d){
                        var qty = parseFloat(d.Qty)||0;
                        var safe = parseFloat(d.SafeStock)||0;
                        var color = (safe > 0 && qty < safe) ? 'color:#dc2626;font-weight:600;' : '';
                        return '<span style="' + color + '">' + qty + '</span>';
                    }},
                    { field:'SafeStock', title:'安全库存', width:120 }
                ]]
            });
        }
        $('#btnSearch').on('click', load);
        $('#btnReload').on('click', load);
        $('#kw').on('keyup', function(e){ if (e.keyCode===13) load(); });
        load();
    });
})();
</script>
}
