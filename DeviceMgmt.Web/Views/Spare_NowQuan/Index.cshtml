@{
    ViewData["Title"] = "库存查询";
}
<div class="layui-fluid" style="padding:12px;">
    <div class="layui-card">
        <div class="layui-card-header">
            <strong>库存查询</strong>
        </div>
        <div class="layui-card-body">
            <div class="layui-form layui-row layui-col-space10" style="margin-bottom:8px;">
                <div class="layui-col-md4">
                    <input type="text" id="kw" class="layui-input" placeholder="备件编码 / 名称 / 规格 搜索" />
                </div>
                <div class="layui-col-md4 ref-wh-wrap" data-clear="1" style="position:relative;">
                    <input type="hidden" id="whId">
                    <input type="text" readonly class="layui-input ref-pk-display" placeholder="仓库 (可选，点击选择)" style="cursor:pointer;padding-right:34px;background:#fff;">
                    <i class="layui-icon layui-icon-search ref-pk-btn" title="选择仓库" style="position:absolute;right:11px;top:1px;width:32px;height:36px;line-height:36px;text-align:center;cursor:pointer;color:#5FB878;"></i>
                </div>
                <div class="layui-col-md4" style="text-align:right;">
                    <button class="layui-btn layui-btn-sm" id="btnSearch"><i class="layui-icon layui-icon-search"></i> 查询</button>
                    <button class="layui-btn layui-btn-sm layui-btn-primary" id="btnReload"><i class="layui-icon layui-icon-refresh-3"></i> 刷新</button>
                    <button class="layui-btn layui-btn-sm layui-btn-warm" id="btnExport"><i class="layui-icon layui-icon-download-circle"></i> 导出</button>
                </div>
            </div>
            <table id="GridMain" lay-filter="GridMain"></table>
        </div>
    </div>
</div>

@section Script {
<script>
(function(){
    var $ = layui.$;
    function build(){
        var arr = [];
        var kw = ($('#kw').val()||'').trim();
        var wh = ($('#whId').val()||'').trim();
        if (kw) arr.push({ field:'Kw', value: kw });
        if (wh) arr.push({ field:'WarehouseId', value: wh, conditional:'=' });
        return JSON.stringify(arr);
    }
    function load(){
        SoulGrid.loadAll('@Url.Action("GetMainList")', { searchParam: build() }, function(rows){
            SoulGrid.render({
                elem:'#GridMain', id:'GridMain', data: rows, height:'full-180', filename:'备件库存',
                totalRow: true,
                cols:[[
                    { field:'SpareCode', title:'备件编码', width:160, fixed:'left', sort:true, filter:true, totalRowText:'合计' },
                    { field:'SpareName', title:'备件名称', width:200, fixed:'left', sort:true, filter:true },
                    { field:'Specs', title:'规格型号', width:160, sort:true, filter:true },
                    { field:'Danwei', title:'单位', width:80, sort:true, filter:true },
                    { field:'WarehouseId', title:'仓库Id', width:100, sort:true, filter:true },
                    { field:'Qty', title:'当前库存', width:120, align:'right', sort:true, totalRow:true, templet: function(d){
                        var qty = parseFloat(d.Qty)||0;
                        var safe = parseFloat(d.SafeStock)||0;
                        var color = (safe > 0 && qty < safe) ? 'color:#dc2626;font-weight:600;' : '';
                        return '<span style="' + color + '">' + SoulGrid.fmtThousand(qty) + '</span>';
                    }},
                    { field:'SafeStock', title:'安全库存', width:120, align:'right', sort:true, templet:function(d){ return SoulGrid.fmtThousand(d.SafeStock); } }
                ]]
            });
        });
    }
    if (window.RefPicker) RefPicker.autoMount($('.layui-card-body'));
    $('#btnSearch').on('click', load);
    $('#btnReload').on('click', load);
    $('#btnExport').on('click', function(){ SoulGrid.export('GridMain'); });
    $('#kw').on('keyup', function(e){ if (e.keyCode===13) load(); });
    load();
})();
</script>
}
