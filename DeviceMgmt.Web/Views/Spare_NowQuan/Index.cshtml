@{
    ViewData["Title"] = "澶囦欢鐜板瓨閲?Spare_NowQuan";
}
<div class="layui-fluid" style="padding:0;margin-top:10px">
    <div class="layui-row layui-col-space15">
        <div class="layui-col-md12">
            <div class="layui-card">
                <div class="layui-card-header">
                    <div class="pull-left">澶囦欢鐜板瓨閲?Spare_NowQuan</div>
                    <div class="demoTable pull-right no-print">
                        <div class="layui-inline" id="searchPanel"></div>
                        <div class="layui-btn-group">
                            <button class="layui-btn layui-btn-sm layui-btn-warm" id="btn_Export">瀵煎嚭</button>
                        </div>
                    </div>
                </div>
                <div class="layui-card-body" style="padding:0">
                    <div class="layui-inline" style="width:100%">
                        <table class="layui-hide" lay-filter="GridMain" id="GridMain"></table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Script{
    <script type='text/html' class="no-print" id='barDemo'>
        <a class='layui-btn layui-btn-xs layui-btn-normal' lay-event='viewModel'>鏌ョ湅</a>
    </script>
    <script>
        var URLThisGetList = '@Url.Action("GetMainList")';
        var URLThisExportList = '@Url.Action("ExportExcel")';
        var Cols = [
            { field: 'Id', title: 'Id', width: 80, sort: true },
            { field: 'SpareId', title: 'SpareId', search: 'input', width: 110 },
            { field: 'WarehouseId', title: 'WarehouseId', search: 'input', width: 110 },
            { field: 'AreaId', title: 'AreaId', search: 'input', width: 110 },
            { field: 'Qty', title: 'Qty', search: 'input', width: 110 },
            { field: 'Danjiaid', title: 'Danjiaid', search: 'input', width: 130 },
            { fixed: 'right', title: '鎿嶄綔', width: 90, align: 'center', toolbar: '#barDemo' }
        ];
        function viewModel(obj) {
            var Id = obj.data.Id || obj.data.id;
            layui.layer.open({
                title: '澶囦欢鐜板瓨閲?Spare_NowQuan - 鏌ョ湅',
                content: '@Url.Action("ViewList")?id=' + Id,
                type: 2,
                area: ['90%', '90%'],
                btn: ['鍏抽棴']
            });
        }
    </script>
    <script src="~/js/Page/NomalListPage.js"></script>
}