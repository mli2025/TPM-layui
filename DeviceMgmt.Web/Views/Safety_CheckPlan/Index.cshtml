@{
    ViewData["Title"] = "安全附件检定计划";
}
<div class="layui-fluid" style="padding:12px;">
    <div class="layui-card">
        <div class="layui-card-header"><strong>检定计划</strong></div>
        <div class="layui-card-body">
            <div class="layui-form layui-row" style="margin-bottom:8px;">
                <div class="layui-col-md12" style="text-align:right;">
                    <button class="layui-btn layui-btn-sm" id="btnAdd"><i class="layui-icon layui-icon-add-1"></i> 新增计划</button>
                    <button class="layui-btn layui-btn-sm layui-btn-primary" id="btnReload"><i class="layui-icon layui-icon-refresh-3"></i> 刷新</button>
                </div>
            </div>
            <table id="GridMain" lay-filter="GridMain"></table>
        </div>
    </div>
</div>
<script type="text/html" id="barRow">
    <a class="layui-btn layui-btn-xs layui-btn-normal" lay-event="edit">编辑</a>
    <a class="layui-btn layui-btn-xs layui-btn-danger" lay-event="del">删除</a>
</script>
<script type="text/html" id="tplForm">
    <div style="padding:14px;">
        <form class="layui-form" lay-filter="theForm">
            <input type="hidden" name="Id" />
            <div class="layui-form-item">
                <div class="layui-inline"><label class="layui-form-label"><span style="color:#e53935;">*</span>安全附件</label><div class="layui-input-inline"><select name="AccId" id="fld_acc" lay-search lay-verify="required"></select></div></div>
                <div class="layui-inline"><label class="layui-form-label">计划送检日</label><div class="layui-input-inline"><input type="text" name="PlanDate" id="fld_date" class="layui-input"></div></div>
            </div>
            <div class="layui-form-item">
                <div class="layui-inline"><label class="layui-form-label">送检责任人</label><div class="layui-input-inline"><input type="text" name="Owner" class="layui-input"></div></div>
                <div class="layui-inline"><label class="layui-form-label">状态</label><div class="layui-input-inline" style="padding-top:8px;">
                    <input type="radio" name="Status" value="0" title="待送检" checked />
                    <input type="radio" name="Status" value="1" title="已完成" />
                </div></div>
            </div>
            <div style="text-align:center;margin-top:10px;">
                <button class="layui-btn" lay-submit lay-filter="submitForm">保存</button>
                <button class="layui-btn layui-btn-primary" type="button" id="btnCancel">关闭</button>
            </div>
        </form>
    </div>
</script>
@section Script{
<script>
var URL_LIST='@Url.Action("GetMainList")',URL_SAVE='@Url.Action("Save")',URL_DEL='@Url.Action("Delete")',URL_ACCS='@Url.Action("GetAccessories")';
layui.use(['table','form','layer','laydate'],function(){
    var table=layui.table,form=layui.form,layer=layui.layer,laydate=layui.laydate;
    var accs=[],accMap={};
    function ok(r){return r&&(r.code===0||r.code===200);}
    function dt(v){return v?String(v).replace('T',' ').substring(0,10):'';}
    var ST={0:'待送检',1:'已完成'};
    function loadAccs(cb){$.get(URL_ACCS,function(res){if(ok(res)){accs=res.data||[];accMap={};accs.forEach(function(e){accMap[String(e.Id)]=e.AccCode;});}if(cb)cb();});}
    function render(){table.render({elem:'#GridMain',id:'GridMain',url:URL_LIST,method:'post',page:true,height:'full-160',cols:[[
        {type:'numbers',title:'#'},
        {field:'AccId',title:'安全附件',width:160,templet:function(d){return accMap[String(d.AccId)]||d.AccId;}},
        {field:'PlanDate',title:'计划送检日',width:130,templet:function(d){return dt(d.PlanDate);}},
        {field:'Owner',title:'送检责任人',width:130},
        {field:'Status',title:'状态',width:100,templet:function(d){return '<span class="layui-badge '+(d.Status===1?'layui-bg-green':'layui-bg-gray')+'">'+(ST[d.Status]||d.Status)+'</span>';}},
        {title:'操作',width:150,toolbar:'#barRow',fixed:'right'}
    ]]});}
    $('#btnReload').on('click',function(){table.reload('GridMain');});
    $('#btnAdd').on('click',function(){openForm({});});
    table.on('tool(GridMain)',function(obj){
        if(obj.event==='edit')openForm(obj.data);
        else if(obj.event==='del'){layer.confirm('确认删除该计划?',function(idx){$.post(URL_DEL,{id:obj.data.Id},function(res){layer.close(idx);if(ok(res)){obj.del();layer.msg('已删除',{icon:1});}else layer.msg(res.msg||'失败',{icon:2});});});}
    });
    form.on('submit(submitForm)',function(data){var f=data.field;
        var payload={Id:(f.Id&&String(f.Id).trim()!=='')?f.Id:0,AccId:f.AccId||0,PlanDate:f.PlanDate||null,Owner:f.Owner||null,Status:parseInt(f.Status||0,10)};
        $.ajax({url:URL_SAVE,method:'POST',contentType:'application/json',data:JSON.stringify(payload)}).done(function(res){if(ok(res)){layer.msg('保存成功',{icon:1});layer.closeAll();table.reload('GridMain');}else layer.msg(res.msg||'失败',{icon:2});});
        return false;});
    function openForm(row){row=row||{};layer.open({type:1,area:['640px','auto'],title:row.Id?'编辑计划':'新增计划',content:$('#tplForm').html(),success:function(layero,idx){
        var opt='<option value="">-- 请选择 --</option>';accs.forEach(function(e){opt+='<option value="'+e.Id+'">'+e.AccCode+(e.Model?(' / '+e.Model):'')+'</option>';});
        $(layero).find('#fld_acc').html(opt);
        laydate.render({elem:$(layero).find('#fld_date')[0],type:'date'});
        try{form.val('theForm',{Id:row.Id||0,AccId:row.AccId!=null?String(row.AccId):'',PlanDate:row.PlanDate?dt(row.PlanDate):'',Owner:row.Owner||'',Status:row.Status!=null?String(row.Status):'0'});form.render();}catch(e){}
        $(layero).find('#btnCancel').off('click').on('click',function(){layer.close(idx);});
    }});}
    loadAccs(function(){render();});
});
</script>
}
