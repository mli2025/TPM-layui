@{
    ViewData["Title"] = "登录";
    Layout = "_LayoutLogin";
}

<div class="min-h-screen flex">
    <!-- 左：品牌区 -->
    <div class="hidden md:flex md:flex-1 relative overflow-hidden"
         style="background: linear-gradient(135deg, #0f2620 0%, #1a3f31 40%, #1f4d3b 70%, #2c6f4e 100%);">
        <!-- 装饰光晕 -->
        <div class="absolute -top-32 -left-32 w-[480px] h-[480px] rounded-full pointer-events-none"
             style="background: radial-gradient(closest-side, rgba(255,255,255,.10), transparent);"></div>
        <div class="absolute bottom-0 right-0 w-[420px] h-[420px] rounded-full pointer-events-none"
             style="background: radial-gradient(closest-side, rgba(97,169,131,.18), transparent);"></div>

        <!-- 等高线纹理（SVG，零外部依赖） -->
        <svg class="absolute inset-0 w-full h-full opacity-[0.08] pointer-events-none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" viewBox="0 0 800 600">
            <defs>
                <pattern id="dotgrid" x="0" y="0" width="32" height="32" patternUnits="userSpaceOnUse">
                    <circle cx="1" cy="1" r="1" fill="#ffffff" />
                </pattern>
            </defs>
            <rect width="800" height="600" fill="url(#dotgrid)" />
            <!-- 抽象拓扑环线 -->
            <g fill="none" stroke="#ffffff" stroke-width="1">
                <path d="M -80 460 C 120 380, 280 520, 460 420 S 760 360, 920 440" />
                <path d="M -80 500 C 140 420, 300 560, 480 460 S 780 400, 940 480" opacity=".7" />
                <path d="M -80 420 C 100 340, 260 480, 440 380 S 740 320, 900 400" opacity=".5" />
                <path d="M -80 540 C 160 460, 320 600, 500 500 S 800 440, 960 520" opacity=".4" />
            </g>
            <!-- 抽象齿轮（左下角，呼应 TPM 设备语义） -->
            <g transform="translate(120 470)" opacity=".18" stroke="#ffffff" stroke-width="1.2" fill="none">
                <circle r="48" />
                <circle r="22" />
                <g>
                    <line x1="0" y1="-58" x2="0" y2="-48" />
                    <line x1="0" y1="48" x2="0" y2="58" />
                    <line x1="-58" y1="0" x2="-48" y2="0" />
                    <line x1="48" y1="0" x2="58" y2="0" />
                    <line x1="-41" y1="-41" x2="-34" y2="-34" />
                    <line x1="34" y1="34" x2="41" y2="41" />
                    <line x1="-41" y1="41" x2="-34" y2="34" />
                    <line x1="34" y1="-34" x2="41" y2="-41" />
                </g>
            </g>
        </svg>

        <div class="relative flex flex-col justify-between w-full p-12 text-white">
            <div class="flex items-center gap-3">
                <img src="~/img/logo.png" alt="arbore" class="w-12 h-12 rounded-lg shadow-lg" />
                <div>
                    <div class="text-lg font-semibold tracking-wide">arbore TPM</div>
                    <div class="text-xs text-white/70">Total Productive Maintenance</div>
                </div>
            </div>

            <div class="space-y-4">
                <h1 class="text-4xl font-semibold leading-snug">设备全生命周期管理</h1>
                <p class="text-base text-white/80 leading-relaxed max-w-md">
                    台账 · 保养 · 维修 · 点检 · 状态履历 · OEE · 备品备件 · 模具
                    <br />一站式工厂设备资产平台。
                </p>
            </div>

            <div class="text-xs text-white/50">
                © @DateTime.Now.Year arbore · v1.0
            </div>
        </div>
    </div>

    <!-- 右：表单区 -->
    <div class="flex-1 flex items-center justify-center px-6 py-12 relative overflow-hidden"
         style="background:
                radial-gradient(circle at 0% 0%, #f3f8f5 0%, transparent 45%),
                radial-gradient(circle at 100% 100%, #eef4f0 0%, transparent 45%),
                linear-gradient(135deg, #ffffff 0%, #f8faf9 100%);">
        <!-- 细点阵纹理 -->
        <div class="absolute inset-0 pointer-events-none opacity-60"
             style="background-image: radial-gradient(circle, rgba(31,77,59,0.10) 1px, transparent 1px);
                    background-size: 22px 22px;
                    mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
                    -webkit-mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);"></div>
        <!-- 装饰光斑 -->
        <div class="absolute -top-40 -right-40 w-[460px] h-[460px] rounded-full pointer-events-none"
             style="background: radial-gradient(closest-side, rgba(31,77,59,0.06), transparent);"></div>
        <div class="absolute -bottom-40 -left-40 w-[460px] h-[460px] rounded-full pointer-events-none"
             style="background: radial-gradient(closest-side, rgba(63,139,99,0.06), transparent);"></div>

        <div x-data="loginForm()" x-cloak class="w-full max-w-sm relative z-10 bg-white/70 backdrop-blur-sm rounded-2xl shadow-[0_8px_40px_rgba(15,38,32,0.08)] border border-white/60 p-8">
            <!-- 移动端 logo -->
            <div class="md:hidden flex items-center justify-center mb-8">
                <img src="~/img/logo.png" alt="arbore" class="w-12 h-12 rounded-lg" />
                <span class="ml-3 text-lg font-semibold text-slate-800">arbore TPM</span>
            </div>

            <h2 class="text-2xl font-semibold text-slate-900 mb-2">欢迎回来</h2>
            <p class="text-sm text-slate-500 mb-8">请输入账号密码登录系统</p>

            <form x-on:submit.prevent="submit" autocomplete="off" novalidate>
                <input type="hidden" name="returnUrl" :value="returnUrl" />

                <div class="mb-4">
                    <label class="block text-xs font-medium text-slate-600 mb-1.5">账号</label>
                    <div class="input-group">
                        <i data-lucide="user" class="input-icon"></i>
                        <input type="text" x-model.trim="account"
                               class="input"
                               :class="errors.account ? 'input-error' : ''"
                               placeholder="请输入账号"
                               autocomplete="username"
                               x-on:input="errors.account = ''"
                               x-on:keydown.enter.prevent="submit" />
                    </div>
                    <p x-show="errors.account" x-text="errors.account"
                       class="text-xs text-red-500 mt-1"></p>
                </div>

                <div class="mb-4">
                    <label class="block text-xs font-medium text-slate-600 mb-1.5">密码</label>
                    <div class="input-group">
                        <i data-lucide="lock" class="input-icon"></i>
                        <input :type="showPwd ? 'text' : 'password'" x-model="password"
                               class="input pr-10"
                               :class="errors.password ? 'input-error' : ''"
                               placeholder="请输入密码"
                               autocomplete="current-password"
                               x-on:input="errors.password = ''"
                               x-on:keydown.enter.prevent="submit" />
                        <button type="button" x-on:click="showPwd = !showPwd"
                                class="absolute right-2 top-1/2 -translate-y-1/2 p-1 text-slate-400 hover:text-slate-600"
                                tabindex="-1">
                            <i :data-lucide="showPwd ? 'eye-off' : 'eye'" class="w-4 h-4"></i>
                        </button>
                    </div>
                    <p x-show="errors.password" x-text="errors.password"
                       class="text-xs text-red-500 mt-1"></p>
                </div>

                <label class="flex items-center mb-6 text-sm text-slate-600 cursor-pointer select-none">
                    <input type="checkbox" x-model="remember"
                           class="w-4 h-4 mr-2 accent-brand-800" />
                    记住我
                </label>

                <button type="button"
                        class="btn btn-primary w-full justify-center"
                        :disabled="loading"
                        x-on:click.prevent="submit">
                    <span x-show="!loading">登 录</span>
                    <span x-show="loading" class="inline-flex items-center gap-2">
                        <span class="spinner"></span> 登录中…
                    </span>
                </button>

                <p x-show="serverError" x-text="serverError"
                   class="text-sm text-red-500 mt-4 text-center"></p>
            </form>
        </div>
    </div>
</div>

@section Script {
<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.1/dist/cdn.min.js" defer></script>
<script>
    function loginForm() {
        return {
            account: "",
            password: "",
            remember: false,
            showPwd: false,
            loading: false,
            errors: { account: "", password: "" },
            serverError: "",
            returnUrl: App.getQuery("returnUrl") || "/",
            /** 从真实 input 读值：密码管理器 / 自动化填表不会更新 Alpine x-model */
            syncFromDom: function () {
                var el = this.$el;
                if (!el) return;
                var accIn = el.querySelector('input[autocomplete="username"]');
                var pwdIn = el.querySelector('input[autocomplete="current-password"]');
                if (accIn && accIn.value) this.account = accIn.value.trim();
                if (pwdIn && pwdIn.value) this.password = pwdIn.value;
            },
            submit: function () {
                this.syncFromDom();
                this.errors = { account: "", password: "" };
                this.serverError = "";
                if (!this.account) this.errors.account = "请输入账号";
                if (!this.password) this.errors.password = "请输入密码";
                if (this.errors.account || this.errors.password) return;
                this.loading = true;
                var self = this;
                var navigated = false;
                $.ajax({
                    url: "@Url.Action("DoLogin", "Account")",
                    type: "POST",
                    data: { account: self.account, password: self.password, returnUrl: self.returnUrl },
                    dataType: "json",
                    timeout: 120000
                }).done(function (res) {
                    var ok = res && (res.code === 200 || res.code === "200");
                    if (ok) {
                        var r = (res.data && res.data.returnUrl) ? String(res.data.returnUrl).trim() : "";
                        var target = r || "/";
                        navigated = true;
                        window.location.replace(target);
                    } else {
                        self.serverError = (res && res.msg) ? res.msg : "账号或密码错误";
                    }
                }).fail(function (xhr, status) {
                    if (status === "timeout") {
                        self.serverError = "请求超时，请检查数据库或网络后重试";
                    } else {
                        self.serverError = "服务器错误 (" + xhr.status + ")，请稍后再试";
                    }
                }).always(function () {
                    if (!navigated) self.loading = false;
                });
            }
        };
    }
</script>
}
