@{
    ViewData["Title"] = "登录";
    Layout = "_LayoutLogin";
}
<div class="login-box">
    <div class="login-title">设备管理系统 · 登录</div>
    <form class="layui-form" id="loginForm" method="post" action="javascript:void(0);" autocomplete="off" onsubmit="return false;">
        <div class="layui-form-item">
            <input type="text" name="account" required lay-verify="required" placeholder="账号" autocomplete="off" class="layui-input" />
        </div>
        <div class="layui-form-item">
            <input type="password" name="password" required lay-verify="required" placeholder="密码" autocomplete="new-password" class="layui-input" />
        </div>
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
        <div class="layui-form-item">
            <button type="button" class="layui-btn login-btn" lay-submit lay-filter="loginSubmit" id="btnLogin">登 录</button>
        </div>
        <div class="login-hint">字段对齐 waes_nppms_core · 数据来自 waes_mes_hamaton</div>
    </form>
</div>
@section Script {
    <script>
        function doLogin() {
            var account = ($('input[name="account"]').val() || '').trim();
            var password = $('input[name="password"]').val() || '';
            var returnUrl = $('input[name="returnUrl"]').val() || '/';
            if (!account || !password) {
                if (window.layui && layui.layer) layui.layer.msg('请填写账号和密码');
                else alert('请填写账号和密码');
                return;
            }
            $.ajax({
                url: '@Url.Action("DoLogin", "Account")',
                type: 'POST',
                data: { account: account, password: password, returnUrl: returnUrl },
                dataType: 'json',
                success: function (res) {
                    if (res && res.code === 200) {
                        var target = (res.data && res.data.returnUrl) ? res.data.returnUrl : '/';
                        window.location.href = target;
                    } else {
                        var msg = (res && res.msg) ? res.msg : '账号或密码错误';
                        if (window.layui && layui.layer) layui.layer.msg(msg);
                        else alert(msg);
                    }
                },
                error: function (xhr) {
                    var msg = '服务器错误 (' + xhr.status + ')';
                    if (window.layui && layui.layer) layui.layer.msg(msg);
                    else alert(msg);
                }
            });
        }

        $(function () {
            $('#btnLogin').on('click', function (e) { e.preventDefault(); doLogin(); });
            $('input[name="password"]').on('keydown', function (e) { if (e.keyCode === 13) { e.preventDefault(); doLogin(); } });
            $('input[name="account"]').on('keydown', function (e) { if (e.keyCode === 13) { e.preventDefault(); $('input[name="password"]').focus(); } });

            if (window.layui) {
                layui.use(['form', 'layer'], function () {
                    var form = layui.form;
                    form.on('submit(loginSubmit)', function (data) { doLogin(); return false; });
                });
            }
        });
    </script>
}
