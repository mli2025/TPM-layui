@{
    ViewData["Title"] = "点检执行单";
}
<div class="layui-fluid" style="padding:12px;">
    <div class="layui-card">
        <div class="layui-card-header"><strong>点检执行单</strong>
            <button class="layui-btn layui-btn-sm" id="btnExec" style="float:right;margin-top:6px;">执行点检</button>
        </div>
        <div class="layui-card-body"><table id="GridMain" lay-filter="GridMain"></table></div>
    </div>
</div>

<script type="text/html" id="barRow">
    <a class="layui-btn layui-btn-xs" lay-event="view">查看</a>
    {{# if(d.Result == 1){ }}
    <a class="layui-btn layui-btn-xs layui-btn-danger" lay-event="disp">异常处置</a>
    {{# } }}
    <a class="layui-btn layui-btn-xs layui-btn-primary" lay-event="del">删除</a>
</script>

<script type="text/html" id="resultTpl">
    {{# if(d.Result == 1){ }}<span class="layui-badge layui-bg-red">异常</span>{{# } else { }}<span class="layui-badge layui-bg-green">正常</span>{{# } }}
</script>

<script type="text/html" id="tplExec">
    <div style="padding:16px;">
        <form class="layui-form" lay-filter="execForm">
            <div class="layui-form-item">
                <div class="layui-inline"><label class="layui-form-label">点检计划</label><div class="layui-input-inline" style="width:240px;"><select name="PlanId" id="selPlan" lay-filter="selPlan"></select></div></div>
                <div class="layui-inline"><label class="layui-form-label">执行人</label><div class="layui-input-inline"><input type="text" name="Executor" class="layui-input"></div></div>
            </div>
            <fieldset class="layui-elem-field layui-field-title"><legend>点检项</legend></fieldset>
            <table class="layui-table" style="margin:0;"><thead><tr><th>点检项</th><th style="width:150px;">实测值</th><th style="width:160px;">结果</th><th>备注</th></tr></thead><tbody id="ItemBody"><tr><td colspan="4" style="color:#94a3b8;text-align:center;">请选择点检计划</td></tr></tbody></table>
            <div class="layui-form-item layui-form-text" style="margin-top:10px;">
                <label class="layui-form-label">整体备注</label><div class="layui-input-block"><textarea name="Remark" class="layui-textarea"></textarea></div>
            </div>
            <div style="text-align:center;">
                <button class="layui-btn" lay-submit lay-filter="execSubmit">提交</button>
                <button class="layui-btn layui-btn-primary" type="button" id="execCancel">关闭</button>
            </div>
        </form>
    </div>
</script>

<script type="text/html" id="tplDisp">
    <div style="padding:16px;">
        <form class="layui-form" lay-filter="dispForm">
            <input type="hidden" name="RecordId" />
            <div class="layui-form-item">
                <label class="layui-form-label">处置方式</label>
                <div class="layui-input-block">
                    <select name="DisposalType">
                        <option value="立即维修">立即维修</option>
                        <option value="计划检修">计划检修</option>
                        <option value="停产窗口">停产窗口处理</option>
                        <option value="观察监控">观察监控</option>
                        <option value="无需处理">无需处理</option>
                    </select>
                </div>
            </div>
            <div class="layui-form-item layui-form-text"><label class="layui-form-label">说明</label><div class="layui-input-block"><textarea name="Remark" class="layui-textarea"></textarea></div></div>
            <div style="text-align:center;"><button class="layui-btn" lay-submit lay-filter="dispSave">确认分流</button><button class="layui-btn layui-btn-primary" type="button" id="dispCancel">关闭</button></div>
        </form>
    </div>
</script>

@section Script{
    <script>
        var URL_LIST = '@Url.Action("GetMainList")', URL_PLANS = '@Url.Action("Plans")', URL_PREP = '@Url.Action("PrepareByPlan")', URL_SUBMIT = '@Url.Action("Submit")', URL_DETAIL = '@Url.Action("GetDetail")', URL_DISP = '@Url.Action("Dispatch")', URL_DEL = '@Url.Action("Delete")';
        layui.use(['table', 'form', 'layer'], function () {
            var table = layui.table, form = layui.form, layer = layui.layer, $ = layui.$;
            function ok(r) { return r && (r.code === 0 || r.code === 200); }
            function dcell(v) { return v ? String(v).replace('T', ' ').substring(0, 19) : ''; }
            function esc(s){ return (s==null?'':String(s)).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }

            function renderList() {
                table.render({
                    elem: '#GridMain', id: 'GridMain', url: URL_LIST, method: 'post', where: { page: 1, limit: 20, searchParam: [] }, page: true, height: 'full-150',
                    cols: [[
                        { type: 'numbers', title: '#' },
                        { field: 'RecordNo', title: '记录号', width: 180 },
                        { field: 'PlanId', title: '计划Id', width: 100 },
                        { field: 'Executor', title: '执行人', width: 120 },
                        { field: 'ExecTime', title: '执行时间', width: 165, templet: function (d) { return dcell(d.ExecTime); } },
                        { field: 'Result', title: '结果', width: 90, templet: '#resultTpl' },
                        { field: 'Remark', title: '备注', minWidth: 160 },
                        { title: '操作', width: 200, toolbar: '#barRow', fixed: 'right' }
                    ]]
                });
            }

            function itemRow(name) {
                return '<tr data-item="' + esc(name) + '"><td>' + esc(name) + '</td>' +
                    '<td><input class="layui-input i-val"></td>' +
                    '<td><input type="radio" name="r_' + Math.random().toString(36).slice(2) + '" class="i-normal" checked>正常 &nbsp;<input type="radio" class="i-abn">异常</td>' +
                    '<td><input class="layui-input i-rk"></td></tr>';
            }

            function openExec() {
                layer.open({
                    type: 1, area: ['860px', '70%'], title: '执行点检', content: $('#tplExec').html(),
                    success: function (layero, idx) {
                        $.get(URL_PLANS, function (res) {
                            var opt = '<option value="">-- 选择计划 --</option>';
                            (res.data || []).forEach(function (p) { opt += '<option value="' + p.Id + '">' + (p.PlanNo || ('#' + p.Id)) + ' / ' + (p.Executor || '') + '</option>'; });
                            $('#selPlan').html(opt); form.render('select');
                        });
                        form.on('select(selPlan)', function (d) {
                            if (!d.value) { $('#ItemBody').html('<tr><td colspan="4" style="color:#94a3b8;text-align:center;">请选择点检计划</td></tr>'); return; }
                            $.get(URL_PREP, { planId: d.value }, function (res) {
                                var items = (res.data && res.data.items) || [];
                                var html = ''; items.forEach(function (it) { html += itemRow(it.ItemName); });
                                $('#ItemBody').html(html || '<tr><td colspan="4" style="color:#94a3b8;text-align:center;">该标准无点检项</td></tr>');
                                // 异常单选互斥
                                $('#ItemBody tr').each(function () {
                                    var $tr = $(this);
                                    $tr.find('.i-normal').on('click', function () { $tr.find('.i-abn').prop('checked', false); });
                                    $tr.find('.i-abn').on('click', function () { $tr.find('.i-normal').prop('checked', false); });
                                });
                            });
                        });
                        $('#execCancel').on('click', function () { layer.close(idx); });
                        form.on('submit(execSubmit)', function (data) {
                            var f = data.field;
                            if (!f.PlanId) { layer.msg('请选择计划'); return false; }
                            var items = [];
                            $('#ItemBody tr[data-item]').each(function () {
                                var $tr = $(this);
                                items.push({ ItemName: $tr.attr('data-item'), ResultValue: $tr.find('.i-val').val(), IsNormal: !$tr.find('.i-abn').is(':checked'), Remark: $tr.find('.i-rk').val() });
                            });
                            var payload = { Main: { Id: 0, PlanId: parseInt(f.PlanId, 10), Executor: f.Executor || null, Remark: f.Remark || null }, Items: items };
                            $.ajax({ url: URL_SUBMIT, method: 'POST', contentType: 'application/json', data: JSON.stringify(payload) }).done(function (res) { if (ok(res)) { layer.msg('已提交', { icon: 1 }); layer.close(idx); table.reload('GridMain'); } else layer.msg((res && res.msg) || '失败', { icon: 2 }); });
                            return false;
                        });
                    }
                });
            }

            function openDisp(rec) {
                layer.open({
                    type: 1, area: ['560px', 'auto'], title: '异常处置分流 - ' + (rec.RecordNo || ''), content: $('#tplDisp').html(),
                    success: function (layero, idx) {
                        form.val('dispForm', { RecordId: rec.Id }); form.render();
                        $('#dispCancel').on('click', function () { layer.close(idx); });
                        form.on('submit(dispSave)', function (data) {
                            var f = data.field;
                            $.ajax({ url: URL_DISP, method: 'POST', contentType: 'application/json', data: JSON.stringify({ RecordId: parseInt(f.RecordId, 10), DisposalType: f.DisposalType, Remark: f.Remark || null }) }).done(function (res) { if (ok(res)) { layer.msg('已分流', { icon: 1 }); layer.close(idx); } else layer.msg((res && res.msg) || '失败', { icon: 2 }); });
                            return false;
                        });
                    }
                });
            }

            function viewDetail(id) {
                $.get(URL_DETAIL, { id: id }, function (res) {
                    var d = res.data || {}, m = d.Main || {}, subs = d.Subs || [], disp = d.Disposals || [];
                    var html = '<div style="padding:12px;"><p><b>记录号：</b>' + esc(m.RecordNo) + ' &nbsp;<b>执行人：</b>' + esc(m.Executor) + ' &nbsp;<b>时间：</b>' + dcell(m.ExecTime) + '</p>';
                    html += '<table class="layui-table" lay-size="sm"><thead><tr><th>点检项</th><th>实测值</th><th>结果</th><th>备注</th></tr></thead><tbody>';
                    subs.forEach(function (s) { html += '<tr><td>' + esc(s.ItemName) + '</td><td>' + esc(s.ResultValue) + '</td><td>' + (s.IsNormal ? '正常' : '<span style="color:#dc2626;">异常</span>') + '</td><td>' + esc(s.Remark) + '</td></tr>'; });
                    html += '</tbody></table>';
                    if (disp.length) { html += '<p style="margin-top:8px;"><b>处置记录：</b></p><ul>'; disp.forEach(function (x) { html += '<li>' + esc(x.DisposalType) + ' - ' + esc(x.Remark) + '</li>'; }); html += '</ul>'; }
                    html += '</div>';
                    layer.open({ type: 1, title: '点检详情', area: ['760px', '600px'], content: html });
                });
            }

            $('#btnExec').on('click', openExec);
            table.on('tool(GridMain)', function (obj) {
                if (obj.event === 'view') viewDetail(obj.data.Id);
                else if (obj.event === 'disp') openDisp(obj.data);
                else if (obj.event === 'del') layer.confirm('确认删除?', function (idx) { $.post(URL_DEL, { id: obj.data.Id }, function () { layer.close(idx); obj.del(); }); });
            });
            renderList();
        });
    </script>
}
