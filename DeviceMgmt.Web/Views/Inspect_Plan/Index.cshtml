@{
    ViewData["Title"] = "点检计划";
}
<div class="layui-fluid" style="padding:12px;">
    <div class="layui-card">
        <div class="layui-card-header"><strong>点检计划</strong>
            <button class="layui-btn layui-btn-sm" id="btnAdd" style="float:right;margin-top:6px;">新增计划</button>
            <button class="layui-btn layui-btn-sm layui-btn-primary" id="btnReload" style="float:right;margin-top:6px;margin-right:8px;"><i class="layui-icon layui-icon-refresh-3"></i> 刷新</button>
        </div>
        <div class="layui-card-body">
            <div class="layui-tab layui-tab-brief" lay-filter="planTab">
                <ul class="layui-tab-title">
                    <li class="layui-this" lay-id="list">列表</li>
                    <li lay-id="cal">日历</li>
                </ul>
                <div class="layui-tab-content">
                    <div class="layui-tab-item layui-show"><table id="GridMain" lay-filter="GridMain"></table></div>
                    <div class="layui-tab-item">
                        <div style="margin-bottom:8px;">
                            <button class="layui-btn layui-btn-sm layui-btn-primary" id="calPrev">‹ 上月</button>
                            <span id="calTitle" style="font-weight:600;margin:0 12px;"></span>
                            <button class="layui-btn layui-btn-sm layui-btn-primary" id="calNext">下月 ›</button>
                        </div>
                        <div id="calGrid"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/html" id="barRow">
    <a class="layui-btn layui-btn-xs" lay-event="edit">编辑</a>
    <a class="layui-btn layui-btn-xs layui-btn-danger" lay-event="del">删除</a>
</script>

<script type="text/html" id="tplForm">
    <div style="padding:16px;">
        <form class="layui-form" lay-filter="planForm">
            <input type="hidden" name="Id" />
            <div class="layui-form-item">
                <label class="layui-form-label">点检模板</label>
                <div class="layui-input-block"><select name="TemplateId" lay-filter="selTpl" lay-verify="required"></select></div>
            </div>
            <div class="layui-form-item">
                <div class="layui-inline"><label class="layui-form-label">周期</label><div class="layui-input-inline" style="width:120px;">
                    <select name="CycleType">
                        <option value="日" selected>每天</option>
                        <option value="周">每周</option>
                        <option value="月">每月</option>
                        <option value="季">每季</option>
                        <option value="年">每年</option>
                    </select>
                </div></div>
                <div class="layui-inline"><label class="layui-form-label">起始日期</label><div class="layui-input-inline" style="width:140px;"><input type="text" name="PlanDate" id="fPlan" class="layui-input" lay-verify="required"></div></div>
                <div class="layui-inline"><label class="layui-form-label">截止日期</label><div class="layui-input-inline" style="width:140px;"><input type="text" name="EndDate" id="fEnd" class="layui-input" lay-verify="required"></div></div>
            </div>
            <div class="layui-form-item">
                <label class="layui-form-label">班次</label>
                <div class="layui-input-block" id="shiftBox">
                    <input type="checkbox" name="shift" value="白班" title="白班" lay-skin="primary">
                    <input type="checkbox" name="shift" value="中班" title="中班" lay-skin="primary">
                    <input type="checkbox" name="shift" value="夜班" title="夜班" lay-skin="primary">
                </div>
                <div class="layui-form-mid layui-word-aux" style="margin-left:110px;">不勾选=当天 1 张；勾选后同一天每班各 1 张（仅作备注，不限时段）</div>
            </div>
            <div class="layui-form-item">
                <div class="layui-inline"><label class="layui-form-label">状态</label><div class="layui-input-inline" style="width:120px;">
                    <select name="Status">
                        <option value="1">启用</option>
                        <option value="0">停用</option>
                    </select>
                </div></div>
            </div>
            <div class="layui-form-item">
                <label class="layui-form-label">执行角色</label>
                <div class="layui-input-block" id="roleBox" style="line-height:38px;">
                    <span style="color:#94a3b8;">加载中...</span>
                </div>
            </div>
            <div class="layui-form-item">
                <label class="layui-form-label">关联设备</label>
                <div class="layui-input-block">
                    <button type="button" class="layui-btn layui-btn-sm" id="btnPickDev"><i class="layui-icon layui-icon-add-1"></i> 选择设备</button>
                    <span id="devCount" style="margin-left:8px;color:#64748b;">未选择</span>
                    <div id="devChips" style="margin-top:8px;max-height:140px;overflow:auto;"></div>
                </div>
            </div>
            <div style="text-align:center;margin-top:10px;">
                <button class="layui-btn" lay-submit lay-filter="planSave">保存</button>
                <button class="layui-btn layui-btn-primary" type="button" id="planCancel">关闭</button>
            </div>
        </form>
    </div>
</script>

<script type="text/html" id="tplDevPick">
    <div style="padding:10px 14px;">
        <div class="layui-form" style="margin-bottom:8px;">
            <div class="layui-input-inline" style="width:240px;"><input type="text" id="devKw" class="layui-input" placeholder="设备编码/名称/类型 搜索" autocomplete="off"></div>
            <button type="button" class="layui-btn layui-btn-sm" id="devSearch"><i class="layui-icon layui-icon-search"></i> 搜索</button>
        </div>
        <table id="devGrid" lay-filter="devGrid"></table>
    </div>
</script>

@section Script{
    <script>
        var URL_LIST = '@Url.Action("GetMainList")', URL_MONTH = '@Url.Action("GetMonth")', URL_TPL = '@Url.Action("Templates")', URL_SAVE = '@Url.Action("Save")', URL_DEL = '@Url.Action("Delete")';
        var URL_ROLES = '@Url.Action("GetRoles")', URL_ROLEIDS = '@Url.Action("GetRoleIds")';
        var CYCLE_TXT = { '日': '每天', '周': '每周', '月': '每月', '季': '每季', '年': '每年' };
        layui.use(['table', 'form', 'layer', 'laydate', 'element', 'soulTable'], function () {
            var table = layui.table, form = layui.form, layer = layui.layer, laydate = layui.laydate, $ = layui.$;
            var stdCache = [];
            function ok(r) { return r && (r.code === 0 || r.code === 200); }
            function dcell(d, f) { return d[f] ? String(d[f]).replace('T', ' ').substring(0, 10) : ''; }
            function loadStandards(cb) { $.get(URL_TPL, function (res) { stdCache = (res && res.data) || []; if (cb) cb(); }); }
            function stdName(id) { for (var i = 0; i < stdCache.length; i++) if (String(stdCache[i].Id) === String(id)) return stdCache[i].HName || stdCache[i].HNumber || ('#' + id); return id; }

            function renderList() {
                SoulGrid.loadAll(URL_LIST, { searchParam: [] }, function (rows) {
                    (rows || []).forEach(function (r) { r.TemplateName = stdName(r.TemplateId); r.CycleText = CYCLE_TXT[r.CycleType] || (r.CycleType || '-'); r.StatusText = r.Status == 1 ? '启用' : '停用'; });
                    SoulGrid.render({
                        elem: '#GridMain', id: 'GridMain', data: rows, height: 'full-200', filename: '点检计划',
                        cols: [[
                            { type: 'numbers', title: '#' },
                            { field: 'PlanNo', title: '计划号', width: 180, sort: true, filter: true },
                            { field: 'TemplateName', title: '点检模板', width: 180, sort: true, filter: true },
                            { field: 'CycleText', title: '周期', width: 90, sort: true, filter: true },
                            { field: 'Shifts', title: '班次', width: 120, sort: true, filter: true, templet: function (d) { return d.Shifts || '-'; } },
                            { field: 'PlanDate', title: '起始', width: 110, sort: true, filter: { type: 'date[yyyy-MM-dd]' }, templet: function (d) { return dcell(d, 'PlanDate'); } },
                            { field: 'EndDate', title: '截止', width: 110, sort: true, templet: function (d) { return d.EndDate ? dcell(d, 'EndDate') : '长期'; } },
                            { field: 'StatusText', title: '状态', width: 80, sort: true, filter: true, templet: function (d) { return d.Status == 1 ? '<span class="layui-badge layui-bg-green">启用</span>' : '<span class="layui-badge">停用</span>'; } },
                            { title: '操作', width: 140, toolbar: '#barRow', fixed: 'right' }
                        ]]
                    });
                });
            }

            var calY, calM;
            function renderCal() {
                $('#calTitle').text(calY + ' 年 ' + (calM) + ' 月');
                $.get(URL_MONTH, { year: calY, month: calM }, function (res) {
                    var plans = (res && res.data) || [];
                    var byDay = {};
                    plans.forEach(function (p) { var day = new Date(String(p.PlanDate).replace('T', ' ')).getDate(); (byDay[day] = byDay[day] || []).push(p); });
                    var first = new Date(calY, calM - 1, 1).getDay();
                    var days = new Date(calY, calM, 0).getDate();
                    var html = '<table class="layui-table" style="table-layout:fixed;"><thead><tr>';
                    ['日', '一', '二', '三', '四', '五', '六'].forEach(function (w) { html += '<th style="text-align:center;">' + w + '</th>'; });
                    html += '</tr></thead><tbody><tr>';
                    for (var i = 0; i < first; i++) html += '<td></td>';
                    for (var d = 1; d <= days; d++) {
                        if ((first + d - 1) % 7 === 0 && d !== 1) html += '</tr><tr>';
                        var items = byDay[d] || [];
                        var cell = '<div style="font-weight:600;">' + d + '</div>';
                        items.forEach(function (p) { cell += '<div style="font-size:12px;background:' + (p.Status == 1 ? '#dcfce7' : '#f1f5f9') + ';margin:2px 0;padding:1px 4px;border-radius:3px;">' + (stdName(p.TemplateId) || '') + (CYCLE_TXT[p.CycleType] ? ' · ' + CYCLE_TXT[p.CycleType] : '') + '</div>'; });
                        html += '<td style="vertical-align:top;height:80px;">' + cell + '</td>';
                    }
                    html += '</tr></tbody></table>';
                    $('#calGrid').html(html);
                });
            }

            var URL_DEVLIST = '/Facility_ResourceDetail/GetMainList', URL_GETDEV = '@Url.Action("GetDevices")';
            function stdById(id) { for (var i = 0; i < stdCache.length; i++) if (String(stdCache[i].Id) === String(id)) return stdCache[i]; return null; }

            var roleCache = [];
            function loadRoles(cb) { $.get(URL_ROLES, function (res) { roleCache = (res && res.data) || []; if (cb) cb(); }); }

            function openForm(row) {
                row = row || {};
                var picked = {}; // FacilityId -> {FacilityId, FacilityName}
                var $ctx = null;
                function refreshChips() {
                    var ids = Object.keys(picked);
                    if (!$ctx) return;
                    $ctx.find('#devCount').text(ids.length ? ('已选 ' + ids.length + ' 台') : '未选择');
                    $ctx.find('#devChips').html(ids.map(function (k) {
                        var d = picked[k];
                        return '<span class="layui-badge layui-bg-blue" style="margin:2px 4px 2px 0;cursor:pointer;" data-id="' + k + '" title="点击移除">' + (d.FacilityName || ('#' + k)) + ' ×</span>';
                    }).join(''));
                }

                layer.open({
                    type: 1, area: ['680px', 'auto'], title: row.Id ? '编辑计划' : '新增计划', content: $('#tplForm').html(),
                    success: function (layero, idx) {
                        $ctx = $(layero);
                        $ctx.find('#devChips').off('click', '[data-id]').on('click', '[data-id]', function () {
                            delete picked[$(this).attr('data-id')];
                            refreshChips();
                        });
                        var opt = ''; stdCache.forEach(function (s) { opt += '<option value="' + s.Id + '">' + (s.HName || s.HNumber || ('#' + s.Id)) + '</option>'; });
                        $ctx.find('select[name=TemplateId]').html(opt);
                        laydate.render({ elem: $ctx.find('#fPlan')[0], type: 'date' });
                        laydate.render({ elem: $ctx.find('#fEnd')[0], type: 'date' });

                        // 渲染角色多选
                        var selRoles = {};
                        function renderRoles() {
                            if (!roleCache.length) { $ctx.find('#roleBox').html('<span style="color:#ef4444;">暂无可用角色，请先在「角色管理」配置</span>'); return; }
                            $ctx.find('#roleBox').html(roleCache.map(function (r) {
                                var ck = selRoles[r.Id] ? 'checked' : '';
                                return '<input type="checkbox" name="role" value="' + r.Id + '" title="' + (r.Name || ('#' + r.Id)) + '" lay-skin="primary" ' + ck + '>';
                            }).join(''));
                            form.render('checkbox');
                        }

                        form.val('planForm', { Id: row.Id || 0, TemplateId: row.TemplateId || '', CycleType: row.CycleType || '日', PlanDate: dcell(row, 'PlanDate'), EndDate: dcell(row, 'EndDate'), Status: (row.Id ? (row.Status != null ? String(row.Status) : '1') : '1') });
                        // 回显班次勾选
                        if (row.Shifts) { var shs = String(row.Shifts).split(/[,，;；]/); $ctx.find('#shiftBox input[name=shift]').each(function () { if (shs.indexOf($(this).val()) >= 0) $(this).prop('checked', true); }); }
                        renderRoles();
                        form.render();

                        if (row.Id) {
                            $.get(URL_GETDEV, { id: row.Id }, function (res) { (res.data || []).forEach(function (d) { picked[d.FacilityId] = { FacilityId: d.FacilityId, FacilityName: d.FacilityName }; }); refreshChips(); });
                            $.get(URL_ROLEIDS, { id: row.Id }, function (res) { (res.data || []).forEach(function (rid) { selRoles[rid] = true; }); renderRoles(); });
                        }

                        $ctx.find('#btnPickDev').on('click', function () {
                            openDevPicker(picked, '', refreshChips);
                        });
                        $ctx.find('#planCancel').on('click', function () { layer.close(idx); });
                        form.on('submit(planSave)', function (data) {
                            var f = data.field;
                            var devs = Object.keys(picked).map(function (k) { return { FacilityId: parseInt(k, 10), FacilityName: picked[k].FacilityName }; });
                            if (devs.length === 0) { layer.msg('请至少选择一台设备', { icon: 0 }); return false; }
                            var roleIds = $ctx.find('#roleBox input[name=role]:checked').map(function () { return parseInt($(this).val(), 10); }).get();
                            if (roleIds.length === 0) { layer.msg('请至少选择一个执行角色', { icon: 0 }); return false; }
                            var shifts = $ctx.find('#shiftBox input[name=shift]:checked').map(function () { return $(this).val(); }).get().join(',') || null;
                            var payload = { Main: { Id: parseInt(f.Id || 0, 10), TemplateId: parseInt(f.TemplateId || 0, 10), CycleType: f.CycleType || '日', Shifts: shifts, PlanDate: f.PlanDate || null, EndDate: f.EndDate || null, Status: parseInt(f.Status != null ? f.Status : 1, 10) }, Devices: devs, RoleIds: roleIds };
                            $.ajax({ url: URL_SAVE, method: 'POST', contentType: 'application/json', data: JSON.stringify(payload) }).done(function (res) { if (ok(res)) { layer.msg('已保存并生成执行单', { icon: 1 }); layer.close(idx); renderList(); if (calY) renderCal(); } else layer.msg((res && res.msg) || '失败', { icon: 2 }); });
                            return false;
                        });
                    }
                });
            }

            function openDevPicker(picked, devType, onDone) {
                layer.open({
                    type: 1, title: '选择设备' + (devType ? '（类型筛选：' + devType + '）' : ''), area: ['720px', '600px'], content: $('#tplDevPick').html(),
                    btn: ['确定', '取消'],
                    success: function () {
                        var all = [];
                        var sel = {}; // 跨分页累积：FacilityId -> row
                        Object.keys(picked).forEach(function (k) { sel[k] = picked[k]; });
                        function render(rows) {
                            SoulGrid.render({
                                elem: '#devGrid', id: 'devGrid', data: rows || [], page: true, limit: 10, height: 420, filename: '设备清单',
                                cols: [[
                                    { type: 'checkbox', width: 50 },
                                    { field: 'FacilityCode', title: '编码', width: 150, sort: true, filter: true },
                                    { field: 'FacilityName', title: '名称', minWidth: 180, sort: true, filter: true },
                                    { field: 'FacilityType', title: '类型', width: 140, sort: true, filter: true }
                                ]]
                            });
                        }
                        // checkbox 勾选累积到 sel（含跨页）
                        table.on('checkbox(devGrid)', function (obj) {
                            var data = obj.data;
                            if (obj.type === 'all') {
                                var st = table.checkStatus('devGrid');
                                (st.data || []).forEach(function (r) { if (obj.checked) sel[r.Id] = { FacilityId: r.Id, FacilityName: r.FacilityName }; else delete sel[r.Id]; });
                            } else {
                                if (obj.checked) sel[data.Id] = { FacilityId: data.Id, FacilityName: data.FacilityName };
                                else delete sel[data.Id];
                            }
                        });
                        function doFilter(kw) {
                            kw = (kw || '').toLowerCase();
                            return all.filter(function (r) {
                                if (devType && String(r.FacilityType || '') !== devType) return false;
                                if (!kw) return true;
                                return ['FacilityCode', 'FacilityName', 'FacilityType'].some(function (f) { return String(r[f] || '').toLowerCase().indexOf(kw) >= 0; });
                            });
                        }
                        $.post(URL_DEVLIST, { page: 1, limit: 9999 }, function (res) { all = (res && res.data) || []; render(doFilter('')); }).fail(function () { render([]); });
                        $('#devSearch').on('click', function () { render(doFilter($('#devKw').val())); });
                        $('#devKw').on('keydown', function (e) { if (e.keyCode === 13) { render(doFilter($(this).val())); return false; } });
                        // 暴露给 yes
                        openDevPicker._sel = sel;
                    },
                    yes: function (idx) {
                        var sel = openDevPicker._sel || {};
                        Object.keys(sel).forEach(function (k) { picked[k] = sel[k]; });
                        if (onDone) onDone();
                        layer.close(idx);
                    }
                });
            }

            $('#btnAdd').on('click', function () { openForm({}); });
            $('#btnReload').on('click', function () { renderList(); });
            $('#calPrev').on('click', function () { calM--; if (calM < 1) { calM = 12; calY--; } renderCal(); });
            $('#calNext').on('click', function () { calM++; if (calM > 12) { calM = 1; calY++; } renderCal(); });
            layui.element.on('tab(planTab)', function () { if (this.getAttribute('lay-id') === 'cal' && !calY) { var now = new Date(); calY = now.getFullYear(); calM = now.getMonth() + 1; renderCal(); } });

            table.on('tool(GridMain)', function (obj) {
                if (obj.event === 'edit') openForm(obj.data);
                else if (obj.event === 'del') layer.confirm('确认删除?', function (idx) { $.post(URL_DEL, { id: obj.data.Id }, function () { layer.close(idx); renderList(); }); });
            });

            loadRoles();
            loadStandards(renderList);
        });
    </script>
}
