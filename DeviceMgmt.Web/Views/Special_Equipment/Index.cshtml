@{
    ViewData["Title"] = "特种设备台账";
}
<div class="layui-fluid" style="padding:12px;">
    <div class="layui-card">
        <div class="layui-card-header"><strong>特种设备台账</strong></div>
        <div class="layui-card-body">
            <div class="layui-form layui-row layui-col-space10" style="margin-bottom:8px;">
                <div class="layui-col-md3"><input type="text" id="kwCode" class="layui-input" placeholder="设备代码"></div>
                <div class="layui-col-md3"><input type="text" id="kwCat" class="layui-input" placeholder="类别"></div>
                <div class="layui-col-md3">
                    <select id="fltStatus">
                        <option value="">-- 状态(全部) --</option>
                        <option value="1">启用</option>
                        <option value="0">停用</option>
                    </select>
                </div>
                <div class="layui-col-md3" style="text-align:right;">
                    <button class="layui-btn layui-btn-sm" id="btnAdd"><i class="layui-icon layui-icon-add-1"></i> 新增</button>
                    <button class="layui-btn layui-btn-sm layui-btn-primary" id="btnReload"><i class="layui-icon layui-icon-search"></i> 查询</button>
                    <button class="layui-btn layui-btn-sm layui-btn-warm" id="btnExport"><i class="layui-icon layui-icon-download-circle"></i> 导出</button>
                </div>
            </div>
            <table id="GridMain" lay-filter="GridMain"></table>
        </div>
    </div>
</div>

<script type="text/html" id="barRow">
    <a class="layui-btn layui-btn-xs layui-btn-normal" lay-event="edit">编辑</a>
    <a class="layui-btn layui-btn-xs layui-btn-danger" lay-event="del">删除</a>
</script>

<script type="text/html" id="tplForm">
    <div style="padding:14px;">
        <form class="layui-form" lay-filter="theForm">
            <input type="hidden" name="Id" />
            <div class="layui-form-item">
                <div class="layui-inline"><label class="layui-form-label"><span style="color:#e53935;">*</span>设备代码</label><div class="layui-input-inline"><input type="text" name="EquipCode" class="layui-input" lay-verify="required"></div></div>
                <div class="layui-inline"><label class="layui-form-label">类别</label><div class="layui-input-inline"><input type="text" name="Category" class="layui-input" placeholder="压力容器/电梯…"></div></div>
            </div>
            <div class="layui-form-item">
                <div class="layui-inline"><label class="layui-form-label">注册登记号</label><div class="layui-input-inline"><input type="text" name="RegisterNo" class="layui-input"></div></div>
                <div class="layui-inline"><label class="layui-form-label">使用证号</label><div class="layui-input-inline"><input type="text" name="UseCertNo" class="layui-input"></div></div>
            </div>
            <div class="layui-form-item">
                <div class="layui-inline"><label class="layui-form-label">设计年限</label><div class="layui-input-inline"><input type="number" step="0.1" name="DesignLife" class="layui-input"></div></div>
                <div class="layui-inline"><label class="layui-form-label">安全等级</label><div class="layui-input-inline"><input type="text" name="SafetyLevel" class="layui-input"></div></div>
            </div>
            <div class="layui-form-item">
                <div class="layui-inline"><label class="layui-form-label">下次检验日</label><div class="layui-input-inline"><input type="text" name="NextInspectDate" id="fld_next" class="layui-input"></div></div>
                <div class="layui-inline"><label class="layui-form-label">检验机构</label><div class="layui-input-inline"><input type="text" name="InspectOrg" class="layui-input"></div></div>
            </div>
            <div class="layui-form-item">
                <label class="layui-form-label">状态</label>
                <div class="layui-input-block">
                    <input type="radio" name="Status" value="1" title="启用" checked />
                    <input type="radio" name="Status" value="0" title="停用" />
                </div>
            </div>
            <div style="text-align:center;margin-top:10px;">
                <button class="layui-btn" lay-submit lay-filter="submitForm">保存</button>
                <button class="layui-btn layui-btn-primary" type="button" id="btnCancel">关闭</button>
            </div>
        </form>
    </div>
</script>

@section Script{
<script>
var URL_LIST='@Url.Action("GetMainList")', URL_SAVE='@Url.Action("Save")', URL_DEL='@Url.Action("Delete")';
layui.use(['table','form','layer','laydate'],function(){
    var table=layui.table,form=layui.form,layer=layui.layer,laydate=layui.laydate;
    function ok(r){return r&&(r.code===0||r.code===200);}
    function dt(v){return v?String(v).replace('T',' ').substring(0,10):'';}
    function overdue(v){ if(!v) return false; return new Date(v) < new Date(); }
    function getWhere(){var l=[];var c=$('#kwCode').val(),k=$('#kwCat').val(),s=$('#fltStatus').val();
        if(c)l.push({field:'EquipCode',conditional:'like',value:c});
        if(k)l.push({field:'Category',conditional:'like',value:k});
        if(s!==''&&s!=null)l.push({field:'Status',conditional:'eq',value:s});
        return {page:1,limit:20,searchParam:l};}
    function decorate(rows){(rows||[]).forEach(function(r){r.StatusName=r.Status===1?'启用':'停用';r.NextInspectDate=dt(r.NextInspectDate);});return rows;}
    function loadData(){
        SoulGrid.loadAll(URL_LIST,getWhere(),function(rows){
            SoulGrid.render({elem:'#GridMain',id:'GridMain',data:decorate(rows),height:'full-180',filename:'特种设备台账',cols:[[
                {type:'numbers',title:'#',width:50,fixed:'left'},
                {field:'EquipCode',title:'设备代码',width:140,fixed:'left',sort:true,filter:true},
                {field:'Category',title:'类别',width:120,sort:true,filter:true},
                {field:'RegisterNo',title:'注册登记号',width:150,sort:true,filter:true},
                {field:'UseCertNo',title:'使用证号',width:140,sort:true,filter:true},
                {field:'SafetyLevel',title:'安全等级',width:110,sort:true,filter:true},
                {field:'NextInspectDate',title:'下次检验日',width:120,align:'center',sort:true,filter:true,templet:function(d){var t=d.NextInspectDate;return overdue(t)?'<span style="color:#e53935;font-weight:600;">'+t+'</span>':t;}},
                {field:'InspectOrg',title:'检验机构',minWidth:160,sort:true,filter:true},
                {field:'StatusName',title:'状态',width:90,sort:true,filter:true,templet:function(d){return d.Status===1?'<span class="layui-badge layui-bg-green">启用</span>':'<span class="layui-badge layui-bg-gray">停用</span>';}},
                {title:'操作',width:150,toolbar:'#barRow',fixed:'right'}
            ]]});
        });
    }
    $('#btnReload').on('click',function(){loadData();});
    $('#btnExport').on('click',function(){SoulGrid.export('GridMain');});
    form.on('select(fltStatus)',function(){$('#btnReload').click();});
    $('#btnAdd').on('click',function(){openForm({});});
    table.on('tool(GridMain)',function(obj){
        if(obj.event==='edit')openForm(obj.data);
        else if(obj.event==='del'){layer.confirm('确认删除「'+obj.data.EquipCode+'」?',function(idx){$.post(URL_DEL,{id:obj.data.Id},function(res){layer.close(idx);if(ok(res)){obj.del();layer.msg('已删除',{icon:1});}else layer.msg(res.msg||'失败',{icon:2});});});}
    });
    form.on('submit(submitForm)',function(data){var f=data.field;
        var payload={Id:(f.Id&&String(f.Id).trim()!=='')?f.Id:0,EquipCode:(f.EquipCode||'').trim(),Category:f.Category||null,RegisterNo:f.RegisterNo||null,UseCertNo:f.UseCertNo||null,DesignLife:f.DesignLife?parseFloat(f.DesignLife):null,SafetyLevel:f.SafetyLevel||null,NextInspectDate:f.NextInspectDate||null,InspectOrg:f.InspectOrg||null,Status:parseInt(f.Status||1,10)};
        $.ajax({url:URL_SAVE,method:'POST',contentType:'application/json',data:JSON.stringify(payload)}).done(function(res){if(ok(res)){layer.msg('保存成功',{icon:1});layer.closeAll();loadData();}else layer.msg(res.msg||'失败',{icon:2});});
        return false;});
    function openForm(row){row=row||{};layer.open({type:1,area:['680px','auto'],title:row.Id?'编辑特种设备':'新增特种设备',content:$('#tplForm').html(),success:function(layero,idx){
        laydate.render({elem:$(layero).find('#fld_next')[0],type:'date'});
        try{form.val('theForm',{Id:row.Id||0,EquipCode:row.EquipCode||'',Category:row.Category||'',RegisterNo:row.RegisterNo||'',UseCertNo:row.UseCertNo||'',DesignLife:row.DesignLife!=null?row.DesignLife:'',SafetyLevel:row.SafetyLevel||'',NextInspectDate:row.NextInspectDate?dt(row.NextInspectDate):'',InspectOrg:row.InspectOrg||'',Status:row.Status!=null?String(row.Status):'1'});form.render();}catch(e){}
        $(layero).find('#btnCancel').off('click').on('click',function(){layer.close(idx);});
    }});}
    loadData();
});
</script>
}
