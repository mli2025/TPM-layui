    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>OutsourcingCreateDate</label><div class='layui-input-block'><input type='text' name='OutsourcingCreateDate' class='layui-input' lay-verify='datetime' /></div></div></div>
