@inject DeviceMgmt.Web.Services.SettingService AppSetting
@{
    var title = ViewBag.Title as string ?? "页面";
    var appSettingsJson = Newtonsoft.Json.JsonConvert.SerializeObject(AppSetting.ToClientPayload());
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
    <title>@title</title>
    <link rel="icon" href="~/favicon.ico" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50:  "#f1f7f4", 100: "#def0e5", 200: "#bee1cd",
                            300: "#91c9ac", 400: "#61a983", 500: "#3f8b63",
                            600: "#2c6f4e", 700: "#235840", 800: "#1f4d3b",
                            900: "#1a3f31", 950: "#0f2620"
                        }
                    },
                    fontFamily: {
                        sans: ["Inter", "ui-sans-serif", "system-ui", "-apple-system",
                               "Segoe UI", "PingFang SC", "Hiragino Sans GB",
                               "Microsoft YaHei", "sans-serif"]
                    }
                }
            }
        };
    </script>
    <link href="~/css/app.css" rel="stylesheet" />

    @* 旧 layui 资源 - 业务视图过渡期需要，P0.7 完成后可移除 *@
    <link href="~/js/layui/css/layui.css" rel="stylesheet" />
    <link href="~/js/soul-table/soulTable.css" rel="stylesheet" />
    <link href="~/js/layui/css/main.css" rel="stylesheet" />
    <link href="~/js/font-awesome/css/font-awesome.css" rel="stylesheet" />
    <link href="~/js/select2/css/select2.min.css" rel="stylesheet" />

    @RenderSection("Style", required: false)
</head>
<body class="font-sans antialiased" style="background: var(--bg);">
    <div class="px-4 py-3">
        @RenderBody()
    </div>

    @* 业务视图共用 JS *@
    <script src="~/js/layui/lang/zh-Hans.js"></script>
    <script src="~/js/jQuery/jquery-1.11.3.js"></script>
    <script src="~/js/layui/layui.js"></script>
    <script src="~/js/select2/js/select2.full.min.js"></script>
    <script src="~/js/jQuery/jquery.jsontotable.js"></script>
    <script src="~/js/jQuery/jquery.PrintArea.js"></script>
    <script src="~/js/inputmask/jquery.inputmask.bundle.min.js"></script>
    <script src="~/js/app.js"></script>
    <script src="~/js/components/attachment.js"></script>
    <script src="~/js/components/native-scan.js"></script>
    <script src="~/js/components/soul-grid.js"></script>
    <script src="~/js/components/ref-picker.js"></script>
    <script src="~/js/components/wf-widget.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/lucide@0.428.0/dist/umd/lucide.min.js"></script>

    <script>
        window.AppSettings = @Html.Raw(appSettingsJson);
        var token = App.getCookie("Token");
        $.ajaxSetup({ headers: { "Token": token || "" } });

        var URLGlobalGetSelect2Data = "@Url.Action("GetSelect2Data","Service")";
        var URLGlobalGetSelect2InitItem = "@Url.Action("GetSelect2InitItem", "Service")";
        var Glb_Add = "新增";
        var Glb_Print = "打印";
        var Glb_Edit = "编辑";
        var Glb_Save = "保存";
        var Glb_SaveFail = "保存失败";
        var Glb_SaveSuccess = "保存成功";
        var Glb_ServerErr = "服务器出错";
        var Glb_Del = "删除";
        var Glb_DelConfirm = "确定要删除这些记录吗？";
        var Glb_DelFail = "删除失败";
        var Glb_DelSuccess = "删除成功";

        layui.config({
            dir: "@Url.Content("~/js/layui/")",
            debug: false,
            base: "@Url.Content("~/js/layui/lay/extmodules/")"
        }).extend({
            extend_table: "extend_table",
            tableSelect: "tableSelect",
            step: "step",
            // soul-table 扩展（用 {/} 绝对路径，不受上面的 base 影响）
            excel: "{/}@(Url.Content("~/js/soul-table/excel"))",
            tableMerge: "{/}@(Url.Content("~/js/soul-table/tableMerge"))",
            tableChild: "{/}@(Url.Content("~/js/soul-table/tableChild"))",
            tableFilter: "{/}@(Url.Content("~/js/soul-table/tableFilter"))",
            soulTable: "{/}@(Url.Content("~/js/soul-table/soulTable"))"
        });

        var TableLimit = 20;
        var TableLimits = [10, 20, 50, 100];

        if (window.parent && window.parent !== window) {
            window.parent.postMessage({ type: "iframe-loaded", title: document.title }, "*");
        }
    </script>

    @RenderSection("Script", required: false)

    <script>
        var buttons = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewData["Buttons"]));
        $(function () {
            if (buttons) {
                for (var i = 0; i < buttons.length; i++) {
                    var moduleId = App.getQuery("moduleId");
                    if (buttons[i].ModuleId == moduleId) {
                        $("#" + buttons[i].DomId).removeClass("layui-hide");
                    }
                }
            }
            if (window.lucide) lucide.createIcons();
        });
    </script>
</body>
</html>
