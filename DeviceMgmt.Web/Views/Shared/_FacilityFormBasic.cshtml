@{
    var L = "layui-col-lg4 layui-col-md4 layui-col-sm6 layui-col-xs12";
}
<div class="layui-row layui-col-space10">
    <div class="@L">
        <div class="layui-form-item"><label class="layui-form-label">设备编码 *</label><div class="layui-input-block"><input type="text" name="FacilityCode" required lay-verify="required" class="layui-input" /></div></div>
    </div>
    <div class="@L">
        <div class="layui-form-item"><label class="layui-form-label">设备名称 *</label><div class="layui-input-block"><input type="text" name="FacilityName" required lay-verify="required" class="layui-input" /></div></div>
    </div>
    <div class="@L">
        <div class="layui-form-item"><label class="layui-form-label">设备类型 *</label><div class="layui-input-block"><input type="text" name="FacilityType" class="layui-input" /></div></div>
    </div>
    <div class="@L">
        <div class="layui-form-item"><label class="layui-form-label">资源Id</label><div class="layui-input-block"><input type="text" name="ResourceId" class="layui-input" /></div></div>
    </div>
    <div class="@L">
        <div class="layui-form-item"><label class="layui-form-label">制造商</label><div class="layui-input-block"><input type="text" name="Manufacturer" class="layui-input" /></div></div>
    </div>
    <div class="@L">
        <div class="layui-form-item"><label class="layui-form-label">供应商</label><div class="layui-input-block"><input type="text" name="Supplier" class="layui-input" /></div></div>
    </div>
    <div class="@L">
        <div class="layui-form-item"><label class="layui-form-label">出厂国家</label><div class="layui-input-block"><input type="text" name="ManufactureCountry" class="layui-input" /></div></div>
    </div>
    <div class="@L">
        <div class="layui-form-item"><label class="layui-form-label">型号</label><div class="layui-input-block"><input type="text" name="Model" class="layui-input" /></div></div>
    </div>
    <div class="@L">
        <div class="layui-form-item"><label class="layui-form-label">出厂编号</label><div class="layui-input-block"><input type="text" name="SerialNumber" class="layui-input" /></div></div>
    </div>
    <div class="@L">
        <div class="layui-form-item"><label class="layui-form-label">出厂日期</label><div class="layui-input-block"><input type="text" name="ManufacturerDate" lay-verify="datetime" class="layui-input" /></div></div>
    </div>
    <div class="@L">
        <div class="layui-form-item"><label class="layui-form-label">安装位置</label><div class="layui-input-block"><input type="text" name="Location" class="layui-input" /></div></div>
    </div>
    <div class="@L">
        <div class="layui-form-item"><label class="layui-form-label">所属部门Id</label><div class="layui-input-block"><input type="text" name="DeptId" class="layui-input" /></div></div>
    </div>
    <div class="@L">
        <div class="layui-form-item"><label class="layui-form-label">设备标识</label><div class="layui-input-block"><input type="text" name="FacilitySign" class="layui-input" /></div></div>
    </div>
    <div class="@L">
        <div class="layui-form-item"><label class="layui-form-label">关键设备</label><div class="layui-input-block"><input type="text" name="KeyFlag" placeholder="0/1" class="layui-input" /></div></div>
    </div>
    <div class="@L">
        <div class="layui-form-item"><label class="layui-form-label">类型(Type)</label><div class="layui-input-block"><input type="text" name="Type" class="layui-input" /></div></div>
    </div>
    <div class="@L">
        <div class="layui-form-item"><label class="layui-form-label">标准</label><div class="layui-input-block"><input type="text" name="Standard" class="layui-input" /></div></div>
    </div>
    <div class="@L">
        <div class="layui-form-item"><label class="layui-form-label">看护人</label><div class="layui-input-block"><input type="text" name="Keeper" class="layui-input" /></div></div>
    </div>
    <div class="@L">
        <div class="layui-form-item"><label class="layui-form-label">实体Id</label><div class="layui-input-block"><input type="text" name="EntityId" class="layui-input" value="1" /></div></div>
    </div>
</div>
