@{
    var title = ViewBag.Title as string ?? "登录";
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title · arbore TPM</title>
    <link rel="icon" href="~/favicon.ico" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50:  "#f1f7f4", 100: "#def0e5", 200: "#bee1cd",
                            300: "#91c9ac", 400: "#61a983", 500: "#3f8b63",
                            600: "#2c6f4e", 700: "#235840", 800: "#1f4d3b",
                            900: "#1a3f31", 950: "#0f2620"
                        }
                    },
                    fontFamily: {
                        sans: ["Inter", "ui-sans-serif", "system-ui", "-apple-system",
                               "Segoe UI", "PingFang SC", "Hiragino Sans GB",
                               "Microsoft YaHei", "sans-serif"]
                    }
                }
            }
        };
    </script>
    <link href="~/css/app.css" rel="stylesheet" />
</head>
<body class="font-sans antialiased">
    @RenderBody()
    <script src="https://cdn.jsdelivr.net/npm/jquery@1.11.3/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/lucide@0.428.0/dist/umd/lucide.min.js"></script>
    <script src="~/js/app.js"></script>
    @RenderSection("Script", required: false)
    <script>
        if (window.lucide) lucide.createIcons();
    </script>
</body>
</html>
