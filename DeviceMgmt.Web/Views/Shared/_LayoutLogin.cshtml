<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <title>@ViewBag.Title - DeviceMgmt</title>
    <link href="~/js/layui/css/layui.css" rel="stylesheet" />
    <link href="~/js/font-awesome/css/font-awesome.css" rel="stylesheet" />
    <style>
        body { background: linear-gradient(135deg,#1e3c72,#2a5298); min-height: 100vh; margin: 0; }
        .login-box { width:380px; margin: 12vh auto 0; padding: 36px 36px 28px; background:#fff; border-radius:10px; box-shadow: 0 12px 36px rgba(0,0,0,.25); }
        .login-title { text-align:center; font-size:20px; font-weight:600; color:#333; margin-bottom: 24px; }
        .login-btn { width:100%; }
        .login-hint { color:#999; font-size:12px; margin-top:14px; text-align:center; }
    </style>
</head>
<body>
    @RenderBody()
    <script src="~/js/layui/lang/zh-Hans.js"></script>
    <script src="~/js/jQuery/jquery-1.11.3.js"></script>
    <script src="~/js/layui/layui.js"></script>
    @RenderSection("Script", required: false)
</body>
</html>
