@{
    var L = "layui-col-lg4 layui-col-md4 layui-col-sm6 layui-col-xs12";
}
<div id="tplLoadingTip" style="margin:0 0 8px 8px;font-size:12px;color:#888;">&nbsp;</div>
<div class="layui-row layui-col-space10">
    <div class="@L">
        <div class="layui-form-item">
            <label class="layui-form-label">点检模版</label>
            <div class="layui-input-block">
                <select name="TheTemplateMainId" class="tpl-select"><option value="">-- 请选择 --</option></select>
            </div>
        </div>
    </div>
    <div class="@L">
        <div class="layui-form-item">
            <label class="layui-form-label">周保养模版</label>
            <div class="layui-input-block">
                <select name="WeekTempId" class="tpl-select"><option value="">-- 请选择 --</option></select>
            </div>
        </div>
    </div>
    <div class="@L">
        <div class="layui-form-item">
            <label class="layui-form-label">月保养模版</label>
            <div class="layui-input-block">
                <select name="MonthTempId" class="tpl-select"><option value="">-- 请选择 --</option></select>
            </div>
        </div>
    </div>
    <div class="@L">
        <div class="layui-form-item">
            <label class="layui-form-label">季保养模版</label>
            <div class="layui-input-block">
                <select name="SeasonTempId" class="tpl-select"><option value="">-- 请选择 --</option></select>
            </div>
        </div>
    </div>
    <div class="@L">
        <div class="layui-form-item">
            <label class="layui-form-label">年保养模版</label>
            <div class="layui-input-block">
                <select name="YearTempId" class="tpl-select"><option value="">-- 请选择 --</option></select>
            </div>
        </div>
    </div>
    <div class="@L">
        <div class="layui-form-item">
            <label class="layui-form-label">5S模版</label>
            <div class="layui-input-block">
                <select name="The5STemplateMainId" class="tpl-select"><option value="">-- 请选择 --</option></select>
            </div>
        </div>
    </div>

    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">最近点检日期</label><div class="layui-input-block"><input type="text" name="LastCheckDate" lay-verify="datetime" class="layui-input" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">下次点检日期</label><div class="layui-input-block"><input type="text" name="NextCheckDate" lay-verify="datetime" class="layui-input" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">最近维修日期</label><div class="layui-input-block"><input type="text" name="LastRepairDate" lay-verify="datetime" class="layui-input" /></div></div></div>

    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">月保上次日期</label><div class="layui-input-block"><input type="text" name="LastMonthMainTainDate" lay-verify="datetime" class="layui-input" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">季保上次日期</label><div class="layui-input-block"><input type="text" name="LastYSeasonMainTainDate" lay-verify="datetime" class="layui-input" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">年保上次日期</label><div class="layui-input-block"><input type="text" name="LastYearMainTainDate" lay-verify="datetime" class="layui-input" /></div></div></div>

    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">保养月计划第几周</label><div class="layui-input-block"><input type="text" name="MonthWeek" placeholder="0" class="layui-input" value="0" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">保养第几个工作日</label><div class="layui-input-block"><input type="text" name="MonthPlanDay" placeholder="0" class="layui-input" value="0" /></div></div></div>

    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">连续运行时长(h)</label><div class="layui-input-block"><input type="text" name="Continuous_WorkTime" class="layui-input" value="0" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">运行时间(h)</label><div class="layui-input-block"><input type="text" name="RunTime" class="layui-input" value="0" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">通电时间(h)</label><div class="layui-input-block"><input type="text" name="ElectrifyTime" class="layui-input" value="0" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">连续累计数量</label><div class="layui-input-block"><input type="text" name="Continuous_Qty" class="layui-input" value="0" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">配方Ids</label><div class="layui-input-block"><input type="text" name="FormulaIds" class="layui-input" /></div></div></div>
</div>
