@{
    var L = "layui-col-lg4 layui-col-md4 layui-col-sm6 layui-col-xs12";
}
<div class="layui-row layui-col-space10">
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">出厂编号(制造)</label><div class="layui-input-block"><input type="text" name="ManufactureNumber" class="layui-input" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">机身编号</label><div class="layui-input-block"><input type="text" name="EquipmentBodyNumber" class="layui-input" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">测量范围</label><div class="layui-input-block"><input type="text" name="MeasurementRange" class="layui-input" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">分辨率</label><div class="layui-input-block"><input type="text" name="Resolution" class="layui-input" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">精度</label><div class="layui-input-block"><input type="text" name="Accuracy" class="layui-input" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">校准日期</label><div class="layui-input-block"><input type="text" name="CalibrationDate" lay-verify="datetime" class="layui-input" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">校准周期</label><div class="layui-input-block"><input type="text" name="CalibrationCycle" class="layui-input" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">校准过期日期</label><div class="layui-input-block"><input type="text" name="CalibrationExpirationDate" lay-verify="datetime" class="layui-input" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">过期预警天数</label><div class="layui-input-block"><input type="text" name="CalibrationExpirationWarningDays" class="layui-input" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">保管人</label><div class="layui-input-block"><input type="text" name="Custodian" class="layui-input" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">实际值</label><div class="layui-input-block"><input type="text" name="ActualValue" class="layui-input" /></div></div></div>
</div>
