@using DeviceMgmt.Repository.Domain
@{
    IgnoreBody();
    var title = ViewBag.Title as string ?? "首页";
    var user = ViewData["CurrentUser"] as Sys_User;
    var modules = (ViewData["Modules"] as List<Sys_Module>) ?? new List<Sys_Module>();

    string userDisplayName = user?.Name ?? user?.Account ?? "User";
    string userInitial = !string.IsNullOrEmpty(userDisplayName) ? userDisplayName.Substring(0, 1).ToUpper() : "U";

    var menuJson = Newtonsoft.Json.JsonConvert.SerializeObject(
        modules.Select(m => new
        {
            id = m.Id,
            name = m.Name,
            code = m.Code,
            url = m.Url,
            parentId = m.ParentId,
            sort = m.Sort,
            icon = m.Icon
        }).ToList()
    );
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>arbore TPM · @title</title>
    <link rel="icon" href="~/favicon.ico" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50:  "#f1f7f4", 100: "#def0e5", 200: "#bee1cd",
                            300: "#91c9ac", 400: "#61a983", 500: "#3f8b63",
                            600: "#2c6f4e", 700: "#235840", 800: "#1f4d3b",
                            900: "#1a3f31", 950: "#0f2620"
                        }
                    },
                    fontFamily: {
                        sans: ["Inter", "ui-sans-serif", "system-ui", "-apple-system",
                               "Segoe UI", "PingFang SC", "Hiragino Sans GB",
                               "Microsoft YaHei", "sans-serif"]
                    }
                }
            }
        };
    </script>
    <link href="~/css/app.css" rel="stylesheet" />

    <style>
        .app-shell { display: grid; grid-template-columns: var(--sidebar-w) 1fr; grid-template-rows: var(--header-h) 1fr; height: 100vh; }
        .app-shell.collapsed { grid-template-columns: var(--sidebar-collapsed-w) 1fr; }

        .app-header { grid-column: 1 / -1; display: flex; align-items: center; background: var(--bg); border-bottom: 1px solid var(--border-soft); padding: 0 16px; gap: 12px; z-index: 50; }
        .app-sidebar { background: var(--bg-sidebar); color: #d8e3de; overflow-y: auto; overflow-x: hidden; transition: width .2s ease; }
        .app-main { display: flex; flex-direction: column; overflow: hidden; background: var(--bg-muted); }
        .app-tabs { height: var(--tabbar-h); display: flex; align-items: center; background: var(--bg); border-bottom: 1px solid var(--border-soft); padding: 0 8px; gap: 4px; overflow-x: auto; }
        .app-content { flex: 1; position: relative; background: var(--bg); }
        .app-content iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

        .nav-section { padding: 12px 8px 4px; font-size: 11px; color: rgba(255,255,255,.4); font-weight: 600; text-transform: uppercase; letter-spacing: .04em; }
        .app-shell.collapsed .nav-section { display: none; }

        .nav-item { display: flex; align-items: center; gap: 10px; padding: 7px 14px; color: rgba(255,255,255,.78); font-size: 13px; cursor: pointer; user-select: none; border-left: 2px solid transparent; transition: background .12s, color .12s; }
        .nav-item:hover { background: var(--bg-sidebar-hover); color: #fff; }
        .nav-item.active { background: var(--bg-sidebar-hover); color: #fff; border-left-color: var(--brand-400); }
        /* 折叠箭头：纯 CSS，避免每次 toggle 调用 lucide.createIcons 导致 SVG 重复插入 */
        .nav-item .arrow {
            margin-left: auto;
            width: 8px;
            height: 8px;
            border-right: 2px solid currentColor;
            border-bottom: 2px solid currentColor;
            transform: rotate(-45deg);
            opacity: .55;
            flex-shrink: 0;
            transition: transform .15s ease, opacity .15s;
        }
        .nav-item.expanded .arrow { transform: rotate(45deg); opacity: .75; }
        .nav-sub { background: rgba(0,0,0,.18); }
        .nav-sub .nav-item { padding-left: 38px; font-size: 12.5px; color: rgba(255,255,255,.68); }

        .app-shell.collapsed .app-sidebar { overflow: visible; }
        .app-shell.collapsed .nav-item-label, .app-shell.collapsed .arrow { display: none; }
        .app-shell.collapsed .nav-item { justify-content: center; padding: 9px 0; }
        .app-shell.collapsed .nav-sub { display: none !important; }

        .tab-pill { display: inline-flex; align-items: center; gap: 6px; height: 28px; padding: 0 10px 0 12px; border-radius: 6px; background: transparent; color: var(--fg-muted); font-size: 12.5px; cursor: pointer; max-width: 200px; }
        .tab-pill:hover { background: var(--bg-muted); color: var(--fg); }
        .tab-pill.active { background: var(--brand-50); color: var(--brand-800); font-weight: 500; }
        .tab-pill .tab-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .tab-pill .tab-close { display: inline-flex; width: 16px; height: 16px; border-radius: 4px; align-items: center; justify-content: center; opacity: 0; }
        .tab-pill:hover .tab-close, .tab-pill.active .tab-close { opacity: .7; }
        .tab-pill .tab-close:hover { opacity: 1; background: rgba(0,0,0,.08); }
        .tab-pill.home-tab .tab-close { display: none; }

        .tab-ctx-menu { z-index: 300; min-width: 10.5rem; padding: 4px 0;
            border-radius: 8px; border: 1px solid var(--border-soft); background: var(--bg);
            box-shadow: var(--shadow-pop); font-size: 13px; color: var(--fg); }
        .tab-ctx-menu-item { padding: 8px 14px; cursor: pointer; user-select: none; }
        .tab-ctx-menu-item:hover { background: var(--bg-muted); }
        .tab-ctx-menu-item.danger { color: var(--danger); }
        .tab-ctx-menu-item.danger:hover { background: #fef2f2; }
        [data-theme="dark"] .tab-ctx-menu-item.danger:hover { background: rgba(220,38,38,.12); }
    </style>
    @RenderSection("Style", required: false)
</head>
<body class="font-sans antialiased">

<div id="app" class="app-shell" :class="{ 'collapsed': sidebarCollapsed }"
     x-data="appShell()" x-cloak>

    @* ===== 顶栏 ===== *@
    <header class="app-header">
        <button class="btn-icon btn btn-ghost" @@click="toggleSidebar" title="切换侧栏">
            <i data-lucide="panel-left"></i>
        </button>
        <div class="flex items-center gap-2.5 mr-3">
            <img src="~/img/logo.png" alt="arbore" class="w-7 h-7 rounded" />
            <div class="flex flex-col leading-tight">
                <span class="text-[13px] font-semibold text-slate-800">arbore TPM</span>
                <span class="text-[10px] text-slate-400 -mt-0.5">设备全生命周期管理</span>
            </div>
        </div>

        <div class="input-group max-w-md flex-1 relative" style="height: 32px;"
             @@click.outside="searchOpen = false">
            <i data-lucide="search" class="input-icon"></i>
            <input type="text" class="input pr-12"
                   placeholder="搜索菜单 (Ctrl + K)..."
                   x-ref="searchInput"
                   x-model="searchQuery"
                   @@input="onSearchInput()"
                   @@focus="onSearchInput(); searchOpen = true;"
                   @@keydown.escape.prevent="searchOpen = false"
                   @@keydown.down.prevent="moveSearch(1)"
                   @@keydown.up.prevent="moveSearch(-1)"
                   @@keydown.enter.prevent="selectSearchHit()" />
            <kbd class="absolute right-2 top-1/2 -translate-y-1/2 text-[10px] text-slate-400 border border-slate-200 rounded px-1.5 py-0.5 select-none pointer-events-none bg-slate-50">⌘K</kbd>

            <div x-show="searchOpen" x-cloak x-transition
                 class="absolute left-0 right-0 top-full mt-1 bg-white border border-slate-200 rounded-lg shadow-xl z-50 max-h-96 overflow-auto">
                <template x-if="searchResults.length === 0">
                    <div class="px-3 py-6 text-center text-xs text-slate-400">
                        <span x-show="!searchQuery">输入关键字搜索菜单</span>
                        <span x-show="searchQuery">没有匹配的菜单</span>
                    </div>
                </template>
                <template x-for="(r, idx) in searchResults" :key="r.id">
                    <div class="px-3 py-2 cursor-pointer flex items-center gap-2 text-sm border-b border-slate-50 last:border-0"
                         :class="{ 'bg-brand-50 text-brand-900': idx === searchHitIdx, 'hover:bg-slate-50': idx !== searchHitIdx }"
                         @@mouseenter="searchHitIdx = idx"
                         @@click="selectSearchHit(r)">
                        <i data-lucide="hash" class="w-3.5 h-3.5 text-slate-400 flex-shrink-0"></i>
                        <span class="flex-shrink-0" x-html="r.highlighted"></span>
                        <span class="text-xs text-slate-400 truncate" x-text="r.crumb ? '· ' + r.crumb : ''"></span>
                        <span class="ml-auto text-xs text-slate-400 truncate" x-text="r.url"></span>
                    </div>
                </template>
                <div class="px-3 py-1.5 border-t border-slate-100 bg-slate-50 text-[10px] text-slate-400 flex items-center gap-3">
                    <span><kbd class="px-1 bg-white border border-slate-200 rounded">↑↓</kbd> 选择</span>
                    <span><kbd class="px-1 bg-white border border-slate-200 rounded">↵</kbd> 打开</span>
                    <span><kbd class="px-1 bg-white border border-slate-200 rounded">Esc</kbd> 关闭</span>
                </div>
            </div>
        </div>

        <div class="flex-1"></div>

        <button class="btn-icon btn btn-ghost relative" title="通知（开发中）">
            <i data-lucide="bell"></i>
        </button>

        @* ===== 用户头像 dropdown ===== *@
        <div class="relative" @@click.outside="menuOpen = false">
            <button class="flex items-center gap-2 px-2 py-1 rounded hover:bg-slate-100"
                    @@click="menuOpen = !menuOpen">
                <span class="w-7 h-7 rounded-full bg-brand-800 text-white inline-flex items-center justify-center text-xs font-semibold">@userInitial</span>
                <span class="text-sm text-slate-700 hidden sm:inline">@userDisplayName</span>
                <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-slate-400"></i>
            </button>

            <div x-show="menuOpen" x-transition class="dropdown" style="right: 0; top: calc(100% + 4px);">
                <div class="px-3 py-2 border-b border-slate-100">
                    <div class="text-sm font-medium text-slate-800">@userDisplayName</div>
                    <div class="text-xs text-slate-500">@(user?.Account)</div>
                </div>
                <button type="button" class="dropdown-item w-full text-left" @@click.stop="openProfile">
                    <i data-lucide="user" class="icon"></i>
                    <span>个人资料</span>
                </button>
                <button type="button" class="dropdown-item w-full text-left" @@click.stop="openChangePwd">
                    <i data-lucide="key-round" class="icon"></i>
                    <span>修改密码</span>
                </button>
                <button type="button" class="dropdown-item w-full text-left" @@click.stop="toggleTheme">
                    <i data-lucide="moon" class="icon" x-show="theme === 'light'"></i>
                    <i data-lucide="sun" class="icon" x-show="theme === 'dark'"></i>
                    <span x-text="theme === 'light' ? '切换到暗色' : '切换到亮色'"></span>
                </button>
                <div class="dropdown-divider"></div>
                <button type="button" class="dropdown-item dropdown-item-danger w-full text-left" @@click.stop="logout">
                    <i data-lucide="log-out" class="icon"></i>
                    <span>退出登录</span>
                </button>
            </div>
        </div>
    </header>

    @* ===== 左侧菜单 ===== *@
    <aside class="app-sidebar">
        <div class="py-2">
            <template x-if="!sidebarCollapsed">
                <div class="nav-section">导航</div>
            </template>
            <div class="nav-item" :class="{ active: activeTabId === 'home' }" :title="sidebarCollapsed ? '首页' : ''" @@click="openHomeTab">
                <i data-lucide="home"></i>
                <span class="nav-item-label">首页</span>
            </div>

            <template x-for="m in topMenus" :key="m.id">
                <div>
                    <div class="nav-item"
                         :class="{ active: activeMenuId === m.id, expanded: expanded[m.id] }"
                         :title="sidebarCollapsed ? (m.name || '') : ''"
                         @@click="onMenuClick(m)">
                        <i :data-lucide="m.icon || 'circle-dot'"></i>
                        <span class="nav-item-label" x-text="m.name"></span>
                        <template x-if="hasChildren(m.id) && !sidebarCollapsed">
                            <span class="arrow" aria-hidden="true"></span>
                        </template>
                    </div>
                    <template x-if="hasChildren(m.id) && expanded[m.id] && !sidebarCollapsed">
                        <div class="nav-sub">
                            <template x-for="c in childrenOf(m.id)" :key="c.id">
                                <div class="nav-item"
                                     :class="{ active: activeMenuId === c.id }"
                                     @@click.stop="openTab(c)">
                                    <span class="nav-item-label" x-text="c.name"></span>
                                </div>
                            </template>
                        </div>
                    </template>
                </div>
            </template>

            <template x-if="topMenus.length === 0">
                <div class="px-4 py-6 text-xs text-white/50 italic">
                    <template x-if="!sidebarCollapsed">
                        <span>当前账号未配置菜单<br/>请联系管理员授权</span>
                    </template>
                </div>
            </template>
        </div>
    </aside>

    @* ===== 主区：tabs + 内容 ===== *@
    <main class="app-main">
        <div class="app-tabs">
            <template x-for="t in tabs" :key="t.id">
                <div class="tab-pill"
                     :class="{ active: activeTabId === t.id, 'home-tab': t.id === 'home' }"
                     @@click="activateTab(t.id)"
                     @@contextmenu.prevent="openTabCtx($event, t.id)"
                     @@mousedown="onTabMouseDown($event, t.id)"
                     :draggable="t.id !== 'home'"
                     @@dragstart="onTabDragStart($event, t.id)"
                     @@dragover="onTabDragOver($event, t.id)"
                     @@drop="onTabDrop($event, t.id)"
                     @@dragend="onTabDragEnd()">
                    <span class="tab-name" x-text="t.title"></span>
                    <span class="tab-close" @@click.stop="closeTab(t.id)" x-show="t.id !== 'home'">
                        <i data-lucide="x" class="w-3 h-3"></i>
                    </span>
                </div>
            </template>
        </div>

        <div class="app-content">
            <template x-for="t in tabs" :key="t.id">
                <iframe :src="t.url" x-show="activeTabId === t.id" loading="lazy"></iframe>
            </template>
        </div>
    </main>

    <!-- Tab 右键菜单（关闭 / 关闭其他 / 关闭右侧） -->
    <div x-show="tabCtxMenu.open"
         x-cloak
         class="tab-ctx-menu fixed"
         :style="'left:' + tabCtxMenu.x + 'px;top:' + tabCtxMenu.y + 'px'"
         @@click.outside="closeTabCtx">
        <div class="tab-ctx-menu-item" @@click.stop="ctxCloseTab">关闭</div>
        <div class="tab-ctx-menu-item" @@click.stop="ctxCloseOthers">关闭其他</div>
        <div class="tab-ctx-menu-item" @@click.stop="ctxCloseRight">关闭右侧</div>
    </div>
</div>

<div x-data="{}" @@open-change-pwd.window="document.getElementById('cp-modal').classList.remove('hidden')"></div>

<div id="cp-modal" class="modal-mask hidden" x-data="changePwdForm()" x-cloak>
    <div class="modal" @@click.outside="close" style="width:420px;">
        <div class="modal-header">
            <h3 class="text-base font-semibold">修改密码</h3>
            <button class="btn-icon btn btn-ghost" @@click="close"><i data-lucide="x"></i></button>
        </div>
        <div class="modal-body space-y-3">
            <div>
                <label class="block text-xs font-medium text-slate-600 mb-1">旧密码</label>
                <input type="password" class="input" x-model="oldPwd" autocomplete="current-password" />
            </div>
            <div>
                <label class="block text-xs font-medium text-slate-600 mb-1">新密码（至少 6 位）</label>
                <input type="password" class="input" x-model="newPwd" autocomplete="new-password" />
            </div>
            <div>
                <label class="block text-xs font-medium text-slate-600 mb-1">确认新密码</label>
                <input type="password" class="input" x-model="confirmPwd" autocomplete="new-password" />
            </div>
            <p x-show="error" x-text="error" class="text-sm text-red-500"></p>
        </div>
        <div class="modal-footer">
            <button class="btn btn-default" @@click="close">取消</button>
            <button class="btn btn-primary" @@click="submit" :disabled="loading">
                <span x-show="!loading">确认修改</span>
                <span x-show="loading" class="inline-flex items-center gap-2"><span class="spinner"></span> 处理中</span>
            </button>
        </div>
    </div>
</div>

@* ===== 个人资料弹窗 ===== *@
<div id="pf-modal" class="modal-mask hidden" x-data="profileModal()" x-cloak>
    <div class="modal" @@click.outside="close" style="width:420px;">
        <div class="modal-header">
            <h3 class="text-base font-semibold">个人资料</h3>
            <button class="btn-icon btn btn-ghost" @@click="close"><i data-lucide="x"></i></button>
        </div>
        <div class="modal-body">
            <template x-if="!data">
                <div class="text-center py-8 text-slate-400">
                    <span class="spinner"></span>
                </div>
            </template>
            <template x-if="data">
                <dl class="space-y-3 text-sm">
                    <div class="flex"><dt class="w-24 text-slate-500">账号</dt><dd x-text="data.account"></dd></div>
                    <div class="flex"><dt class="w-24 text-slate-500">姓名</dt><dd x-text="data.name || '-'"></dd></div>
                    <div class="flex"><dt class="w-24 text-slate-500">用户ID</dt><dd x-text="data.id"></dd></div>
                    <div class="flex"><dt class="w-24 text-slate-500">状态</dt><dd><span class="badge badge-success" x-show="data.status === 1">启用</span><span class="badge badge-default" x-show="data.status !== 1">停用</span></dd></div>
                    <div class="flex"><dt class="w-24 text-slate-500">可见菜单</dt><dd x-text="data.moduleCount + ' 个'"></dd></div>
                </dl>
            </template>
        </div>
        <div class="modal-footer">
            <button class="btn btn-default" @@click="close">关闭</button>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/jquery@1.11.3/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/lucide@0.428.0/dist/umd/lucide.min.js"></script>
<script src="~/js/app.js"></script>

<script>
    var __MENU_DATA__ = @Html.Raw(menuJson);
    var __URL_LOGOUT__ = "@Url.Action("Logout", "Account")";
    var __URL_PROFILE__ = "@Url.Action("Profile", "Account")";
    var __URL_CHANGE_PWD__ = "@Url.Action("ChangePassword", "Account")";

    function appShell() {
        return {
            menus: __MENU_DATA__ || [],
            sidebarCollapsed: localStorage.getItem("sidebarCollapsed") === "1",
            theme: localStorage.getItem("theme") || "light",
            menuOpen: false,
            expanded: {},
            tabCtxMenu: { open: false, x: 0, y: 0, tabId: null },
            draggingTabId: null,
            tabs: [{ id: "home", title: "首页", url: "about:blank", menuId: null }],
            activeTabId: "home",
            activeMenuId: null,

            /* ===== 全局搜索 ===== */
            searchOpen: false,
            searchQuery: "",
            searchHitIdx: 0,
            searchResults: [],

            init() {
                this.tabs[0].url = "@Url.Action("Welcome", "Home")";
                this.theme = localStorage.getItem("theme") || "light";
                document.documentElement.setAttribute("data-theme", this.theme);
                this.$nextTick(() => {
                    if (window.lucide) lucide.createIcons();
                });
                window.addEventListener("message", (e) => {
                    if (e.data && e.data.type === "iframe-loaded" && this.activeTabId) {
                        var t = this.tabs.find(x => x.id === this.activeTabId);
                        if (t && e.data.title && t.title !== e.data.title && t.id !== "home" && this.isReadableTabTitle(e.data.title)) {
                            t.title = e.data.title;
                        }
                    }
                });
                document.addEventListener("keydown", (e) => {
                    if (e.key === "Escape") { this.closeTabCtx(); this.searchOpen = false; }
                    // Ctrl/Cmd + K 聚焦搜索
                    if ((e.ctrlKey || e.metaKey) && (e.key === "k" || e.key === "K")) {
                        e.preventDefault();
                        if (this.$refs.searchInput) {
                            this.$refs.searchInput.focus();
                            this.$refs.searchInput.select();
                        }
                        this.searchOpen = true;
                        this.onSearchInput();
                    }
                });
            },

            /* ===== 全局搜索方法 ===== */
            _searchableMenus() {
                // 仅返回有 URL 的菜单（即可打开的叶子节点）
                return this.menus.filter(m => m.url && m.url.length > 0);
            },
            _highlight(text, q) {
                if (!q) return text;
                var lower = (text || "").toLowerCase();
                var i = lower.indexOf(q);
                if (i < 0) return text;
                return text.substring(0, i)
                     + '<mark class="bg-yellow-200 text-brand-900 rounded px-0.5">' + text.substring(i, i + q.length) + '</mark>'
                     + text.substring(i + q.length);
            },
            _wrapHit(m, q) {
                var parent = this.menus.find(x => x.id === m.parentId);
                return {
                    id: m.id,
                    name: m.name,
                    url: m.url,
                    crumb: parent ? parent.name : "",
                    highlighted: this._highlight(m.name || "", q)
                };
            },
            onSearchInput() {
                var q = (this.searchQuery || "").trim().toLowerCase();
                this.searchHitIdx = 0;
                var all = this._searchableMenus();
                if (!q) {
                    // 无关键字：展示常用前 8 项
                    this.searchResults = all.slice(0, 8).map(m => this._wrapHit(m, ""));
                    return;
                }
                var hits = [];
                for (var i = 0; i < all.length; i++) {
                    var m = all[i];
                    var name = (m.name || "").toLowerCase();
                    var code = (m.code || "").toLowerCase();
                    var url  = (m.url  || "").toLowerCase();
                    if (name.indexOf(q) >= 0 || code.indexOf(q) >= 0 || url.indexOf(q) >= 0) {
                        hits.push(this._wrapHit(m, q));
                    }
                    if (hits.length >= 30) break;
                }
                this.searchResults = hits;
            },
            moveSearch(delta) {
                if (!this.searchResults.length) return;
                var n = this.searchResults.length;
                this.searchHitIdx = (this.searchHitIdx + delta + n) % n;
                this.$nextTick(() => {
                    var box = document.querySelector('[x-ref="searchInput"]');
                    var panel = box && box.parentElement && box.parentElement.querySelector('div.absolute');
                    var rows = panel ? panel.querySelectorAll('div.cursor-pointer') : [];
                    if (rows[this.searchHitIdx]) rows[this.searchHitIdx].scrollIntoView({ block: "nearest" });
                });
            },
            selectSearchHit(r) {
                var hit = r || this.searchResults[this.searchHitIdx];
                if (!hit) return;
                var menu = this.menus.find(x => x.id === hit.id);
                if (!menu) return;
                this.searchOpen = false;
                this.searchQuery = "";
                this.searchResults = [];
                this.openTab(menu);
            },
            isReadableTabTitle(title) {
                if (!title) return false;
                var s = String(title).trim();
                if (!s) return false;
                if (s.indexOf("�") >= 0) return false;
                if (s.indexOf("Facility_") >= 0 || s.indexOf("Mold_") >= 0) return false;
                if (/^[\w\s\-\|:\/.]+$/.test(s)) return false;
                return true;
            },

            get topMenus() {
                return this.menus.filter(m => !m.parentId || m.parentId === 0)
                                 .sort((a, b) => (a.sort || 0) - (b.sort || 0));
            },
            childrenOf(parentId) {
                return this.menus.filter(m => m.parentId === parentId)
                                 .sort((a, b) => (a.sort || 0) - (b.sort || 0));
            },
            hasChildren(id) { return this.childrenOf(id).length > 0; },

            onMenuClick(m) {
                if (this.hasChildren(m.id)) {
                    this.expanded[m.id] = !this.expanded[m.id];
                } else {
                    this.openTab(m);
                }
            },

            openTab(m) {
                this.closeTabCtx();
                if (!m.url) { App.warn("该菜单未配置 URL"); return; }
                this.activeMenuId = m.id;
                var existed = this.tabs.find(t => t.menuId === m.id);
                if (existed) { this.activateTab(existed.id); return; }
                var url = m.url;
                if (url.indexOf("moduleId=") === -1) {
                    url += (url.indexOf("?") === -1 ? "?" : "&") + "moduleId=" + m.id;
                }
                var tab = { id: "m" + m.id, title: m.name, url: url, menuId: m.id };
                this.tabs.push(tab);
                this.activeTabId = tab.id;
                this.$nextTick(() => { if (window.lucide) lucide.createIcons(); });
            },

            openHomeTab() {
                this.closeTabCtx();
                this.activeTabId = "home";
                this.activeMenuId = null;
            },

            activateTab(id) {
                this.closeTabCtx();
                this.activeTabId = id;
                var t = this.tabs.find(x => x.id === id);
                this.activeMenuId = t ? t.menuId : null;
            },

            closeTab(id) {
                if (id === "home") return;
                var idx = this.tabs.findIndex(t => t.id === id);
                if (idx === -1) return;
                this.tabs.splice(idx, 1);
                if (this.activeTabId === id) {
                    var fallback = this.tabs[idx] || this.tabs[idx - 1] || this.tabs[0];
                    this.activateTab(fallback.id);
                }
            },

            openTabCtx(e, tabId) {
                if (tabId === "home") return;
                e.preventDefault();
                e.stopPropagation();
                var mw = 172, mh = 120;
                var x = Math.min(e.clientX, window.innerWidth - mw - 6);
                var y = Math.min(e.clientY, window.innerHeight - mh - 6);
                this.tabCtxMenu = { open: true, x: Math.max(6, x), y: Math.max(6, y), tabId: tabId };
            },

            closeTabCtx() {
                this.tabCtxMenu.open = false;
                this.tabCtxMenu.tabId = null;
            },

            onTabMouseDown(e, tabId) {
                if (e.button !== 1) return;
                e.preventDefault();
                if (tabId !== "home") this.closeTab(tabId);
            },

            onTabDragStart(e, tabId) {
                if (tabId === "home") return;
                this.draggingTabId = tabId;
                if (e.dataTransfer) {
                    e.dataTransfer.effectAllowed = "move";
                    try { e.dataTransfer.setData("text/plain", tabId); } catch (_) { }
                }
            },

            onTabDragOver(e, tabId) {
                if (!this.draggingTabId || this.draggingTabId === tabId) return;
                e.preventDefault();
                if (e.dataTransfer) e.dataTransfer.dropEffect = "move";
            },

            onTabDrop(e, tabId) {
                if (!this.draggingTabId || this.draggingTabId === tabId) return;
                e.preventDefault();

                var fromIdx = this.tabs.findIndex(t => t.id === this.draggingTabId);
                var toIdx = this.tabs.findIndex(t => t.id === tabId);
                if (fromIdx < 0 || toIdx < 0) { this.draggingTabId = null; return; }

                var dragged = this.tabs[fromIdx];
                if (!dragged || dragged.id === "home") { this.draggingTabId = null; return; }

                this.tabs.splice(fromIdx, 1);
                if (fromIdx < toIdx) toIdx--;
                this.tabs.splice(toIdx, 0, dragged);
                this.draggingTabId = null;
            },

            onTabDragEnd() {
                this.draggingTabId = null;
            },

            ctxCloseTab() {
                if (this.tabCtxMenu.tabId) this.closeTab(this.tabCtxMenu.tabId);
                this.closeTabCtx();
            },

            ctxCloseOthers() {
                var keep = this.tabCtxMenu.tabId;
                this.tabs = this.tabs.filter(t => t.id === "home" || t.id === keep);
                this.activateTab(keep || "home");
                this.closeTabCtx();
            },

            ctxCloseRight() {
                var tid = this.tabCtxMenu.tabId;
                var idx = this.tabs.findIndex(t => t.id === tid);
                if (idx < 0) { this.closeTabCtx(); return; }
                for (var i = this.tabs.length - 1; i > idx; i--) {
                    if (this.tabs[i].id !== "home") this.tabs.splice(i, 1);
                }
                if (!this.tabs.some(t => t.id === this.activeTabId)) this.activateTab(tid);
                this.closeTabCtx();
            },

            toggleSidebar() {
                this.sidebarCollapsed = !this.sidebarCollapsed;
                localStorage.setItem("sidebarCollapsed", this.sidebarCollapsed ? "1" : "0");
                /* 不再全量 createIcons：侧栏箭头已改为 CSS，重复调用会在部分环境下叠多个 SVG */
            },

            toggleTheme() {
                this.theme = App.toggleTheme();
                this.menuOpen = false;
                this.$nextTick(() => { if (window.lucide) lucide.createIcons(); });
            },

            openProfile() {
                this.menuOpen = false;
                this.closeTabCtx();
                document.getElementById("pf-modal").classList.remove("hidden");
                document.getElementById("pf-modal").dispatchEvent(new CustomEvent("pf-open"));
            },

            openChangePwd() {
                this.menuOpen = false;
                this.closeTabCtx();
                document.getElementById("cp-modal").classList.remove("hidden");
            },

            logout() {
                this.menuOpen = false;
                this.closeTabCtx();
                if (confirm("确定退出登录？")) {
                    window.location.href = __URL_LOGOUT__;
                }
            }
        };
    }

    function changePwdForm() {
        return {
            oldPwd: "", newPwd: "", confirmPwd: "", error: "", loading: false,
            close() {
                document.getElementById("cp-modal").classList.add("hidden");
                this.oldPwd = ""; this.newPwd = ""; this.confirmPwd = ""; this.error = "";
            },
            submit() {
                this.error = "";
                if (!this.oldPwd || !this.newPwd) { this.error = "旧密码和新密码不能为空"; return; }
                if (this.newPwd.length < 6)       { this.error = "新密码至少 6 位"; return; }
                if (this.newPwd !== this.confirmPwd) { this.error = "两次输入的新密码不一致"; return; }
                this.loading = true;
                var self = this;
                $.ajax({
                    url: __URL_CHANGE_PWD__,
                    type: "POST",
                    data: { oldPassword: self.oldPwd, newPassword: self.newPwd },
                    dataType: "json"
                }).done(function (res) {
                    self.loading = false;
                    if (res && res.code === 200) {
                        App.success("密码已修改");
                        self.close();
                    } else {
                        self.error = (res && res.msg) ? res.msg : "修改失败";
                    }
                }).fail(function (xhr) {
                    self.loading = false;
                    self.error = "服务器错误 (" + xhr.status + ")";
                });
            }
        };
    }

    function profileModal() {
        return {
            data: null,
            init() {
                document.getElementById("pf-modal").addEventListener("pf-open", () => { this.load(); });
            },
            load() {
                this.data = null;
                var self = this;
                $.ajax({ url: __URL_PROFILE__, type: "GET", dataType: "json" })
                    .done(function (res) { if (res && res.code === 200) self.data = res.data; });
            },
            close() { document.getElementById("pf-modal").classList.add("hidden"); }
        };
    }
</script>
<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.1/dist/cdn.min.js" defer></script>

@RenderSection("Script", required: false)
</body>
</html>
