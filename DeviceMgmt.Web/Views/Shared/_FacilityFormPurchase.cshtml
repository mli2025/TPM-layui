@{
    var L = "layui-col-lg4 layui-col-md4 layui-col-sm6 layui-col-xs12";
}
<div class="layui-row layui-col-space10">
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">购置日期</label><div class="layui-input-block"><input type="text" name="PurchaseDate" lay-verify="date" class="layui-input" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">购置价</label><div class="layui-input-block"><input type="text" name="PurchasePrice" class="layui-input" value="0" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">到期日期</label><div class="layui-input-block"><input type="text" name="ExpireDate" lay-verify="date" class="layui-input" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">资产编码</label><div class="layui-input-block"><input type="text" name="AssetNumber" class="layui-input" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">资产管理员</label><div class="layui-input-block"><input type="text" name="AssetManager" class="layui-input" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">验收日期</label><div class="layui-input-block"><input type="text" name="AcceptanceDate" lay-verify="date" class="layui-input" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">入库日期</label><div class="layui-input-block"><input type="text" name="InWarehouseDate" lay-verify="datetime" class="layui-input" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">入库人</label><div class="layui-input-block ref-emp-wrap" style="position:relative;"><input type="hidden" name="InWarehouseUserId"><input type="text" readonly class="layui-input ref-pk-display" placeholder="点击选择入库人(可选)" style="cursor:pointer;padding-right:34px;background:#fff;"><i class="layui-icon layui-icon-search ref-pk-btn" title="选择员工" style="position:absolute;right:1px;top:1px;width:32px;height:36px;line-height:36px;text-align:center;cursor:pointer;color:#5FB878;"></i></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">折旧标准年限</label><div class="layui-input-block"><input type="text" name="StandardYears" class="layui-input" value="0" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">电压(V)</label><div class="layui-input-block"><input type="text" name="Voltage" class="layui-input" value="0" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">尺寸</label><div class="layui-input-block"><input type="text" name="Size" class="layui-input" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">重量(kg)</label><div class="layui-input-block"><input type="text" name="Weight" class="layui-input" value="0" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">设备说明书</label><div class="layui-input-block"><input type="text" name="EquipmentManual" class="layui-input" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">设备图纸</label><div class="layui-input-block"><input type="text" name="EquipmentDrawing" class="layui-input" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">终端地址</label><div class="layui-input-block"><input type="text" name="TerminalAddress" class="layui-input" /></div></div></div>
    <div class="@L"><div class="layui-form-item"><label class="layui-form-label">NWX编码</label><div class="layui-input-block"><input type="text" name="NWXCode" class="layui-input" /></div></div></div>
</div>
