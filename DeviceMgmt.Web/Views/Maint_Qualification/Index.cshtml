@{
    ViewData["Title"] = "维保资质有效期监控";
}
<div class="layui-fluid" style="padding:12px;">
    <div class="layui-card">
        <div class="layui-card-header"><strong>维保资质有效期监控</strong>
            <span style="color:#94a3b8;font-size:12px;margin-left:8px;">三色到期警示：<span style="color:#16a34a;">正常</span> / <span style="color:#f59e0b;">临近</span> / <span style="color:#dc2626;">已过期</span></span>
            <button class="layui-btn layui-btn-sm" id="btnAdd" style="float:right;margin-top:6px;">新增</button>
        </div>
        <div class="layui-card-body">
            <table id="GridMain" lay-filter="GridMain"></table>
        </div>
    </div>
</div>

<script type="text/html" id="barRow">
    <a class="layui-btn layui-btn-xs" lay-event="edit">编辑</a>
    <a class="layui-btn layui-btn-xs layui-btn-danger" lay-event="del">删除</a>
</script>

<script type="text/html" id="tplForm">
    <div style="padding:16px;">
        <form class="layui-form" lay-filter="qualForm">
            <input type="hidden" name="Id" />
            <div class="layui-form-item">
                <div class="layui-inline"><label class="layui-form-label">资质类型</label><div class="layui-input-inline"><input type="text" name="QualType" class="layui-input" placeholder="安全合格证/使用许可证/保修证"></div></div>
                <div class="layui-inline ref-dev-wrap"><label class="layui-form-label">设备</label><div class="layui-input-inline" style="position:relative;"><input type="hidden" name="FacilityId"><input type="text" readonly class="layui-input ref-dev-display" placeholder="点击选择设备" style="cursor:pointer;padding-right:34px;background:#fff;"><i class="layui-icon layui-icon-search ref-dev-btn" title="选择设备" style="position:absolute;right:1px;top:1px;width:32px;height:36px;line-height:36px;text-align:center;cursor:pointer;color:#5FB878;"></i></div></div>
            </div>
            <div class="layui-form-item">
                <div class="layui-inline"><label class="layui-form-label">生效日期</label><div class="layui-input-inline"><input type="text" name="EffectDate" id="fEffect" class="layui-input"></div></div>
                <div class="layui-inline"><label class="layui-form-label">到期日期</label><div class="layui-input-inline"><input type="text" name="ExpireDate" id="fExpire" class="layui-input"></div></div>
            </div>
            <div class="layui-form-item">
                <div class="layui-inline"><label class="layui-form-label">提前预警(天)</label><div class="layui-input-inline"><input type="number" name="WarnDays" class="layui-input" value="30"></div></div>
                <div class="layui-inline"><label class="layui-form-label">状态</label><div class="layui-input-inline">
                    <select name="Status"><option value="1">有效</option><option value="0">停用</option></select>
                </div></div>
            </div>
            <div style="text-align:center;margin-top:10px;">
                <button class="layui-btn" lay-submit lay-filter="qualSave">保存</button>
                <button class="layui-btn layui-btn-primary" type="button" id="qualCancel">关闭</button>
            </div>
        </form>
    </div>
</script>

@section Script{
    <script>
        var URL_LIST = '@Url.Action("GetMainList")', URL_GET = '@Url.Action("GetInfo")', URL_SAVE = '@Url.Action("Save")', URL_DEL = '@Url.Action("Delete")';
        layui.use(['table', 'form', 'layer', 'laydate'], function () {
            var table = layui.table, form = layui.form, layer = layui.layer, laydate = layui.laydate, $ = layui.$;
            function ok(r) { return r && (r.code === 0 || r.code === 200); }
            function dcell(d, f) { return d[f] ? String(d[f]).replace('T', ' ').substring(0, 10) : ''; }
            function expireCell(d) {
                if (!d.ExpireDate) return '';
                var exp = new Date(String(d.ExpireDate).replace('T', ' ').substring(0, 19).replace(/-/g, '/'));
                var now = new Date();
                var days = Math.floor((exp - now) / 86400000);
                var warn = d.WarnDays || 30;
                var txt = dcell(d, 'ExpireDate');
                var color = days < 0 ? '#dc2626' : (days <= warn ? '#f59e0b' : '#16a34a');
                var tag = days < 0 ? '已过期' : (days <= warn ? ('剩' + days + '天') : '正常');
                return '<span style="color:' + color + ';font-weight:600;">' + txt + ' (' + tag + ')</span>';
            }
            function renderList() {
                table.render({
                    elem: '#GridMain', id: 'GridMain', url: URL_LIST, method: 'post',
                    where: { page: 1, limit: 20, searchParam: [] }, page: true, height: 'full-150',
                    cols: [[
                        { type: 'numbers', title: '#' },
                        { field: 'QualType', title: '资质类型', width: 180 },
                        { field: 'FacilityId', title: '设备Id', width: 100 },
                        { field: 'EffectDate', title: '生效日期', width: 130, templet: function (d) { return dcell(d, 'EffectDate'); } },
                        { field: 'ExpireDate', title: '到期日期', width: 200, templet: expireCell },
                        { field: 'WarnDays', title: '预警天数', width: 100, align: 'right' },
                        { field: 'Status', title: '状态', width: 90, templet: function (d) { return d.Status == 1 ? '有效' : '停用'; } },
                        { title: '操作', width: 140, toolbar: '#barRow', fixed: 'right' }
                    ]]
                });
            }
            function openForm(row) {
                row = row || {};
                layer.open({
                    type: 1, area: ['620px', 'auto'], title: row.Id ? '编辑资质' : '新增资质', content: $('#tplForm').html(),
                    success: function (layero, idx) {
                        laydate.render({ elem: '#fEffect', type: 'date' });
                        laydate.render({ elem: '#fExpire', type: 'date' });
                        form.val('qualForm', {
                            Id: row.Id || 0, QualType: row.QualType || '', FacilityId: row.FacilityId || '',
                            EffectDate: dcell(row, 'EffectDate'), ExpireDate: dcell(row, 'ExpireDate'),
                            WarnDays: row.WarnDays || 30, Status: row.Status != null ? String(row.Status) : '1'
                        });
                        form.render(); RefPicker.autoMount($(layero));
                        $('#qualCancel').on('click', function () { layer.close(idx); });
                        form.on('submit(qualSave)', function (data) {
                            var f = data.field;
                            var payload = {
                                Id: parseInt(f.Id || 0, 10), QualType: f.QualType || null,
                                FacilityId: f.FacilityId ? parseInt(f.FacilityId, 10) : null,
                                EffectDate: f.EffectDate || null, ExpireDate: f.ExpireDate || null,
                                WarnDays: parseInt(f.WarnDays || 30, 10), Status: parseInt(f.Status || 1, 10)
                            };
                            $.ajax({ url: URL_SAVE, method: 'POST', contentType: 'application/json', data: JSON.stringify(payload) })
                                .done(function (res) { if (ok(res)) { layer.msg('已保存', { icon: 1 }); layer.close(idx); table.reload('GridMain'); } else layer.msg((res && res.msg) || '失败', { icon: 2 }); });
                            return false;
                        });
                    }
                });
            }
            $('#btnAdd').on('click', function () { openForm({}); });
            table.on('tool(GridMain)', function (obj) {
                if (obj.event === 'edit') openForm(obj.data);
                else if (obj.event === 'del') layer.confirm('确认删除?', function (idx) { $.post(URL_DEL, { id: obj.data.Id }, function () { layer.close(idx); obj.del(); layer.msg('已删除', { icon: 1 }); }); });
            });
            renderList();
        });
    </script>
}
