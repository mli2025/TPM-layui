@{
    ViewData["Title"] = "润滑记录";
}
<div class="layui-fluid" style="padding:12px;">
    <div class="layui-card">
        <div class="layui-card-header"><strong>润滑记录</strong>
            <button class="layui-btn layui-btn-sm" id="btnAdd" style="float:right;margin-top:6px;">新增</button>
        </div>
        <div class="layui-card-body"><table id="GridMain" lay-filter="GridMain"></table></div>
    </div>
</div>
<script type="text/html" id="barRow">
    <a class="layui-btn layui-btn-xs" lay-event="edit">编辑</a>
    <a class="layui-btn layui-btn-xs layui-btn-danger" lay-event="del">删除</a>
</script>
<script type="text/html" id="tplForm">
    <div style="padding:16px;"><form class="layui-form" lay-filter="f">
        <input type="hidden" name="Id" />
        <div class="layui-form-item">
            <div class="layui-inline"><label class="layui-form-label">设备Id</label><div class="layui-input-inline"><input type="number" name="FacilityId" class="layui-input"></div></div>
            <div class="layui-inline"><label class="layui-form-label">润滑部位</label><div class="layui-input-inline"><input type="text" name="LubePart" class="layui-input"></div></div>
        </div>
        <div class="layui-form-item">
            <div class="layui-inline"><label class="layui-form-label">油品型号</label><div class="layui-input-inline"><input type="text" name="OilModel" class="layui-input"></div></div>
            <div class="layui-inline"><label class="layui-form-label">周期(天)</label><div class="layui-input-inline"><input type="number" name="CycleDays" class="layui-input"></div></div>
        </div>
        <div class="layui-form-item">
            <div class="layui-inline"><label class="layui-form-label">上次日期</label><div class="layui-input-inline"><input type="text" name="LastDate" id="fL" class="layui-input"></div></div>
            <div class="layui-inline"><label class="layui-form-label">执行人</label><div class="layui-input-inline"><input type="text" name="Executor" class="layui-input"></div></div>
        </div>
        <div style="text-align:center;margin-top:10px;"><button class="layui-btn" lay-submit lay-filter="save">保存</button><button class="layui-btn layui-btn-primary" type="button" id="cancel">关闭</button></div>
    </form></div>
</script>
@section Script{
<script>
    var U_LIST='@Url.Action("GetMainList")',U_SAVE='@Url.Action("Save")',U_DEL='@Url.Action("Delete")';
    layui.use(['table','form','layer','laydate'],function(){
        var table=layui.table,form=layui.form,layer=layui.layer,laydate=layui.laydate,$=layui.$;
        function ok(r){return r&&(r.code===0||r.code===200);}
        function dc(d,f){return d[f]?String(d[f]).replace('T',' ').substring(0,10):'';}
        function render(){table.render({elem:'#GridMain',id:'GridMain',url:U_LIST,method:'post',where:{page:1,limit:20,searchParam:[]},page:true,height:'full-150',cols:[[
            {type:'numbers',title:'#'},{field:'FacilityId',title:'设备Id',width:100},{field:'LubePart',title:'润滑部位',width:150},
            {field:'OilModel',title:'油品型号',width:150},{field:'CycleDays',title:'周期(天)',width:100,align:'right'},
            {field:'LastDate',title:'上次日期',width:130,templet:function(d){return dc(d,'LastDate');}},{field:'Executor',title:'执行人',width:120},
            {title:'操作',width:140,toolbar:'#barRow',fixed:'right'}]]});}
        function openForm(row){row=row||{};layer.open({type:1,area:['620px','auto'],title:row.Id?'编辑':'新增',content:$('#tplForm').html(),success:function(l,idx){
            laydate.render({elem:'#fL',type:'date'});
            form.val('f',{Id:row.Id||0,FacilityId:row.FacilityId||'',LubePart:row.LubePart||'',OilModel:row.OilModel||'',CycleDays:row.CycleDays||'',LastDate:dc(row,'LastDate'),Executor:row.Executor||''});form.render();
            $('#cancel').on('click',function(){layer.close(idx);});
            form.on('submit(save)',function(data){var f=data.field;var p={Id:parseInt(f.Id||0,10),FacilityId:f.FacilityId?parseInt(f.FacilityId,10):0,LubePart:f.LubePart||null,OilModel:f.OilModel||null,CycleDays:f.CycleDays?parseInt(f.CycleDays,10):null,LastDate:f.LastDate||null,Executor:f.Executor||null};
                $.ajax({url:U_SAVE,method:'POST',contentType:'application/json',data:JSON.stringify(p)}).done(function(r){if(ok(r)){layer.msg('已保存',{icon:1});layer.close(idx);table.reload('GridMain');}else layer.msg((r&&r.msg)||'失败',{icon:2});});return false;});
        }});}
        $('#btnAdd').on('click',function(){openForm({});});
        table.on('tool(GridMain)',function(o){if(o.event==='edit')openForm(o.data);else if(o.event==='del')layer.confirm('确认删除?',function(idx){$.post(U_DEL,{id:o.data.Id},function(){layer.close(idx);o.del();});});});
        render();
    });
</script>
}
