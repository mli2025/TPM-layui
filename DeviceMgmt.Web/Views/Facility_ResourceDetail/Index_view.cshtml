@{
    ViewData["Title"] = "设备资源台账";
}
@section Style{
    <style>.borderRed { background: NavajoWhite; }</style>
}
<div class="layui-fluid" style="padding:0;margin-top:10px">
    <div class="layui-row layui-col-space15">
        <div class="layui-col-md12">
            <div class="layui-card">
                <div class="layui-card-header">
                    <div class="pull-left">设备资源台账 · 全部</div>
                    <div class="demoTable pull-right no-print">
                        <div class="layui-inline" id="searchPanel"></div>
                        <div class="layui-btn-group">
                            <button class="layui-btn layui-btn-sm layui-btn-warm" id="btn_Export">导出</button>
                        </div>
                    </div>
                </div>
                <div class="layui-card-body" style="padding:0">
                    <div class="layui-inline" style="width:100%">
                        <table class="layui-hide" lay-filter="GridMain" id="GridMain"></table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Script{
    <script type='text/html' class="no-print" id='barDemo'>
        <a class='layui-btn layui-btn-xs layui-btn-normal' lay-event='viewModel'>查看</a>
    </script>
    <script>
        var URLThisGetList = '@Url.Action("GetMainList_view")';
        var URLThisExportList = '@Url.Action("ExportExcel")';
        var Cols = [
            { field: 'Id', title: 'Id', width: 80, sort: true },
            { field: 'FacilityCode', title: '设备编码', search: 'input', width: 130 },
            { field: 'FacilityName', title: '设备名称', search: 'input', minWidth: 160 },
            { field: 'FacilityType', title: '设备类型', search: 'input', width: 110 },
            { field: 'Manufacturer', title: '制造商', search: 'input', width: 130 },
            { field: 'Model', title: '型号', width: 110 },
            { field: 'Location', title: '安装位置', width: 130 },
            { field: 'Status', title: '状态', width: 80 },
            { field: 'PurchaseDate', title: '购置日期', width: 110, templet: function (d) { return d.PurchaseDate ? d.PurchaseDate.substring(0,10) : ''; } },
            { fixed: 'right', title: '操作', width: 90, align: 'center', toolbar: '#barDemo' }
        ];
        function viewModel(obj) {
            var Id = obj.data.Id;
            layui.layer.open({
                title: '设备台账查看：' + (obj.data.FacilityName || ''),
                content: '@Url.Action("ViewList")?id=' + Id,
                type: 2,
                area: ['90%', '90%'],
                btn: ['关闭']
            });
        }
    </script>
    <script src="~/js/Page/NomalListPage.js"></script>
}
