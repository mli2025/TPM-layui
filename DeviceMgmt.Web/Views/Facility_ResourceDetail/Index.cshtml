@{
    ViewData["Title"] = "设备资源台账";
}
@section Style{
    <style>
        .ms-edit .layui-form-label{ width:130px; }
        .ms-edit .layui-input-block { margin-left: 130px; }
    </style>
}
<div class="layui-fluid" style="padding:12px;">
    <div class="layui-card">
        <div class="layui-card-header">
            <strong>设备资源台账</strong>
        </div>
        <div class="layui-card-body">
            <div class="layui-form layui-row layui-col-space10" style="margin-bottom:8px;">
                <div class="layui-col-md2">
                    <select id="fltDept" lay-filter="fltDept" lay-search>
                        <option value="">-- 部门(全部) --</option>
                    </select>
                </div>
                <div class="layui-col-md2">
                    <select id="fltStatus" lay-filter="fltStatus">
                        <option value="">-- 设备状态(全部) --</option>
                        <option value="0">运行</option>
                        <option value="1">闲置</option>
                        <option value="2">停机</option>
                        <option value="3">报废</option>
                    </select>
                </div>
                <div class="layui-col-md2">
                    <select id="kwField">
                        <option value="FacilityName">设备名称</option>
                        <option value="FacilityCode">设备编码</option>
                        <option value="Model">型号</option>
                        <option value="SerialNumber">序列号</option>
                        <option value="ManufactureNumber">厂家厂内编号</option>
                        <option value="AssetNumber">资产编号</option>
                    </select>
                </div>
                <div class="layui-col-md2">
                    <input type="text" id="kw" class="layui-input" placeholder="搜索...">
                </div>
                <div class="layui-col-md4" style="text-align:right;">
                    <button class="layui-btn layui-btn-sm" id="btnAdd"><i class="layui-icon layui-icon-add-1"></i> 新增</button>
                    <button class="layui-btn layui-btn-sm layui-btn-primary" id="btnReload"><i class="layui-icon layui-icon-refresh-3"></i> 查询</button>
                    <button class="layui-btn layui-btn-sm layui-btn-normal" id="btnImportTpl"><i class="layui-icon layui-icon-template-1"></i> 导入模板</button>
                    <button class="layui-btn layui-btn-sm layui-btn-normal" id="btnImport"><i class="layui-icon layui-icon-upload"></i> 导入</button>
                    <button class="layui-btn layui-btn-sm layui-btn-warm" id="btnExport"><i class="layui-icon layui-icon-download-circle"></i> 导出</button>
                </div>
            </div>
            <table id="GridMain" lay-filter="GridMain"></table>
        </div>
    </div>
</div>

<script type="text/html" id="tableToolbar">
    <span style="color:#8a8f99;font-size:12px;">提示：点击列头漏斗可按"去重值/条件"筛选（绿色=已筛选）；右上角齿轮可显示/隐藏列；拖动列头可调整顺序。</span>
</script>

<script type="text/html" id="barRow">
    <a class="layui-btn layui-btn-xs" lay-event="view">查看</a>
    <a class="layui-btn layui-btn-xs layui-btn-normal" lay-event="edit">编辑</a>
    <a class="layui-btn layui-btn-xs layui-btn-warm" lay-event="repair">维修记录</a>
    <a class="layui-btn layui-btn-xs layui-btn-danger" lay-event="del">删除</a>
</script>

<script type="text/html" id="statusTpl">
    {{# var map = {0:'运行',1:'闲置',2:'停机',3:'报废'}; var bg = {0:'#16a34a',1:'#f7b500',2:'#94a3b8',3:'#475569'}; }}
    {{# var s = d.Status == null ? 0 : d.Status; }}
    <span class="layui-badge" style="background-color:{{= bg[s] || '#999' }};">{{= map[s] || s }}</span>
</script>

<script type="text/html" id="tplRepairHistory">
    <div style="padding:14px;">
        <div style="margin-bottom:8px;color:#475569;">设备：<strong id="rh_dev"></strong></div>
        <table id="GridRepairHist" lay-filter="GridRepairHist"></table>
    </div>
</script>

<!-- 设备台账明细 弹窗模板 -->
<script type="text/html" id="tplFacilityForm">
    <form action="#" id="facilityForm" class="layui-form layui-form-pane ms-edit" lay-filter="facilityForm" style="padding:10px;">
        <input type="hidden" name="Id" value="0" />
        <div class="layui-tab layui-tab-brief" lay-filter="resTabs" id="resTabs">
            <ul class="layui-tab-title">
                <li class="layui-this" lay-id="basic">基础信息</li>
                <li lay-id="purchase">采购/资产</li>
                <li lay-id="maintain">保养/状态</li>
                <li lay-id="measure">计量器具</li>
                <li lay-id="remark">备注</li>
                <li lay-id="history">保养/点检记录</li>
                <li lay-id="attach">附件</li>
            </ul>
            <div class="layui-tab-content" style="padding:14px 0;">
                <div class="layui-tab-item layui-show">
                    @await Html.PartialAsync("_FacilityFormBasic")
                </div>
                <div class="layui-tab-item">
                    @await Html.PartialAsync("_FacilityFormPurchase")
                </div>
                <div class="layui-tab-item">
                    @await Html.PartialAsync("_FacilityFormMaintain")
                </div>
                <div class="layui-tab-item">
                    @await Html.PartialAsync("_FacilityFormMeasure")
                </div>
                <div class="layui-tab-item">
                    <div class="layui-form-item layui-form-text">
                        <label class="layui-form-label">备注</label>
                        <div class="layui-input-block" style="margin-left:130px;">
                            <textarea name="Remark" placeholder="请输入备注" class="layui-textarea"></textarea>
                        </div>
                    </div>
                    <div class="layui-form-item layui-form-text">
                        <label class="layui-form-label">使用条件</label>
                        <div class="layui-input-block" style="margin-left:130px;">
                            <textarea name="UseCondition" placeholder="使用条件" class="layui-textarea"></textarea>
                        </div>
                    </div>
                </div>
                <div class="layui-tab-item">
                    <div class="layui-tab layui-tab-brief">
                        <ul class="layui-tab-title">
                            <li class="layui-this">保养记录</li>
                            <li>点检记录</li>
                        </ul>
                        <div class="layui-tab-content" style="padding:8px 0;">
                            <div class="layui-tab-item layui-show">
                                <table id="GridMaintHist" lay-filter="GridMaintHist"></table>
                            </div>
                            <div class="layui-tab-item">
                                <table id="GridCheckHist" lay-filter="GridCheckHist"></table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="layui-tab-item">
                    <div id="facilityAttachPanel"></div>
                </div>
            </div>
        </div>
    </form>
</script>

@section Script{
    <script>
        var URL_LIST           = '@Url.Action("GetMainList")';
        var URL_GET            = '@Url.Action("GetMainInfo")';
        var URL_SAVE           = '@Url.Action("SaveFacility")';
        var URL_DELETE         = '@Url.Action("DeleteFacility")';
        var URL_EXPORT         = '@Url.Action("ExportExcel")';
        var URL_TPL_OPTS       = '@Url.Action("GetTemplateOptions")';
        var URL_HISTORY        = '@Url.Action("GetFacilityHistory")';
        var URL_IMPORT_TPL     = '@Url.Action("ImportTemplate")';
        var URL_IMPORT         = '@Url.Action("ImportExcel")';

        // soul-table 模块已在布局 _LayoutInner.cshtml 全局注册，这里直接使用
        layui.use(['table', 'form', 'layer', 'laydate', 'element', 'soulTable', 'upload'], function () {
            var table = layui.table, form = layui.form, layer = layui.layer, laydate = layui.laydate, element = layui.element, upload = layui.upload;
            function ok(res) { return res && (res.code === 0 || res.code === 200); }
            function toast(msg) { layer.msg(msg || ''); }
            function toastOk(msg) { layer.msg(msg || '操作成功', { icon: 1 }); }
            function toastErr(msg) { layer.msg(msg || '操作失败', { icon: 2 }); }
            function fmtDate(s) { return s ? (s + '').replace('T',' ').substring(0,10) : ''; }
            function fmtDt(s) { return s ? (s + '').replace('T',' ').substring(0,19) : ''; }
            // 千分位格式化（小数位 dec，默认 0）：fmtThousand(12345.6, 2) => "12,345.60"
            function fmtThousand(v, dec) {
                if (v == null || v === '') return '';
                var n = Number(v); if (isNaN(n)) return v;
                return n.toLocaleString('en-US', { minimumFractionDigits: dec || 0, maximumFractionDigits: dec || 0 });
            }

            // 顶部粗筛条件（用于服务端预过滤，缩小前端一次性加载的数据量）
            function getWhere() {
                var list = [];
                var kw = ($('#kw').val()||'').trim();
                var kwField = $('#kwField').val() || 'FacilityName';
                var dept = $('#fltDept').val();
                var status = $('#fltStatus').val();
                if (kw) list.push({ field: kwField, conditional: 'like', value: kw });
                if (dept !== '' && dept !== null && dept !== undefined) list.push({ field: 'DeptId', conditional: '=', value: dept });
                if (status !== '' && status !== null && status !== undefined) list.push({ field: 'Status', conditional: '=', value: status });
                // 前端模式：一次性取回全部匹配行，soul-table 才能给出"全部不重复值"的下拉筛选
                return { page: 1, limit: 100000, searchParam: list };
            }

            function buildCols() {
                return [[
                    { type: 'numbers', title: '#', width: 50, fixed:'left' },
                    { field: 'FacilityCode', title: '设备编码', width: 140, fixed:'left', sort: true, filter: true },
                    { field: 'FacilityName', title: '设备名称', minWidth: 160, fixed:'left', sort: true, filter: true },
                    { field: 'Model', title: '设备型号', width: 130, sort: true, filter: true },
                    { field: 'FacilityType', title: '设备类型', width: 120, sort: true, filter: true },
                    { field: 'ManufactureNumber', title: '厂家厂内编号', width: 140, sort: true, filter: true },
                    { field: 'SerialNumber', title: '序列号', width: 140, sort: true, filter: true },
                    { field: 'Manufacturer', title: '制造商', width: 130, sort: true, filter: true },
                    { field: 'Location', title: '安装位置', width: 140, sort: true, filter: true },
                    { field: 'DeptName', title: '部门', width: 120, sort: true, filter: true, templet: function(d){ return d.DeptName || deptName(d.DeptId); } },
                    { field: 'PurchaseDate', title: '购置日期', width: 110, align: 'center', sort: true, filter: { type: 'date[yyyy-MM-dd]' }, templet: function(d){ return fmtDate(d.PurchaseDate); } },
                    { field: 'AssetNumber', title: '资产编号', width: 130, sort: true, filter: true },
                    { field: 'StatusName', title: '状态', width: 90, sort: true, filter: true, templet:'#statusTpl' },
                    { title: '操作', width: 280, toolbar: '#barRow', fixed: 'right' }
                ]];
            }

            // 把编码型字段预先转成可读文本，供 soul-table 去重下拉显示中文
            var __STATUS_MAP__ = {0:'运行',1:'闲置',2:'停机',3:'报废'};
            function decorate(rows) {
                (rows || []).forEach(function(r){
                    r.DeptName = deptName(r.DeptId);
                    var s = r.Status == null ? 0 : r.Status;
                    r.StatusName = __STATUS_MAP__[s] || s;
                    if (r.PurchaseDate) r.PurchaseDate = fmtDate(r.PurchaseDate);
                });
                return rows || [];
            }

            function renderList() { loadData(); }

            function loadData() {
                // 前端模式：取回全部匹配行后用公共组件渲染（去重下拉才能列出全部值）
                SoulGrid.loadAll(URL_LIST, getWhere(), function (rows) {
                    SoulGrid.render({
                        elem: '#GridMain',
                        id: 'GridMain',
                        data: decorate(rows),
                        height: 'full-200',
                        toolbar: '#tableToolbar',
                        filename: '设备台账',
                        cols: buildCols()
                    });
                });
            }

            var __DEPTS__ = [];
            function deptName(id){
                if (id === null || id === undefined || id === '') return '';
                var s = String(id);
                for (var i=0;i<__DEPTS__.length;i++){
                    var d = __DEPTS__[i];
                    if (String(d.Id) === s || (d.DeptNumber !== '' && String(d.DeptNumber) === s)) return d.DeptName;
                }
                return '';
            }
            function deptMapObj() {
                var m = {};
                __DEPTS__.forEach(function (d) { m[String(d.Id)] = d.DeptName || ''; });
                return m;
            }
            function bindFacilityPickers(entity) {
                try {
                    if (window.RefPicker) RefPicker.initFacilityFormPickers($('#facilityForm'), entity || null, deptMapObj());
                } catch (e) { }
            }
            function loadDepts(){
                return $.get('/Sys_Dept/List', function(res){
                    if (ok(res)) {
                        // 兼容后端 Pascal/camel 两种序列化命名，统一为 PascalCase
                        __DEPTS__ = (res.data || []).map(function(d){
                            return {
                                Id: (d.Id != null ? d.Id : d.id),
                                DeptNumber: (d.DeptNumber != null ? d.DeptNumber : (d.deptNumber != null ? d.deptNumber : '')),
                                DeptName: (d.DeptName != null ? d.DeptName : (d.deptName != null ? d.deptName : ''))
                            };
                        });
                        var $sel = $('#fltDept').empty().append('<option value="">-- 部门(全部) --</option>');
                        __DEPTS__.forEach(function(d){ $sel.append('<option value="'+d.Id+'">'+ (d.DeptName||'') +'</option>'); });
                        try { form.render('select'); } catch(e){}
                    }
                });
            }

            function openRepairHistory(row) {
                layer.open({
                    type: 1, area: ['1000px', '70%'], title: '维修记录 - ' + (row.FacilityName||''),
                    content: $('#tplRepairHistory').html(), shadeClose: false,
                    success: function(){
                        $('#rh_dev').text((row.FacilityName||'') + ' (' + (row.FacilityCode||'') + ')');
                        table.render({
                            elem: '#GridRepairHist',
                            url: '/Facility_RepairBillMain/GetMainList',
                            method: 'post',
                            where: { searchParam: [{ field:'FacilityId', conditional:'=', value: row.Id }] },
                            page: true, limit: 20, even: true,
                            cols: [[
                                { field:'BillNo', title:'维修单号', width:140 },
                                { field:'BillDate', title:'报修时间', width:160, templet: function(d){ return fmtDt(d.BillDate); } },
                                { field:'FaultCategory', title:'故障类别', width:110 },
                                { field:'FaultLocation', title:'故障部位', width:130 },
                                { field:'Status', title:'状态', width:90, templet: function(d){
                                    var m = {0:'新建',1:'待接单',2:'维修中',3:'已完成',4:'已审核',5:'已关闭'};
                                    return m[d.Status==null?0:d.Status] || d.Status;
                                }},
                                { field:'RepairStaff', title:'维修人员', width:110 },
                                { field:'Dispatch', title:'派单人', width:110 },
                                { field:'DispatchDate', title:'派单时间', width:160, templet: function(d){ return fmtDt(d.DispatchDate); } },
                                { field:'Remark', title:'备注', minWidth: 160 }
                            ]]
                        });
                    }
                });
            }

            // -------------- 弹窗 --------------
            var TPL_CYCLES = [
                { type: 1, mt: null,      field: 'TheTemplateMainId' },
                { type: 2, mt: 'WEEK',    field: 'WeekTempId' },
                { type: 2, mt: 'MONTH',   field: 'MonthTempId' },
                { type: 2, mt: 'QUARTER', field: 'SeasonTempId' },
                { type: 2, mt: 'YEAR',    field: 'YearTempId' },
                { type: 2, mt: null,      field: 'The5STemplateMainId' }
            ];

            var __dialogState = { entity: null, tplLoaded: false, historyLoaded: false, tplErrors: [] };

            function loadOneTemplate(c) {
                var params = { type: c.type };
                if (c.mt) params.maintenanceType = c.mt;
                return $.ajax({ url: URL_TPL_OPTS, type: 'GET', data: params, dataType: 'json' })
                    .then(function (res) {
                        var $sel = $('#facilityForm select[name="' + c.field + '"]');
                        if (!$sel.length) return;
                        var html = '<option value="">-- 请选择 --</option>';
                        if (ok(res) && Array.isArray(res.data)) {
                            res.data.forEach(function (it) {
                                html += '<option value="' + it.Id + '">' + (it.HNumber || '') + ' / ' + (it.HName || '') + '</option>';
                            });
                        }
                        $sel.html(html);
                    }, function (xhr) {
                        __dialogState.tplErrors.push(c.field + ': HTTP ' + (xhr && xhr.status));
                    });
            }

            function loadTemplatesForEntity(entity) {
                if (__dialogState.tplLoaded) return;
                __dialogState.tplLoaded = true;
                var $tip = $('#tplLoadingTip');
                $tip.text('正在加载模板...').css('color', '#888');
                var promises = TPL_CYCLES.map(function (c) { return loadOneTemplate(c); });
                $.when.apply($, promises).always(function () {
                    if (entity) {
                        TPL_CYCLES.forEach(function (c) {
                            var v = entity[c.field];
                            $('#facilityForm select[name="' + c.field + '"]').val(v == null ? '' : v);
                        });
                    }
                    try { form.render('select'); } catch (e) {}
                    try { form.render(); } catch (e) {}
                    if (__dialogState.tplErrors.length > 0) {
                        $tip.text('部分模板加载失败: ' + __dialogState.tplErrors.join('; ')).css('color', '#e53935');
                    } else {
                        $tip.text('模板加载完成').css('color', '#16a34a');
                        setTimeout(function () { $tip.fadeOut(); }, 1500);
                    }
                });
            }

            function bindDates() {
                $('#facilityForm input[lay-verify*=date]').each(function () { laydate.render({ type: 'date', elem: this }); });
                $('#facilityForm input[lay-verify*=datetime]').each(function () { laydate.render({ type: 'datetime', elem: this }); });
            }

            function openDialog(mode, row) {
                var isView = mode === 'view';
                var isEdit = mode === 'edit';
                var title = isView ? '设备台账查看' : (isEdit ? '设备台账编辑' : '设备台账新增');
                __dialogState = { entity: null, tplLoaded: false, historyLoaded: false };

                layer.open({
                    type: 1,
                    title: title,
                    area: ['92%', '88%'],
                    content: $('#tplFacilityForm').html(),
                    btn: isView ? ['关闭'] : ['保存', '取消'],
                    success: function () {
                        try { element.render('tab'); } catch (e) {}
                        try { bindDates(); } catch (e) {}
                        try { form.render(); } catch (e) {}
                        bindFacilityPickers(null);

                        // 模板下拉：立即开始异步加载（不等主数据）
                        loadTemplatesForEntity(null);

                        if (isEdit || isView) {
                            $.get(URL_GET, { Id: row.Id }, function (res) {
                                if (!ok(res) || !res.data) { toastErr(res && res.msg || '加载失败'); return; }
                                __dialogState.entity = res.data;
                                fillForm(res.data);
                                bindFacilityPickers(res.data);
                                if (isView) lockForm();
                                // 主数据到了，再次设置一遍模板下拉值（防止模板比主数据先到导致没选中）
                                TPL_CYCLES.forEach(function (c) {
                                    var v = res.data[c.field];
                                    $('#facilityForm select[name="' + c.field + '"]').val(v == null ? '' : v);
                                });
                                try { form.render('select'); } catch (e) {}
                                try { form.render(); } catch (e) {}
                                try { if (window.AttachmentWidget) AttachmentWidget.mount({ container: '#facilityAttachPanel', businessType: 'facility', businessId: row.Id, readonly: isView }); } catch (e) {}
                            }).fail(function () { toastErr('加载失败，请检查网络或服务'); });
                        } else {
                            fillForm({ Id: 0, Status: 0, KeyFlag: 0 });
                            $('#facilityAttachPanel').html('<div style="color:#999;padding:8px">保存后可上传附件</div>');
                        }

                        // 切到保养/点检记录 tab 时再加载历史
                        element.on('tab(resTabs)', function (data) {
                            if (data.index === 5 && !__dialogState.historyLoaded) {
                                __dialogState.historyLoaded = true;
                                bindHistoryTab(__dialogState.entity && __dialogState.entity.Id);
                            }
                        });
                    },
                    yes: function (idx) {
                        if (isView) { layer.close(idx); return; }
                        var data = collectForm();
                        if (!data) return;
                        $.post(URL_SAVE, data, function (res) {
                            if (ok(res)) {
                                layer.close(idx);
                                toastOk('保存成功');
                                loadData();
                            } else toastErr(res && res.msg || '保存失败');
                        });
                    }
                });
            }

            function fillForm(d) {
                if (!d) return;
                Object.keys(d).forEach(function (k) {
                    var v = d[k];
                    var $el = $('#facilityForm *[name="' + k + '"]');
                    if (!$el.length) return;
                    var ver = ($el.attr('lay-verify') || '');
                    if ($el.is('select')) {
                        $el.val(v == null ? '' : v);
                    } else if ($el.is('input') && ver.indexOf('date') >= 0) {
                        $el.val(v ? (v + '').replace('T', ' ').substring(0, 19) : '');
                    } else {
                        $el.val(v == null ? '' : v);
                    }
                });
                try { form.render(); } catch (e) {}
            }

            function lockForm() {
                $('#facilityForm input, #facilityForm select, #facilityForm textarea').attr('readonly', true).attr('disabled', true);
                form.render();
            }

            var INT_FIELDS = {
                ResourceId: 1, DeptId: 1, KeyFlag: 1, Type: 1, Status: 1, EntityId: 1,
                Voltage: 1, Weight: 1, Continuous_WorkTime: 1, RunTime: 1, ElectrifyTime: 1,
                Continuous_Qty: 1, MonthWeek: 1, CalibrationExpirationWarningDays: 1,
                The5STemplateMainId: 1, TheTemplateMainId: 1, MonthTempId: 1, SeasonTempId: 1,
                HalfYearTempId: 1, WeekTempId: 1, YearTempId: 1, MonthPlanDay: 1
            };

            function collectForm() {
                var data = {};
                var invalid = false;
                $('#facilityForm *[name]').each(function () {
                    var $el = $(this);
                    var name = $el.attr('name');
                    if (!name) return;
                    var v = $el.val();
                    if ($el.is('select') && v === '') v = null;
                    if (INT_FIELDS[name]) {
                        if (v === '' || v == null) {
                            data[name] = null;
                            return;
                        }
                        var n = parseInt(v, 10);
                        if (isNaN(n)) {
                            if (name === 'CalibrationExpirationWarningDays') {
                                toastErr('过期预警天数必须为整数');
                                invalid = true;
                            } else {
                                data[name] = null;
                            }
                            return;
                        }
                        data[name] = n;
                        return;
                    }
                    data[name] = v;
                });
                return invalid ? null : data;
            }

            function bindHistoryTab(facilityId) {
                var statusMap = { 0:'新建', 1:'已派工', 2:'保养中', 3:'已保养', 4:'已审核' };
                var historyCols = [[
                    { field: 'BillNo', title: '单号', width: 160 },
                    { field: 'BillDate', title: '日期', width: 110, templet: function(d){ return fmtDate(d.BillDate); } },
                    { field: 'BeginDate', title: '开始时间', width: 160, templet: function(d){ return fmtDt(d.BeginDate); } },
                    { field: 'EndDate', title: '结束时间', width: 160, templet: function(d){ return fmtDt(d.EndDate); } },
                    { field: 'MaintainType', title: '保养类型', width: 100 },
                    { field: 'Status', title: '状态', width: 90, templet: function(d){ return statusMap[d.Status] || (d.Status||''); } },
                    { field: 'RepairStaff', title: '保养人', width: 110 },
                    { field: 'Checker', title: '审核人', width: 110 },
                    { field: 'CheckDate', title: '审核日期', width: 160, templet: function(d){ return fmtDt(d.CheckDate); } },
                    { field: 'Remark', title: '备注', minWidth: 160 }
                ]];
                if (!facilityId) {
                    table.render({ elem: '#GridMaintHist', data: [], page: false, height: 360, cols: historyCols });
                    table.render({ elem: '#GridCheckHist', data: [], page: false, height: 360, cols: historyCols });
                    return;
                }
                $.get(URL_HISTORY, { facilityId: facilityId, billType: 'MAINTENANCE' }, function (res) {
                    table.render({ elem: '#GridMaintHist', data: ok(res) ? (res.data || []) : [], page: false, height: 360, cols: historyCols });
                });
                $.get(URL_HISTORY, { facilityId: facilityId, billType: 'INSPECTION' }, function (res) {
                    table.render({ elem: '#GridCheckHist', data: ok(res) ? (res.data || []) : [], page: false, height: 360, cols: historyCols });
                });
            }

            // -------------- 事件 --------------
            $('#btnAdd').on('click', function () { openDialog('add'); });
            $('#btnReload').on('click', function () { loadData(); });
            $('#kw').on('keydown', function (e) { if (e.keyCode === 13) $('#btnReload').click(); });
            // form.render select 后的回调，需用 form.on（前端模式：重新拉取数据）
            form.on('select(fltDept)', function(){ loadData(); });
            form.on('select(fltStatus)', function(){ loadData(); });

            // 导出当前“筛选后/排序后/列顺序”的表格（前端导出，所见即所得）
            $('#btnExport').on('click', function () { SoulGrid.export('GridMain'); });

            $('#btnImportTpl').on('click', function () { window.location.href = URL_IMPORT_TPL; });

            upload.render({
                elem: '#btnImport', url: URL_IMPORT, auto: true, accept: 'file',
                exts: 'xls|xlsx|csv', field: 'file',
                before: function () { layer.load(2); },
                done: function (res) {
                    layer.closeAll('loading');
                    if (!ok(res)) { toastErr((res && res.msg) || '导入失败'); return; }
                    var d = res.data || {};
                    var errs = (d.errors || []).join('<br>');
                    layer.open({
                        type: 1, title: '导入结果', area: ['560px', 'auto'],
                        content: '<div style="padding:14px;">总数 ' + (d.Total || 0) + '，成功 <b style="color:#16a34a;">' + (d.Success || 0) + '</b>，失败 <b style="color:#dc2626;">' + (d.Fail || 0) + '</b>，跳过 ' + (d.Skip || 0) + '<hr>' + (errs || '无错误') + '</div>'
                    });
                    loadData();
                },
                error: function () { layer.closeAll('loading'); toastErr('上传出错'); }
            });

            table.on('tool(GridMain)', function (obj) {
                if (obj.event === 'view') openDialog('view', obj.data);
                if (obj.event === 'edit') openDialog('edit', obj.data);
                if (obj.event === 'repair') openRepairHistory(obj.data);
                if (obj.event === 'del') {
                    layer.confirm('确认删除该设备台账？', function (idx) {
                        $.post(URL_DELETE, { Id: obj.data.Id }, function (res) {
                            layer.close(idx);
                            if (ok(res)) { obj.del(); toastOk('删除成功'); }
                            else toastErr(res && res.msg || '删除失败');
                        });
                    });
                }
            });

            loadDepts().always(renderList);
        });
    </script>
}
