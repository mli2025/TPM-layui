@{
    Layout = "_LayoutMobile";
}
<div class="p-3">
    <div class="flex gap-2 mb-2" x-data="{ s: new URL(location.href).searchParams.get('status') || '' }">
        <a class="m-btn flex-1" :class="s===''  ? 'primary' : ''" href="/m/repair">全部</a>
        <a class="m-btn flex-1" :class="s==='0' ? 'primary' : ''" href="/m/repair?status=0">新建</a>
        <a class="m-btn flex-1" :class="s==='1' ? 'primary' : ''" href="/m/repair?status=1">待接单</a>
        <a class="m-btn flex-1" :class="s==='2' ? 'primary' : ''" href="/m/repair?status=2">维修中</a>
        <a class="m-btn flex-1" :class="s==='3' ? 'primary' : ''" href="/m/repair?status=3">已完成</a>
    </div>
    <input class="m-input mb-2" id="kw" placeholder="单号 / 故障部件 / 备注 搜索" />
    <div id="list" class="m-list">
        <div class="text-center text-slate-400 text-xs py-6">加载中...</div>
    </div>
</div>

<a href="/m/repair/create" class="m-fab">
    <i data-lucide="plus"></i>
</a>

@section Script {
<script>
(function(){
    var url = new URL(location.href);
    var status = url.searchParams.get('status') || '';
    var mine = url.searchParams.get('mine') || '';
    function statusBadge(s){
        var map = { 0:'新建',1:'待接单',2:'维修中',3:'已完成',4:'已审核',5:'已关闭' };
        var cls = { 0:'new',1:'dispatch',2:'doing',3:'done',4:'audited',5:'closed' };
        var k = s == null ? 0 : s;
        return '<span class="m-badge ' + (cls[k]||'') + '">' + (map[k]||k) + '</span>';
    }
    function fmt(s){ return s ? String(s).substring(0,16).replace('T',' ') : ''; }
    function load(){
        var kw = document.getElementById('kw').value.trim();
        M.ajax({ url:'/m/api/repair?status=' + encodeURIComponent(status) + '&kw=' + encodeURIComponent(kw) + '&mine=' + encodeURIComponent(mine), contentType:false })
            .then(function(res){
                if (!M.ok(res)){ document.getElementById('list').innerHTML = '<div class="text-center text-red-500 text-xs py-6">' + (res.msg||'加载失败') + '</div>'; return; }
                var arr = res.data || [];
                if (!arr.length){ document.getElementById('list').innerHTML = '<div class="text-center text-slate-400 text-xs py-6">暂无数据</div>'; return; }
                document.getElementById('list').innerHTML = arr.map(function(b){
                    return '<a class="m-list-item" href="/m/repair/detail?id=' + b.Id + '">'
                        + '<div class="flex-1 min-w-0">'
                        + '<div class="flex items-center gap-2"><span class="font-medium truncate">' + (b.BillNo||'-') + '</span>' + statusBadge(b.Status) + '</div>'
                        + '<div class="text-xs text-slate-500 mt-1 truncate">设备: ' + (b.FacilityId||'-') + (b.FaultLocation ? ' · ' + b.FaultLocation : '') + '</div>'
                        + '<div class="text-xs text-slate-400 mt-1 truncate">报修人: ' + (b.Maker||'-') + ' · ' + fmt(b.BillDate) + '</div>'
                        + '</div>'
                        + '<i data-lucide="chevron-right" class="w-4 h-4 text-slate-300 mt-1"></i>'
                        + '</a>';
                }).join('');
                if (window.lucide) lucide.createIcons();
            });
    }
    document.getElementById('kw').addEventListener('keyup', function(e){ if (e.key === 'Enter') load(); });
    load();
})();
</script>
}
