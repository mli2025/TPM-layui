@{
    Layout = "_LayoutMobile";
    var id = (long)ViewBag.Id;
}
<div class="p-3 space-y-3" id="root" data-id="@id">
    <div class="m-card p-3">
        <div class="text-xs text-slate-500">报修单号</div>
        <div id="billNo" class="text-base font-medium mt-1">-</div>
        <div class="grid grid-cols-2 gap-3 mt-2 text-xs">
            <div><span class="text-slate-400">报修人:</span> <span id="maker">-</span></div>
            <div><span class="text-slate-400">报修时间:</span> <span id="billDate">-</span></div>
            <div><span class="text-slate-400">设备:</span> <span id="facility">-</span></div>
            <div><span class="text-slate-400">状态:</span> <span id="status">-</span></div>
            <div><span class="text-slate-400">故障部件:</span> <span id="loc">-</span></div>
            <div><span class="text-slate-400">故障类别:</span> <span id="cat">-</span></div>
            <div><span class="text-slate-400">维修人员:</span> <span id="staff">-</span></div>
            <div><span class="text-slate-400">派单时间:</span> <span id="dispDate">-</span></div>
        </div>
    </div>

    <div class="m-card p-3" id="descrCard">
        <div class="text-xs text-slate-500">故障描述</div>
        <div id="descr" class="text-sm mt-1">-</div>
    </div>

    <div class="m-card p-3 hidden" id="cardFinish">
        <div class="text-xs text-slate-500 font-medium">维修登记</div>
        <label class="text-xs text-slate-500 mt-2 block"><span style="color:#ff5722;">*</span> 维修描述</label>
        <textarea id="rDescr" class="m-textarea mt-1" rows="2" placeholder="必填，请填写维修描述"></textarea>
        <label class="text-xs text-slate-500 mt-2 block">原因分析</label>
        <textarea id="rFa" class="m-textarea mt-1" rows="2"></textarea>
        <label class="text-xs text-slate-500 mt-2 block">预防措施</label>
        <textarea id="rPm" class="m-textarea mt-1" rows="2"></textarea>
        <label class="text-xs text-slate-500 mt-2 block">备注</label>
        <textarea id="rRk" class="m-textarea mt-1" rows="2"></textarea>
    </div>

    <div class="m-card p-3 hidden" id="cardConfirm">
        <div class="text-xs text-slate-500 font-medium">三方确认</div>
        <div class="grid grid-cols-3 gap-2 mt-2">
            <button class="m-btn" id="cfmEq">设备确认</button>
            <button class="m-btn" id="cfmPr">生产确认</button>
            <button class="m-btn" id="cfmQa">质量确认</button>
        </div>
        <div class="text-xs text-slate-500 mt-2" id="cfmInfo"></div>
    </div>

    <div class="space-y-2" id="actions"></div>
</div>

@section Script {
<script>
(function(){
    var id = parseInt(document.getElementById('root').dataset.id, 10);
    var statusMap = { 0:'新建',1:'待接单',2:'维修中',3:'已完成',4:'已审核',5:'已关闭' };
    function fmt(s){ return s ? String(s).substring(0,16).replace('T',' ') : ''; }
    var current = null;

    function load(){
        M.ajax({ url:'/m/api/repair/detail?id=' + id, contentType:false }).then(function(res){
            if (!M.ok(res)){ M.toast(res.msg||'加载失败','err'); return; }
            current = res.data;
            var m = current.Main || {}, subs = current.Subs || [];
            document.getElementById('billNo').textContent = m.BillNo || '-';
            document.getElementById('maker').textContent = m.Maker || '-';
            document.getElementById('billDate').textContent = fmt(m.BillDate);
            document.getElementById('facility').textContent = m.FacilityId || '-';
            document.getElementById('status').textContent = statusMap[m.Status==null?0:m.Status] || m.Status || '-';
            document.getElementById('loc').textContent = m.FaultLocation || '-';
            document.getElementById('cat').textContent = m.FaultCategory || '-';
            document.getElementById('staff').textContent = m.RepairStaff || '-';
            document.getElementById('dispDate').textContent = fmt(m.DispatchDate);
            document.getElementById('descr').textContent = (m.Descr || (subs[0] && subs[0].Descr) || '-');

            var s = m.Status == null ? 0 : m.Status;
            var btns = '';
            // 维修人员视角：派工(1) -> 接单(即开始维修) -> 登记完成
            if (s === 1) btns += '<button class="m-btn primary w-full" data-act="accept">接单 / 开始维修</button>';
            if (s === 2) {
                document.getElementById('cardFinish').classList.remove('hidden');
                var first = subs[0] || {};
                document.getElementById('rDescr').value = first.Descr || '';
                document.getElementById('rFa').value = first.FaultAnalysis || '';
                document.getElementById('rPm').value = first.PreventiveMeasure || '';
                document.getElementById('rRk').value = first.Remark || '';
                btns += '<button class="m-btn primary w-full" data-act="finish">登记完成</button>';
            }
            if (s === 3) {
                document.getElementById('cardConfirm').classList.remove('hidden');
                var info = '设备: ' + (m.EquipmentComfirm || '未确认')
                         + ' · 生产: ' + (m.ProduceComfirm || '未确认')
                         + ' · 质量: ' + (m.QualityComfirm || '未确认');
                document.getElementById('cfmInfo').textContent = info;
            }
            document.getElementById('actions').innerHTML = btns;
            Array.prototype.forEach.call(document.querySelectorAll('#actions [data-act]'), function(b){
                b.addEventListener('click', onAct);
            });
        });
    }

    function postForm(url, data){
        var f = new FormData(); Object.keys(data).forEach(function(k){ f.append(k, data[k]); });
        return M.ajax({ url:url, method:'POST', data:f, contentType:false });
    }

    function onAct(e){
        var act = e.currentTarget.dataset.act;
        if (act === 'accept') {
            postForm('/m/api/repair/accept', { id:id }).then(function(r){ if (M.ok(r)){ M.toast('已接单，开始维修'); load(); } else M.toast(r.msg||'失败','err'); });
        } else if (act === 'finish') {
            if (!(rDescr.value || '').trim()){ M.toast('请填写维修描述','err'); rDescr.focus(); return; }
            var p = { Id:id, RepairDescr: rDescr.value, FaultAnalysis: rFa.value, PreventiveMeasure: rPm.value, Remark: rRk.value };
            M.ajax({ url:'/m/api/repair/finish', method:'POST', data: JSON.stringify(p), contentType:'application/json' })
                .then(function(r){ if (M.ok(r)){ M.toast('已登记完成'); load(); } else M.toast(r.msg||'失败','err'); });
        }
    }

    document.getElementById('cfmEq').addEventListener('click', function(){
        postForm('/m/api/repair/confirm', { id:id, role:'equipment' }).then(function(r){ if (M.ok(r)){ M.toast('已设备确认'); load(); } else M.toast(r.msg||'失败','err'); });
    });
    document.getElementById('cfmPr').addEventListener('click', function(){
        postForm('/m/api/repair/confirm', { id:id, role:'produce' }).then(function(r){ if (M.ok(r)){ M.toast('已生产确认'); load(); } else M.toast(r.msg||'失败','err'); });
    });
    document.getElementById('cfmQa').addEventListener('click', function(){
        postForm('/m/api/repair/confirm', { id:id, role:'quality' }).then(function(r){ if (M.ok(r)){ M.toast('已质量确认'); load(); } else M.toast(r.msg||'失败','err'); });
    });
    var rDescr = document.getElementById('rDescr'), rFa = document.getElementById('rFa'), rPm = document.getElementById('rPm'), rRk = document.getElementById('rRk');
    load();
})();
</script>
}
