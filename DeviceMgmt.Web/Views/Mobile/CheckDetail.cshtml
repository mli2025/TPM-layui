@{
    Layout = "_LayoutMobile";
    var id = (long)ViewBag.Id;
}
<div class="p-3 space-y-3" id="root" data-id="@id">
    <div class="m-card p-3">
        <div class="text-xs text-slate-500">点检执行单</div>
        <div id="billNo" class="text-base font-medium mt-1">-</div>
        <div class="grid grid-cols-2 gap-3 mt-2 text-xs">
            <div><span class="text-slate-400">设备:</span> <span id="facility">-</span></div>
            <div><span class="text-slate-400">执行人:</span> <span id="executor">-</span></div>
            <div class="col-span-2"><span class="text-slate-400">计划/执行时间:</span> <span id="execTime">-</span></div>
        </div>
    </div>
    <div>
        <div class="m-section-title">点检项</div>
        <div id="subs" class="space-y-2">
            <div class="text-center text-slate-400 text-xs py-4">加载中...</div>
        </div>
    </div>

    <div class="m-card p-3" id="editPanel">
        <label class="text-xs text-slate-500 mt-3 block">整体备注</label>
        <textarea id="remark" class="m-textarea mt-1" rows="2"></textarea>
        <button class="m-btn primary w-full mt-3" id="btnSubmit">提交点检执行单</button>
    </div>
    <div class="m-card p-3 hidden" id="viewPanel">
        <div class="text-xs text-slate-500">整体结论</div>
        <div id="resultText" class="text-sm font-medium mt-1">-</div>
        <div class="text-xs text-slate-500 mt-2">备注</div>
        <div id="viewRemark" class="text-sm mt-1">-</div>
    </div>
</div>

@section Script {
<script>
(function(){
    var recordId = parseInt(document.getElementById('root').dataset.id, 10) || 0;
    var mainData = null;
    var readOnly = false;

    function fmt(s){ return s ? String(s).substring(0,16).replace('T',' ') : ''; }

    function esc(s){ return (s==null?'':String(s)).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];}); }
    function rangeText(s){
        if (Number(s.ControlType) === 1){
            var hasMin = s.MinValue != null, hasMax = s.MaxValue != null;
            if (hasMin && hasMax) return '合格范围: ' + s.MinValue + ' ~ ' + s.MaxValue;
            if (hasMax) return '合格: ≤ ' + s.MaxValue;
            if (hasMin) return '合格: ≥ ' + s.MinValue;
            return '数值型';
        }
        return '是否型（选「是」为合格）';
    }

    function renderSubs(subs, editable){
        if (!subs.length){
            document.getElementById('subs').innerHTML = '<div class="m-card p-3 text-xs text-slate-400 text-center">无点检项</div>';
            return;
        }
        document.getElementById('subs').innerHTML = subs.map(function(s, idx){
            var name = esc(s.ItemName || '-');
            var method = esc(s.Method || '');
            var std = esc(s.Standard || '');
            var ct = Number(s.ControlType) === 1 ? 1 : 0;
            if (editable){
                var input = (ct === 1)
                    ? '<input class="m-input mt-1 s-val" inputmode="decimal" placeholder="请输入实测数值" value="' + esc(s.ResultValue||'') + '" />'
                    : '<select class="m-input mt-1 s-val"><option value="">请选择</option><option value="是"' + (s.ResultValue==='是'?' selected':'') + '>是</option><option value="否"' + (s.ResultValue==='否'?' selected':'') + '>否</option></select>';
                return '<div class="m-card p-3" data-idx="' + idx + '" data-ct="' + ct + '" data-name="' + name + '"'
                    + ' data-min="' + (s.MinValue==null?'':s.MinValue) + '" data-max="' + (s.MaxValue==null?'':s.MaxValue) + '"'
                    + ' data-method="' + method + '" data-standard="' + std + '">'
                    + '<div class="text-sm font-medium">' + name + '</div>'
                    + (method ? '<div class="text-xs text-slate-500 mt-1">方法: ' + method + '</div>' : '')
                    + (std ? '<div class="text-xs text-slate-500">标准: ' + std + '</div>' : '')
                    + '<div class="text-xs text-emerald-600 mt-1">' + rangeText(s) + '</div>'
                    + '<label class="text-xs text-slate-500 mt-2 block">实测值</label>'
                    + input
                    + '<label class="text-xs text-slate-500 mt-2 block">备注</label>'
                    + '<input class="m-input mt-1 s-remark" value="' + esc(s.Remark||'') + '" />'
                    + '</div>';
            }
            var badge = (s.IsNormal === false) ? '<span class="m-badge danger">异常</span>' : '<span class="m-badge done">合格</span>';
            return '<div class="m-card p-3">'
                + '<div class="flex items-center gap-2"><span class="text-sm font-medium">' + name + '</span>' + badge + '</div>'
                + '<div class="text-xs text-slate-500 mt-1">实测: ' + esc(s.ResultValue||'-') + '</div>'
                + (s.Remark ? '<div class="text-xs text-slate-500 mt-1">备注: ' + esc(s.Remark) + '</div>' : '')
                + '</div>';
        }).join('');
    }

    function load(){
        M.ajax({ url:'/m/api/check/detail?id=' + recordId, contentType:false }).then(function(res){
            if (!M.ok(res)){ M.toast(res.msg||'加载失败','err'); return; }
            var d = res.data || {};
            mainData = d.main || {};
            readOnly = !!d.readOnly;

            document.getElementById('billNo').textContent = mainData.RecordNo || '-';
            document.getElementById('facility').textContent = (mainData.FacilityName || mainData.FacilityId || '-') + (mainData.Shift ? ' · ' + mainData.Shift : '');
            document.getElementById('executor').textContent = mainData.Executor || '-';
            document.getElementById('execTime').textContent = fmt(mainData.ExecTime || mainData.PlanDate);
            document.getElementById('remark').value = mainData.Remark || '';

            renderSubs(d.subs || [], !readOnly);
            document.getElementById('editPanel').classList.toggle('hidden', readOnly);
            document.getElementById('viewPanel').classList.toggle('hidden', !readOnly);
            if (readOnly){
                document.getElementById('resultText').textContent = (mainData.Result === 1) ? '异常' : '正常';
                document.getElementById('viewRemark').textContent = mainData.Remark || '-';
            }
        });
    }

    document.getElementById('btnSubmit').addEventListener('click', function(){
        if (readOnly) return;
        var cards = document.querySelectorAll('#subs .m-card[data-idx]');
        var missing = false;
        var items = Array.prototype.map.call(cards, function(card){
            var val = (card.querySelector('.s-val').value || '').trim();
            if (val === '') missing = true;
            var ct = Number(card.dataset.ct) === 1 ? 1 : 0;
            return {
                ItemName: card.dataset.name || '',
                Method: card.dataset.method || '',
                Standard: card.dataset.standard || '',
                ControlType: ct,
                MinValue: card.dataset.min === '' ? null : Number(card.dataset.min),
                MaxValue: card.dataset.max === '' ? null : Number(card.dataset.max),
                ResultValue: val,
                Remark: card.querySelector('.s-remark').value
            };
        });
        if (missing){ M.toast('请填写所有点检项的实测值','err'); return; }
        var payload = {
            Main: { Id: mainData.Id || recordId, PlanId: mainData.PlanId || null, FacilityId: mainData.FacilityId || null, Remark: document.getElementById('remark').value },
            Items: items
        };
        M.ajax({ url:'/m/api/check/submit', method:'POST', data: JSON.stringify(payload), contentType:'application/json' }).then(function(res){
            if (M.ok(res)){ M.toast('点检执行单已提交'); setTimeout(function(){ history.back(); }, 800); }
            else M.toast(res.msg||'提交失败','err');
        });
    });
    load();
})();
</script>
}
