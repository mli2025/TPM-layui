@{
    Layout = "_LayoutMobile";
}
<div class="p-3">
    <div class="flex gap-2 mb-2" x-data="{ s: new URL(location.href).searchParams.get('status') || '' }">
        <a class="m-btn flex-1" :class="s===''  ? 'primary' : ''" href="/m/check">全部</a>
        <a class="m-btn flex-1" :class="s==='0' ? 'primary' : ''" href="/m/check?status=0">待执行</a>
        <a class="m-btn flex-1" :class="s==='3' ? 'primary' : ''" href="/m/check?status=3">已完成</a>
    </div>
    <input class="m-input mb-2" id="kw" placeholder="单号 / 执行人 搜索" />
    <div id="list" class="m-list">
        <div class="text-center text-slate-400 text-xs py-6">加载中...</div>
    </div>
</div>

@section Script {
<script>
(function(){
    var status = new URL(location.href).searchParams.get('status') || '';
    function statusBadge(s){
        if (s === 0 || s === '0') return '<span class="m-badge new">待执行</span>';
        if (s === 3 || s === '3') return '<span class="m-badge done">已完成</span>';
        return '<span class="m-badge">' + (s == null ? '-' : s) + '</span>';
    }
    function fmt(s){ return s ? String(s).substring(0,16).replace('T',' ') : ''; }
    function load(){
        var kw = document.getElementById('kw').value.trim();
        M.ajax({ url: '/m/api/check?status=' + encodeURIComponent(status) + '&kw=' + encodeURIComponent(kw), contentType:false })
            .then(function(res){
                if (!M.ok(res)){ document.getElementById('list').innerHTML = '<div class="text-center text-red-500 text-xs py-6">' + (res.msg||'加载失败') + '</div>'; return; }
                var arr = res.data || [];
                if (!arr.length){ document.getElementById('list').innerHTML = '<div class="text-center text-slate-400 text-xs py-6">暂无点检执行单</div>'; return; }
                document.getElementById('list').innerHTML = arr.map(function(b){
                    var href = '/m/check/detail?id=' + b.Id;
                    var no = b.BillNo || ('#' + b.Id);
                    var dev = b.FacilityName || b.FacilityID || '-';
                    return '<a class="m-list-item" href="' + href + '">'
                        + '<div class="flex-1 min-w-0">'
                        + '<div class="flex items-center gap-2"><span class="font-medium truncate">' + no + '</span>' + statusBadge(b.Status) + '</div>'
                        + '<div class="text-xs text-slate-500 mt-1 truncate">设备: ' + dev + ' · ' + fmt(b.BeginDate) + (b.Executor ? ' · ' + b.Executor : '') + '</div>'
                        + '</div>'
                        + '<i data-lucide="chevron-right" class="w-4 h-4 text-slate-300 mt-1"></i>'
                        + '</a>';
                }).join('');
                if (window.lucide) lucide.createIcons();
            });
    }
    document.getElementById('kw').addEventListener('keyup', function(e){ if (e.key === 'Enter') load(); });
    load();
})();
</script>
}
