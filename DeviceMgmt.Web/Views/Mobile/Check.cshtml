@{
    Layout = "_LayoutMobile";
}
<div class="p-3">
    <div class="flex gap-2 mb-2" x-data="{ s: new URL(location.href).searchParams.get('status') || '' }">
        <a class="m-btn flex-1" :class="s===''  ? 'primary' : ''" href="/m/check">全部</a>
        <a class="m-btn flex-1" :class="s==='0' ? 'primary' : ''" href="/m/check?status=0">待执行</a>
        <a class="m-btn flex-1" :class="s==='3' ? 'primary' : ''" href="/m/check?status=3">已完成</a>
    </div>
    <div class="flex gap-2 mb-2">
        <input class="m-input flex-1" id="kw" placeholder="单号 / 设备 / 执行人 搜索" />
        <button class="m-btn primary px-3" id="btnScan" type="button"><i data-lucide="scan-line" class="w-4 h-4 inline-block align-text-bottom"></i> 扫码</button>
    </div>
    <div id="codeTip" class="hidden mb-2 text-xs flex items-center justify-between bg-emerald-50 text-emerald-700 rounded px-2 py-1">
        <span>按设备筛选：<b id="codeVal"></b></span>
        <a href="javascript:;" id="codeClear" class="text-emerald-700 underline">清除</a>
    </div>
    <div id="list" class="m-list">
        <div class="text-center text-slate-400 text-xs py-6">加载中...</div>
    </div>
</div>

@section Script {
<script>
(function(){
    var status = new URL(location.href).searchParams.get('status') || '';
    var codeFilter = '';
    function statusBadge(s){
        if (s === 0 || s === '0') return '<span class="m-badge new">待执行</span>';
        if (s === 3 || s === '3') return '<span class="m-badge done">已完成</span>';
        return '<span class="m-badge">' + (s == null ? '-' : s) + '</span>';
    }
    function fmt(s){ return s ? String(s).substring(0,16).replace('T',' ') : ''; }
    function esc(s){ return (s==null?'':String(s)).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];}); }
    var LIMIT = 20, page = 1, loading = false, noMore = false;
    var lazy = (status === '3'); // 已完成：分页懒加载
    function itemHtml(b){
        var href = '/m/check/detail?id=' + b.Id;
        var no = b.BillNo || ('#' + b.Id);
        var dev = esc(b.FacilityName || b.FacilityID || '-');
        var shift = b.Shift ? ' · ' + esc(b.Shift) : '';
        var overdue = b.Overdue ? '<span class="m-badge danger">漏检</span>' : '';
        return '<a class="m-list-item" href="' + href + '">'
            + '<div class="flex-1 min-w-0">'
            + '<div class="flex items-center gap-2"><span class="font-medium truncate">' + esc(no) + '</span>' + statusBadge(b.Status) + overdue + '</div>'
            + '<div class="text-xs text-slate-500 mt-1 truncate">设备: ' + dev + shift + ' · ' + fmt(b.BeginDate) + (b.Executor ? ' · ' + esc(b.Executor) : '') + '</div>'
            + '</div>'
            + '<i data-lucide="chevron-right" class="w-4 h-4 text-slate-300 mt-1"></i>'
            + '</a>';
    }
    function load(reset){
        if (loading) return;
        if (reset){ page = 1; noMore = false; document.getElementById('list').innerHTML = '<div class="text-center text-slate-400 text-xs py-6">加载中...</div>'; }
        if (noMore) return;
        loading = true;
        var kw = document.getElementById('kw').value.trim();
        var url = '/m/api/check?status=' + encodeURIComponent(status) + '&kw=' + encodeURIComponent(kw);
        if (codeFilter) url += '&code=' + encodeURIComponent(codeFilter);
        if (lazy) url += '&page=' + page + '&limit=' + LIMIT;
        M.ajax({ url: url, contentType:false })
            .then(function(res){
                loading = false;
                var listEl = document.getElementById('list');
                if (!M.ok(res)){ listEl.innerHTML = '<div class="text-center text-red-500 text-xs py-6">' + (res.msg||'加载失败') + '</div>'; return; }
                var arr = res.data || [];
                if (page === 1 && !arr.length){ listEl.innerHTML = '<div class="text-center text-slate-400 text-xs py-6">暂无点检执行单</div>'; return; }
                var html = arr.map(itemHtml).join('');
                if (page === 1) listEl.innerHTML = html; else { var more = document.getElementById('loadMore'); if (more) more.remove(); listEl.insertAdjacentHTML('beforeend', html); }
                if (lazy){
                    if (arr.length < LIMIT) noMore = true; else { page++; listEl.insertAdjacentHTML('beforeend', '<div id="loadMore" class="text-center py-3"><button type="button" class="m-btn" onclick="window.__loadMore&&window.__loadMore()">加载更多</button></div>'); }
                }
                if (window.lucide) lucide.createIcons();
            });
    }
    window.__loadMore = function(){ load(false); };
    function setCode(code){
        codeFilter = (code || '').trim();
        var tip = document.getElementById('codeTip');
        if (codeFilter){ document.getElementById('codeVal').textContent = codeFilter; tip.classList.remove('hidden'); }
        else tip.classList.add('hidden');
        load(true);
    }
    document.getElementById('kw').addEventListener('keyup', function(e){ if (e.key === 'Enter') load(true); });
    document.getElementById('codeClear').addEventListener('click', function(){ setCode(''); });
    document.getElementById('btnScan').addEventListener('click', function(){
        if (window.ArboreShell && window.ArboreShell.scan){
            window.ArboreShell.scan({ onWebFallback: function(){ return Promise.resolve(window.prompt('请输入设备编码') || ''); } })
                .then(function(code){ if (code) setCode(code); })
                .catch(function(err){ var msg = err && err.message; if (msg && msg !== 'CANCELLED' && msg !== 'NO_BRIDGE') M.toast('扫码失败: ' + msg, 'err'); else if (msg === 'NO_BRIDGE'){ var c = window.prompt('请输入设备编码'); if (c) setCode(c); } });
        } else { var c = window.prompt('请输入设备编码'); if (c) setCode(c); }
    });
    load(true);
})();
</script>
}
