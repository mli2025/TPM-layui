@{
    ViewData["Title"] = "妯″叿璧勬枡 Basic_Mold - 鏌ョ湅";
    var id = (long)(ViewBag.Id ?? 0L);
}
<div class="layui-fluid" style="padding:14px;">
    <div class="layui-card">
        <div class="layui-card-header"><b>妯″叿璧勬枡 Basic_Mold</b> &nbsp;<span style="color:#999;font-size:12px;">Id = @id</span></div>
        <div class="layui-card-body">
            <form id="viewFormMain" class="layui-form layui-form-pane">
                <div class="layui-row layui-col-space10">
                    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>Id</label><div class='layui-input-block'><input type='text' name='Id' class='layui-input' readonly /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>Name</label><div class='layui-input-block'><input type='text' name='Name' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>Code</label><div class='layui-input-block'><input type='text' name='Code' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>Model</label><div class='layui-input-block'><input type='text' name='Model' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>MoldType</label><div class='layui-input-block'><input type='text' name='MoldType' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>ConnectFacilityType</label><div class='layui-input-block'><input type='text' name='ConnectFacilityType' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>WarehouseId</label><div class='layui-input-block'><input type='text' name='WarehouseId' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>WareAreaId</label><div class='layui-input-block'><input type='text' name='WareAreaId' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>WareArea</label><div class='layui-input-block'><input type='text' name='WareArea' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>SupplierId</label><div class='layui-input-block'><input type='text' name='SupplierId' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>Remark</label><div class='layui-input-block'><input type='text' name='Remark' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>MaxUseQty</label><div class='layui-input-block'><input type='text' name='MaxUseQty' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>MaxUseDay</label><div class='layui-input-block'><input type='text' name='MaxUseDay' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>AlarmQty</label><div class='layui-input-block'><input type='text' name='AlarmQty' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>AlarmDay</label><div class='layui-input-block'><input type='text' name='AlarmDay' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>TotalUseQty</label><div class='layui-input-block'><input type='text' name='TotalUseQty' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>LastRepairTime</label><div class='layui-input-block'><input type='text' name='LastRepairTime' class='layui-input' lay-verify='datetime' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>LastRepairUserId</label><div class='layui-input-block'><input type='text' name='LastRepairUserId' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>FacilityId</label><div class='layui-input-block'><input type='text' name='FacilityId' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>ResourceId</label><div class='layui-input-block'><input type='text' name='ResourceId' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>NowUseQty</label><div class='layui-input-block'><input type='text' name='NowUseQty' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>Status</label><div class='layui-input-block'><input type='text' name='Status' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>TheQtyTemplateMainId</label><div class='layui-input-block'><input type='text' name='TheQtyTemplateMainId' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>TheDayTemplateMainId</label><div class='layui-input-block'><input type='text' name='TheDayTemplateMainId' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>QiangXueQty</label><div class='layui-input-block'><input type='text' name='QiangXueQty' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>Type</label><div class='layui-input-block'><input type='text' name='Type' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>GWThickness</label><div class='layui-input-block'><input type='text' name='GWThickness' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>ThickenedFlag</label><div class='layui-input-block'><input type='text' name='ThickenedFlag' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>StockQty</label><div class='layui-input-block'><input type='text' name='StockQty' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>MoldQty</label><div class='layui-input-block'><input type='text' name='MoldQty' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>SpotCheckFlag</label><div class='layui-input-block'><input type='text' name='SpotCheckFlag' class='layui-input' /></div></div></div>
                </div>
            </form>
        </div>
    </div>
</div>
@section Script{
    <script>
        layui.use(['form','laydate'], function () {
            var form = layui.form, laydate = layui.laydate;
            $('input[lay-verify*=datetime]').each(function () { laydate.render({ type: 'datetime', elem: this }); });
            $.get('@Url.Action("GetMainInfo")', { Id: @id }, function (res) {
                if (res && res.data) {
                    for (var k in res.data) {
                        $("#viewFormMain *[name='" + k + "']").val(res.data[k]);
                    }
                    $("#viewFormMain input, #viewFormMain textarea, #viewFormMain select").attr('readonly', 'readonly').attr('disabled', 'disabled');
                    form.render();
                }
            });
        });
    </script>
}