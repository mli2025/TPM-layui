@{
    ViewData["Title"] = "保养工单查看";
    var id = (long)(ViewBag.Id ?? 0L);
}
<div class="layui-fluid" style="padding:14px;">
    <div class="layui-card">
        <div class="layui-card-header"><strong>保养工单</strong> <span style="color:#999;font-size:12px;">Id = @id</span></div>
        <div class="layui-card-body">
            <form class="layui-form layui-form-pane" lay-filter="billViewForm">
                <div class="layui-row layui-col-space10">
                    <div class="layui-col-md6">
                        <div class="layui-form-item">
                            <label class="layui-form-label">单据编号</label>
                            <div class="layui-input-block"><input type="text" name="BillNo" class="layui-input" readonly></div>
                        </div>
                    </div>
                    <div class="layui-col-md6">
                        <div class="layui-form-item">
                            <label class="layui-form-label">单据日期</label>
                            <div class="layui-input-block"><input type="text" name="BillDate" class="layui-input" readonly></div>
                        </div>
                    </div>
                    <div class="layui-col-md6">
                        <div class="layui-form-item">
                            <label class="layui-form-label">单据类型</label>
                            <div class="layui-input-block"><input type="text" name="BillType" class="layui-input" readonly></div>
                        </div>
                    </div>
                    <div class="layui-col-md6">
                        <div class="layui-form-item">
                            <label class="layui-form-label">状态</label>
                            <div class="layui-input-block"><input type="text" name="StatusText" class="layui-input" readonly></div>
                        </div>
                    </div>
                    <div class="layui-col-md6">
                        <div class="layui-form-item">
                            <label class="layui-form-label">开始时间</label>
                            <div class="layui-input-block"><input type="text" name="BeginDate" class="layui-input" readonly></div>
                        </div>
                    </div>
                    <div class="layui-col-md6">
                        <div class="layui-form-item">
                            <label class="layui-form-label">结束时间</label>
                            <div class="layui-input-block"><input type="text" name="EndDate" class="layui-input" readonly></div>
                        </div>
                    </div>
                    <div class="layui-col-md6">
                        <div class="layui-form-item">
                            <label class="layui-form-label">设备ID</label>
                            <div class="layui-input-block"><input type="text" name="FacilityID" class="layui-input" readonly></div>
                        </div>
                    </div>
                    <div class="layui-col-md6">
                        <div class="layui-form-item">
                            <label class="layui-form-label">模板ID</label>
                            <div class="layui-input-block"><input type="text" name="TempID" class="layui-input" readonly></div>
                        </div>
                    </div>
                    <div class="layui-col-md6">
                        <div class="layui-form-item">
                            <label class="layui-form-label">保养方式</label>
                            <div class="layui-input-block"><input type="text" name="MaintainType" class="layui-input" readonly></div>
                        </div>
                    </div>
                    <div class="layui-col-md12">
                        <div class="layui-form-item">
                            <label class="layui-form-label">备注</label>
                            <div class="layui-input-block"><input type="text" name="Remark" class="layui-input" readonly></div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@section Script{
    <script>
        layui.use(['form'], function () {
            var form = layui.form;
            function ok(res) { return res && (res.code === 0 || res.code === 200); }
            function st(s) {
                var n = parseInt(s, 10);
                if (n === 0) return '草稿';
                if (n === 1) return '进行中';
                if (n === 2) return '已完成';
                if (n === 9) return '已关闭';
                return s != null ? String(s) : '';
            }
            function fmt(v) {
                if (!v) return '';
                return String(v).substring(0, 19).replace('T', ' ');
            }
            $.get('@Url.Action("GetMainInfo", "Facility_BillMain")', { Id: @id }, function (res) {
                if (!ok(res) || !res.data) return;
                var d = res.data;
                var row = {
                    BillNo: d.BillNo || d.billNo,
                    BillDate: fmt(d.BillDate || d.billDate),
                    BillType: d.BillType || d.billType,
                    BeginDate: fmt(d.BeginDate || d.beginDate),
                    EndDate: fmt(d.EndDate || d.endDate),
                    FacilityID: d.FacilityID != null ? d.FacilityID : d.facilityID,
                    TempID: d.TempID != null ? d.TempID : d.tempID,
                    MaintainType: d.MaintainType || d.maintainType,
                    Remark: d.Remark || d.remark,
                    StatusText: st(d.Status != null ? d.Status : d.status)
                };
                form.val('billViewForm', row);
            });
        });
    </script>
}
