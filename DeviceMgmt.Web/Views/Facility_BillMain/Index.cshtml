@{
    ViewData["Title"] = "保养工单";
}
@section Style{
<style>
    /* ================= Gantt 专业化样式 ================= */
    .gantt-toolbar{display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding:10px 14px;background:linear-gradient(180deg,#ffffff,#f8fafc);border:1px solid #e2e8f0;border-radius:8px 8px 0 0;}
    .gantt-toolbar .gtb-block{display:flex;align-items:center;gap:6px;}
    .gantt-toolbar .gtb-label{font-size:12px;color:#64748b;margin-right:2px;}
    .gantt-toolbar .layui-btn-group .layui-btn{margin-right:0;}
    .gantt-toolbar .layui-btn-group .layui-btn-sm{height:30px;line-height:30px;padding:0 14px;font-size:12px;border-radius:0;}
    .gantt-toolbar .layui-btn-group .layui-btn-sm:first-child{border-radius:4px 0 0 4px;}
    .gantt-toolbar .layui-btn-group .layui-btn-sm:last-child{border-radius:0 4px 4px 0;}
    .gantt-toolbar .gantt-dateinput{width:150px;height:30px;line-height:30px;border:1px solid #cbd5e1;border-radius:4px;padding:0 28px 0 10px;font-size:12px;background:#fff url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="%2364748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>') no-repeat right 8px center;cursor:pointer;}
    .gantt-toolbar .gtb-right{margin-left:auto;display:flex;align-items:center;gap:6px;}
    .gantt-toolbar .gantt-range{display:inline-block;min-width:240px;text-align:center;font-weight:600;color:#1F4D3B;font-size:13px;padding:0 10px;letter-spacing:.5px;}
    .gantt-toolbar .gtb-nav{height:30px;line-height:30px;padding:0 12px;}
    .gantt-toolbar .gtb-today{height:30px;line-height:30px;padding:0 14px;border:1px solid #1F4D3B;color:#1F4D3B;background:#fff;border-radius:4px;font-size:12px;}
    .gantt-toolbar .gtb-today:hover{background:#1F4D3B;color:#fff;}

    .gantt-legend{display:flex;gap:18px;flex-wrap:wrap;padding:8px 14px;background:#fafbfc;border:1px solid #e2e8f0;border-top:none;font-size:12px;color:#475569;}
    .gantt-legend .gl-item{display:inline-flex;align-items:center;gap:6px;}
    .gantt-legend .gl-dot{display:inline-block;width:10px;height:10px;border-radius:2px;}

    .gantt-board{overflow:auto;max-height:580px;border:1px solid #e2e8f0;border-top:none;border-radius:0 0 8px 8px;background:#fff;position:relative;}
    .gantt-board table{border-collapse:separate;border-spacing:0;font-size:12px;}
    .gantt-board thead .row-major th{padding:6px 4px;background:linear-gradient(180deg,#26593F,#1F4D3B);color:#fff;border-right:1px solid rgba(255,255,255,.15);border-bottom:1px solid #1F4D3B;font-weight:600;letter-spacing:1px;text-align:center;}
    .gantt-board thead .row-minor th{padding:5px 2px;background:#f8fafc;color:#475569;border-right:1px solid #e2e8f0;border-bottom:1px solid #e2e8f0;font-weight:500;text-align:center;}
    .gantt-board thead .row-minor th.is-weekend{background:#f1f5f9;color:#94a3b8;}
    .gantt-board thead .row-minor th.is-today{background:#fff7ed;color:#c2410c;font-weight:700;}
    .gantt-board thead th.gantt-corner{position:sticky;left:0;z-index:3;background:linear-gradient(180deg,#26593F,#1F4D3B);color:#fff;text-align:left;padding-left:12px;border-right:1px solid rgba(255,255,255,.2);}

    .gantt-board td.gantt-label{position:sticky;left:0;background:#fff;border-right:1px solid #e2e8f0;border-bottom:1px solid #f1f5f9;padding:8px 12px;vertical-align:middle;font-size:12px;color:#1f2937;font-weight:500;z-index:2;}
    .gantt-board tr:nth-child(even) td.gantt-label{background:#fafbfc;}
    .gantt-board tr:hover td.gantt-label{background:#ecfdf5;color:#065f46;}
    .gantt-board td.gantt-track{border-bottom:1px solid #f1f5f9;padding:0;position:relative;background:#fff;}
    .gantt-board tr:nth-child(even) td.gantt-track .track-bg{background:#fcfcfd;}
    .gantt-board tr:hover td.gantt-track{background:#f8fffb;}

    .gantt-board .track-bg{position:relative;height:100%;}
    .gantt-board .today-line{position:absolute;top:0;bottom:0;width:2px;background:#f59e0b;z-index:5;pointer-events:none;box-shadow:0 0 6px rgba(245,158,11,.5);}
    .gantt-board .weekend-cell{position:absolute;top:0;bottom:0;background:rgba(241,245,249,.55);z-index:0;pointer-events:none;}

    .gantt-bar{position:absolute;height:24px;border-radius:5px;cursor:pointer;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#fff;font-size:11px;font-weight:600;line-height:24px;padding:0 10px;box-shadow:0 1px 3px rgba(15,23,42,.14),0 1px 2px rgba(15,23,42,.08);transition:transform .12s ease,box-shadow .12s ease;}
    .gantt-bar:hover{transform:translateY(-1px);box-shadow:0 6px 16px rgba(15,23,42,.22);z-index:6;}
    .gantt-bar.status-0{background:linear-gradient(135deg,#fcd34d,#f59e0b);}
    .gantt-bar.status-1{background:linear-gradient(135deg,#60a5fa,#1e88e5);}
    .gantt-bar.status-2{background:linear-gradient(135deg,#a78bfa,#7c3aed);background-image:linear-gradient(135deg,#a78bfa,#7c3aed),repeating-linear-gradient(45deg,rgba(255,255,255,.18) 0,rgba(255,255,255,.18) 4px,transparent 4px,transparent 8px);}
    .gantt-bar.status-3{background:linear-gradient(135deg,#34d399,#16a34a);}
    .gantt-bar.status-4{background:linear-gradient(135deg,#94a3b8,#475569);}
    .gantt-bar .gb-icon{display:inline-block;width:5px;height:14px;background:rgba(255,255,255,.7);border-radius:2px;margin-right:6px;vertical-align:-3px;}

    /* 状态 pills 现代样式（顺便润色） */
    #statusPills .layui-btn{border-radius:14px;padding:0 14px;height:28px;line-height:28px;}
</style>
}
<div class="layui-fluid" style="padding:12px;">
            <div class="layui-card">
                <div class="layui-card-header">
            <strong>保养工单</strong>
            <span class="layui-btn-group" style="float:right;">
                <button class="layui-btn layui-btn-sm" id="btnViewList"><i class="layui-icon layui-icon-list"></i> @("\u5217\u8868")</button>
                <button class="layui-btn layui-btn-sm layui-btn-primary" id="btnViewKanban"><i class="layui-icon layui-icon-template-1"></i> @("\u72b6\u6001\u770b\u677f")</button>
                <button class="layui-btn layui-btn-sm layui-btn-primary" id="btnViewCalendar"><i class="layui-icon layui-icon-date"></i> @("\u65e5\u5386")</button>
                <button class="layui-btn layui-btn-sm layui-btn-primary" id="btnViewGantt"><i class="layui-icon layui-icon-chart"></i> @("\u7518\u7279\u56fe")</button>
            </span>
        </div>
        <div class="layui-card-body">
            <div class="layui-form layui-row layui-col-space10" style="margin-bottom:8px;">
                <div class="layui-col-md4">
                    <input type="text" id="kw" class="layui-input" placeholder="@("\u8f93\u5165\u5355\u53f7/\u8bbe\u5907\u7f16\u7801/\u8bbe\u5907\u540d\u79f0\u67e5\u8be2")">
                </div>
                <div class="layui-col-md4" id="statusPills">
                    <button class="layui-btn layui-btn-sm" data-status="">@("\u5168\u90e8")</button>
                    <button class="layui-btn layui-btn-sm layui-btn-primary" data-status="0">@("\u65b0\u5efa")</button>
                    <button class="layui-btn layui-btn-sm layui-btn-primary" data-status="1">@("\u5df2\u6d3e\u5de5")</button>
                    <button class="layui-btn layui-btn-sm layui-btn-primary" data-status="2">@("\u4fdd\u517b\u4e2d")</button>
                    <button class="layui-btn layui-btn-sm layui-btn-primary" data-status="3">@("\u5df2\u4fdd\u517b")</button>
                    <button class="layui-btn layui-btn-sm layui-btn-primary" data-status="4">@("\u5df2\u5ba1\u6838")</button>
                </div>
                <div class="layui-col-md4" style="text-align:right;">
                    <button class="layui-btn layui-btn-sm" id="btnPlan"><i class="layui-icon layui-icon-add-1"></i> @("\u5efa\u7acb\u4fdd\u517b\u8ba1\u5212")</button>
                    <button class="layui-btn layui-btn-sm layui-btn-normal" id="btnBatchDispatch"><i class="layui-icon layui-icon-share"></i> @("\u6279\u91cf\u6d3e\u5de5")</button>
                    <button class="layui-btn layui-btn-sm layui-btn-primary" id="btnReload"><i class="layui-icon layui-icon-refresh-3"></i> @("\u5237\u65b0")</button>
                </div>
            </div>

            <div id="paneList">
                <table id="GridMain" lay-filter="GridMain"></table>
            </div>

            <div id="paneKanban" style="display:none;">
                <div id="kanbanBoard" style="display:flex;gap:10px;overflow-x:auto;align-items:flex-start;min-height:520px;"></div>
            </div>

            <div id="paneCalendar" style="display:none;">
                <div style="margin-bottom:8px;display:flex;align-items:center;gap:8px;">
                    <button class="layui-btn layui-btn-sm layui-btn-primary" id="calPrev"><i class="layui-icon layui-icon-left"></i></button>
                    <span id="calTitle" style="font-size:16px;font-weight:600;min-width:120px;text-align:center;"></span>
                    <button class="layui-btn layui-btn-sm layui-btn-primary" id="calNext"><i class="layui-icon layui-icon-right"></i></button>
                    <button class="layui-btn layui-btn-sm" id="calToday">@("\u4eca\u65e5")</button>
                </div>
                <table id="calGrid" style="width:100%;border-collapse:collapse;table-layout:fixed;">
                    <thead>
                        <tr style="background:#f5f5f5;">
                            <th style="padding:6px;border:1px solid #e2e8f0;width:14.28%;">@("\u5468\u65e5")</th>
                            <th style="padding:6px;border:1px solid #e2e8f0;width:14.28%;">@("\u5468\u4e00")</th>
                            <th style="padding:6px;border:1px solid #e2e8f0;width:14.28%;">@("\u5468\u4e8c")</th>
                            <th style="padding:6px;border:1px solid #e2e8f0;width:14.28%;">@("\u5468\u4e09")</th>
                            <th style="padding:6px;border:1px solid #e2e8f0;width:14.28%;">@("\u5468\u56db")</th>
                            <th style="padding:6px;border:1px solid #e2e8f0;width:14.28%;">@("\u5468\u4e94")</th>
                            <th style="padding:6px;border:1px solid #e2e8f0;width:14.28%;">@("\u5468\u516d")</th>
                        </tr>
                    </thead>
                    <tbody id="calBody"></tbody>
                </table>
            </div>

            <div id="paneGantt" style="display:none;">
                <div class="gantt-toolbar">
                    <div class="gtb-block">
                        <span class="gtb-label">@("\u65f6\u95f4\u7c92\u5ea6")</span>
                        <div class="layui-btn-group">
                            <button class="layui-btn layui-btn-sm layui-btn-primary gantt-scale" data-scale="WEEK">@("\u5468")</button>
                            <button class="layui-btn layui-btn-sm gantt-scale" data-scale="MONTH">@("\u6708")</button>
                            <button class="layui-btn layui-btn-sm layui-btn-primary gantt-scale" data-scale="QUARTER">@("\u5b63")</button>
                            <button class="layui-btn layui-btn-sm layui-btn-primary gantt-scale" data-scale="YEAR">@("\u5e74")</button>
                        </div>
                    </div>
                    <div class="gtb-block">
                        <span class="gtb-label">@("\u5b9a\u4f4d\u65e5\u671f")</span>
                        <input id="ganttDate" class="gantt-dateinput" placeholder="@("\u9009\u62e9\u65e5\u671f")" readonly>
                        <button class="gtb-today" id="ganttToday" type="button"><i class="layui-icon layui-icon-time"></i> @("\u4eca\u65e5")</button>
                    </div>
                    <div class="gtb-block">
                        <span class="gtb-label">@("\u5206\u7ec4")</span>
                        <div class="layui-btn-group">
                            <button class="layui-btn layui-btn-sm gantt-group" data-group="facility">@("\u6309\u8bbe\u5907")</button>
                            <button class="layui-btn layui-btn-sm layui-btn-primary gantt-group" data-group="bill">@("\u6309\u4fdd\u517b\u5355")</button>
                    </div>
                </div>
                    <div class="gtb-right">
                        <button class="layui-btn layui-btn-sm gtb-nav" id="ganttPrev" type="button"><i class="layui-icon layui-icon-left"></i></button>
                        <span id="ganttRange" class="gantt-range"></span>
                        <button class="layui-btn layui-btn-sm gtb-nav" id="ganttNext" type="button"><i class="layui-icon layui-icon-right"></i></button>
                    </div>
                </div>
                <div class="gantt-legend">
                    <span class="gtb-label" style="font-weight:600;color:#1F4D3B;">@("\u72b6\u6001\u56fe\u4f8b")</span>
                    <span class="gl-item"><span class="gl-dot" style="background:linear-gradient(135deg,#fcd34d,#f59e0b);"></span>@("\u65b0\u5efa")</span>
                    <span class="gl-item"><span class="gl-dot" style="background:linear-gradient(135deg,#60a5fa,#1e88e5);"></span>@("\u5df2\u6d3e\u5de5")</span>
                    <span class="gl-item"><span class="gl-dot" style="background:linear-gradient(135deg,#a78bfa,#7c3aed);"></span>@("\u4fdd\u517b\u4e2d")</span>
                    <span class="gl-item"><span class="gl-dot" style="background:linear-gradient(135deg,#34d399,#16a34a);"></span>@("\u5df2\u4fdd\u517b")</span>
                    <span class="gl-item"><span class="gl-dot" style="background:linear-gradient(135deg,#94a3b8,#475569);"></span>@("\u5df2\u5ba1\u6838")</span>
                    <span class="gl-item" style="margin-left:auto;color:#94a3b8;font-style:italic;">@("\u7c7b\u578b\u53ef\u5e26\u659c\u7eb9\u8868\u793a&quot;\u4fdd\u517b\u4e2d&quot;\u8fdb\u884c\u4e2d")</span>
                </div>
                <div id="ganttContainer" class="gantt-board"></div>
            </div>
        </div>
    </div>
</div>

<script type="text/html" id="barRow">
    <a class="layui-btn layui-btn-xs" lay-event="view">&#x67e5;&#x770b;</a>
    {{# if(d.Status == 0 || d.Status == null){ }}
    <a class="layui-btn layui-btn-xs layui-btn-normal" lay-event="edit">&#x7f16;&#x8f91;</a>
    <a class="layui-btn layui-btn-xs layui-bg-blue" lay-event="dispatch" style="background-color:#1e88e5;color:#fff;">&#x6d3e;&#x5de5;</a>
    <a class="layui-btn layui-btn-xs layui-btn-danger" lay-event="del">&#x5220;&#x9664;</a>
    {{# } }}
</script>

<script type="text/html" id="tplDispatch">
    <div style="padding:14px;">
        <div id="dispBatchHint" style="display:none;background:#fff3cd;color:#664d03;padding:6px 10px;border-radius:4px;margin-bottom:10px;"></div>
        <div class="layui-form layui-row layui-col-space10" style="margin-bottom:10px;">
            <div class="layui-col-md4">
                <label class="layui-form-label">&#x6d3e;&#x5de5;&#x65f6;&#x95f4;</label>
                <div class="layui-input-block"><input id="disp_DispatchDate" class="layui-input" placeholder="&#x9ed8;&#x8ba4;&#x5f53;&#x524d;&#x65f6;&#x95f4;"></div>
            </div>
            <div class="layui-col-md4">
                <label class="layui-form-label">&#x5f00;&#x59cb;&#x65f6;&#x95f4;</label>
                <div class="layui-input-block"><input id="disp_BeginDate" class="layui-input" placeholder="&#x4fdd;&#x6301;&#x5468;&#x671f;&#x9ed8;&#x8ba4;"></div>
            </div>
            <div class="layui-col-md4">
                <label class="layui-form-label">&#x7ed3;&#x675f;&#x65f6;&#x95f4;</label>
                <div class="layui-input-block"><input id="disp_EndDate" class="layui-input" placeholder="&#x4fdd;&#x6301;&#x5468;&#x671f;&#x9ed8;&#x8ba4;"></div>
            </div>
            <div class="layui-col-md12">
                <label class="layui-form-label">&#x5907;&#x6ce8;</label>
                <div class="layui-input-block"><textarea id="disp_Remark" class="layui-textarea" rows="2" placeholder="&#x6d3e;&#x5de5;&#x8bf4;&#x660e; / &#x6ce8;&#x610f;&#x4e8b;&#x9879;"></textarea></div>
            </div>
        </div>
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
            <input type="text" id="dispKw" class="layui-input" placeholder="&#x8f93;&#x5165;&#x59d3;&#x540d;/&#x5de5;&#x53f7;&#x8fc7;&#x6ee4;" style="max-width:280px;">
            <button class="layui-btn layui-btn-sm" id="btnDispSearch" type="button">&#x67e5;&#x8be2;</button>
            <span style="color:#888;font-size:12px;">&#x70b9;&#x51fb;&#x884c;&#x9009;&#x4e2d;&#x67d0;&#x4eba;&#x540e;&#x518d;&#x70b9;&#x300c;&#x786e;&#x8ba4;&#x6d3e;&#x5de5;&#x300d;</span>
        </div>
        <table id="GridDispEmp" lay-filter="GridDispEmp"></table>
    </div>
</script>

<script type="text/html" id="tplBillDetail">
    <div style="padding:14px;">
        <div id="billActions" style="margin-bottom:10px;padding:6px 0;border-bottom:1px dashed #e2e8f0;display:flex;align-items:center;gap:8px;flex-wrap:wrap;"></div>
        <form class="layui-form" lay-filter="billForm">
            <input type="hidden" name="Id">
            <input type="hidden" name="MaintainType">
            <input type="hidden" name="Status">
            <input type="hidden" name="FacilityID">
            <input type="hidden" name="TempID">
            <input type="hidden" name="BillNo">
            <div class="layui-form-item">
                <div class="layui-inline">
                    <label class="layui-form-label">&#x4fdd;&#x517b;&#x5355;&#x53f7;</label>
                    <div class="layui-input-inline" style="padding-top:8px;"><span id="fld_BillNoText"></span></div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label">&#x4fdd;&#x517b;&#x7c7b;&#x578b;</label>
                    <div class="layui-input-inline" style="padding-top:8px;"><span id="fld_MaintainTypeText"></span></div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label">&#x72b6;&#x6001;</label>
                    <div class="layui-input-inline" style="padding-top:8px;"><span id="fld_StatusText"></span></div>
                </div>
            </div>
            <div class="layui-form-item">
                <div class="layui-inline">
                    <label class="layui-form-label">&#x8ba1;&#x5212;&#x65e5;&#x671f;</label>
                    <div class="layui-input-inline"><input name="BillDate" class="layui-input" id="fld_BillDate"></div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label">&#x5f00;&#x59cb;&#x65f6;&#x95f4;</label>
                    <div class="layui-input-inline"><input name="BeginDate" class="layui-input" id="fld_BeginDate"></div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label">&#x7ed3;&#x675f;&#x65f6;&#x95f4;</label>
                    <div class="layui-input-inline"><input name="EndDate" class="layui-input" id="fld_EndDate"></div>
                </div>
            </div>
            <div class="layui-form-item">
                <div class="layui-inline">
                    <label class="layui-form-label">&#x4fdd;&#x517b;&#x4eba;</label>
                    <div class="layui-input-inline"><input name="RepairStaff" class="layui-input"></div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label">&#x91d1;&#x989d;</label>
                    <div class="layui-input-inline"><input name="Amount" type="number" step="0.01" class="layui-input"></div>
                </div>
            </div>
            <div class="layui-form-item">
                <label class="layui-form-label">&#x5907;&#x6ce8;</label>
                <div class="layui-input-block"><input name="Remark" class="layui-input"></div>
            </div>
        </form>
        <div style="margin:8px 0 4px;font-weight:600;">&#x4fdd;&#x517b;&#x9879;&#x76ee;&#x660e;&#x7ec6;</div>
        <table id="GridBillSub" lay-filter="GridBillSub"></table>
        <div style="margin:14px 0 4px;font-weight:600;">附件</div>
        <div id="maintAttachPanel"></div>
    </div>
</script>

<script type="text/html" id="tplPlan">
    <div style="padding:14px;">
        <form class="layui-form layui-row layui-col-space10" lay-filter="planForm">
            <div class="layui-col-md3">
                <label class="layui-form-label">&#x4fdd;&#x517b;&#x7c7b;&#x578b;</label>
                <div class="layui-input-block">
                    <select id="planCycle" name="planCycle" lay-filter="planCycleSel">
                        <option value="MONTH">&#x6708;</option>
                        <option value="QUARTER">&#x5b63;&#x5ea6;</option>
                        <option value="WEEK">&#x5468;</option>
                        <option value="YEAR">&#x5e74;</option>
                    </select>
                </div>
            </div>
            <div class="layui-col-md2">
                <label class="layui-form-label">&#x751f;&#x6210;&#x6b21;&#x6570;</label>
                <div class="layui-input-block">
                    <input id="planCount" type="number" value="1" min="1" class="layui-input">
                </div>
            </div>
            <div class="layui-col-md3">
                <label class="layui-form-label">&#x5f00;&#x59cb;&#x65e5;&#x671f;</label>
                <div class="layui-input-block"><input id="planStartDate" class="layui-input"></div>
            </div>
            <div class="layui-col-md4" style="text-align:right;padding-top:24px;">
                <button type="button" class="layui-btn layui-btn-sm" id="btnPickDevices"><i class="layui-icon layui-icon-add-1"></i> &#x9009;&#x62e9;&#x8bbe;&#x5907;</button>
                <button type="button" class="layui-btn layui-btn-sm layui-btn-warm" id="btnRefreshStatus"><i class="layui-icon layui-icon-refresh-3"></i> &#x5237;&#x65b0;&#x72b6;&#x6001;</button>
            </div>
        </form>
        <div style="margin:8px 0 4px;font-weight:600;">&#x5df2;&#x9009;&#x8bbe;&#x5907;&#xff08;&#x7ea2;&#x8272;&#x3d;&#x672a;&#x914d;&#x7f6e;&#x8be5;&#x4fdd;&#x517b;&#x7c7b;&#x578b;&#x6a21;&#x677f;&#xff0c;&#x4e0d;&#x5141;&#x8bb8;&#x751f;&#x6210;&#xff09;</div>
        <table id="GridPlanDevices" lay-filter="GridPlanDevices"></table>
    </div>
</script>

<script type="text/html" id="tplPickDevices">
    <div style="padding:14px;">
        <div class="layui-form layui-row layui-col-space10" style="margin-bottom:8px;">
            <div class="layui-col-md6">
                <input type="text" id="pickKw" class="layui-input" placeholder="&#x8f93;&#x5165;&#x8bbe;&#x5907;&#x7f16;&#x7801; / &#x540d;&#x79f0; / &#x578b;&#x53f7;&#x67e5;&#x8be2;">
            </div>
            <div class="layui-col-md6" style="text-align:right;">
                <button type="button" class="layui-btn layui-btn-sm" id="btnPickSearch"><i class="layui-icon layui-icon-search"></i> &#x67e5;&#x8be2;</button>
            </div>
        </div>
        <table id="GridPickDevices" lay-filter="GridPickDevices"></table>
    </div>
</script>

@section Script{
    <script>
        var URL_MAIN_LIST       = '@Url.Action("GetMainList")';
        var URL_BILL_DETAIL     = '@Url.Action("GetBillDetail")';
        var URL_UPDATE_BILL     = '@Url.Action("UpdateBill")';
        var URL_DELETE_BILL     = '@Url.Action("DeleteBill")';
        var URL_BATCH_GENERATE  = '@Url.Action("BatchGenerate")';
        var URL_CHECK_TEMPLATES = '@Url.Action("CheckTemplates")';
        var URL_PLAN_DEVICES    = '@Url.Action("GetPlanDevices")';
        var URL_DISPATCH        = '@Url.Action("Dispatch")';
        var URL_BATCH_DISPATCH  = '@Url.Action("BatchDispatch")';
        var URL_EMPLOYEES       = '@Url.Action("GetEmployees")';
        var URL_START_MAINTAIN  = '@Url.Action("StartMaintain")';
        var URL_FINISH_MAINTAIN = '@Url.Action("FinishMaintain")';
        var URL_AUDIT           = '@Url.Action("Audit")';

        layui.use(['table', 'form', 'layer', 'laydate'], function () {
            var table = layui.table, form = layui.form, layer = layui.layer, laydate = layui.laydate;
            function ok(res) { return res && (res.code === 0 || res.code === 200); }
            function toast(msg) { layer.msg(msg || ''); }
            function toastOk(msg) { layer.msg(msg || '\u64cd\u4f5c\u6210\u529f', { icon: 1 }); }
            function toastErr(msg) { layer.msg(msg || '\u64cd\u4f5c\u5931\u8d25', { icon: 2 }); }
            function toastWarn(msg) { layer.msg(msg || '', { icon: 0 }); }
            function fmtDate(s) { return s ? (s + '').replace('T', ' ').substring(0, 19) : ''; }
            function statusText(s) { return ({0:'\u65b0\u5efa',1:'\u5df2\u6d3e\u5de5',2:'\u4fdd\u517b\u4e2d',3:'\u5df2\u4fdd\u517b',4:'\u5df2\u5ba1\u6838'})[s] || (s + ''); }
            function cycleText(c) { c = (c||'').toUpperCase(); return ({YEAR:'\u5e74',QUARTER:'\u5b63\u5ea6',MONTH:'\u6708',WEEK:'\u5468'})[c] || c; }

            function billMaintainTypeCell(d) {
                var raw = d.MaintainType != null && d.MaintainType !== '' ? d.MaintainType : (d.maintainType || '');
                return '<span>' + cycleText(String(raw).toUpperCase()) + '</span>';
            }
            function billStatusCell(d) {
                var s = d.Status != null ? d.Status : d.status;
                var n = parseInt(s, 10);
                if (isNaN(n)) n = 0;
                var colors = { 0: '#f7b500', 1: '#1e88e5', 2: '#7c3aed', 3: '#16a34a', 4: '#475569' };
                var bg = colors[n] != null ? colors[n] : '#999';
                return '<span class="layui-badge" style="background-color:' + bg + ';">' + statusText(n) + '</span>';
            }

            /** Layui/JSON may use camelCase; template columns use PascalCase */
            function rowField(obj, name) {
                if (!obj || typeof obj !== 'object') return '';
                var v = obj[name];
                if (v !== undefined && v !== null && String(v) !== '') return v;
                var camel = name.charAt(0).toLowerCase() + name.slice(1);
                v = obj[camel];
                if (v !== undefined && v !== null && String(v) !== '') return v;
                return '';
            }
            function rowId(obj) {
                if (!obj) return 0;
                if (obj.Id !== undefined && obj.Id !== null) return obj.Id;
                if (obj.id !== undefined && obj.id !== null) return obj.id;
                return 0;
            }
            function syncPlanCycleFromDom() {
                var v = ($('#planCycle').val() || planState.cycle || 'MONTH').toString().trim().toUpperCase();
                if (v !== 'MONTH' && v !== 'QUARTER' && v !== 'WEEK' && v !== 'YEAR') v = 'MONTH';
                planState.cycle = v;
            }

            var currentStatus = '';
            var planState = { cycle: 'MONTH', count: 1, startDate: '', devices: [] };
            var staffNameMap = {}; // EmployeeNumber -> Name
            function loadStaffMap() {
                $.get(URL_EMPLOYEES, function (res) {
                    if (ok(res) && res.data) {
                        res.data.forEach(function (e) {
                            if (e.EmployeeNumber) staffNameMap[e.EmployeeNumber] = e.Name || e.EmployeeNumber;
                        });
                        // 已渲染过的列表如果存在，刷新一次以替换姓名
                        try { table.reload('GridMain'); } catch (ex) {}
                    }
                });
            }
            function staffDisplay(code) {
                if (!code) return '';
                var name = staffNameMap[code];
                return name
                    ? (name + ' <span style="color:#888;font-size:11px;">(' + code + ')</span>')
                    : code;
            }

            function getWhere() {
                var list = [];
                var kw = $('#kw').val();
                if (kw) list.push({ field: 'BillNo', conditional: 'like', value: kw });
                if (currentStatus !== '') list.push({ field: 'Status', conditional: 'eq', value: currentStatus });
                return { page: 1, limit: 20, searchParam: list };
            }

            function renderList() {
                table.render({
                    elem: '#GridMain',
                    id: 'GridMain',
                    url: URL_MAIN_LIST,
                    method: 'post',
                    where: getWhere(),
                    page: true,
                    height: 'full-260',
                    cols: [[
                        { type: 'checkbox', fixed: 'left' },
                        { type: 'numbers', title: '#' },
                        { field: 'BillNo', title: '\u4fdd\u517b\u5355\u53f7', width: 160 },
                        { field: 'FacilityID', title: '\u8bbe\u5907ID', width: 110 },
                        { field: 'MaintainType', title: '\u4fdd\u517b\u7c7b\u578b', width: 100, templet: billMaintainTypeCell },
                        { field: 'BillDate', title: '\u8ba1\u5212\u65e5\u671f', width: 160, templet: function (d) { return fmtDate(d.BillDate); } },
                        { field: 'BeginDate', title: '\u5f00\u59cb\u65f6\u95f4', width: 160, templet: function (d) { return fmtDate(d.BeginDate); } },
                        { field: 'EndDate', title: '\u7ed3\u675f\u65f6\u95f4', width: 160, templet: function (d) { return fmtDate(d.EndDate); } },
                        { field: 'ChangedBeginDate', title: '\u53d8\u66f4\u540e\u65e5\u671f', width: 200, templet: function (d) { if (!d.ChangedBeginDate && !d.ChangedEndDate) return '<span style="color:#cbd5e1;">-</span>'; return '<span style="color:#dc2626;">' + fmtDate(d.ChangedBeginDate) + (d.ChangedEndDate ? ' ~ ' + fmtDate(d.ChangedEndDate) : '') + '</span>'; } },
                        { field: 'Status', title: '\u72b6\u6001', width: 100, templet: billStatusCell },
                        { field: 'RepairStaff', title: '\u4fdd\u517b\u4eba', width: 150, templet: function (d) { return staffDisplay(d.RepairStaff || d.repairStaff); } },
                        { field: 'Remark', title: '\u5907\u6ce8', minWidth: 160 },
                        { title: '\u64cd\u4f5c', width: 240, toolbar: '#barRow', fixed: 'right' }
                    ]]
                });
            }

            function renderBillActions(billId, status, main, dlgIdx, readOnly) {
                var html = '';
                html += '<span style="color:#666;">' + billStatusCell({ Status: status }) + '</span>';
                if (main && main.RepairStaff) {
                    html += '<span style="margin-left:6px;color:#666;font-size:12px;">\u4fdd\u517b\u4eba\uff1a' + staffDisplay(main.RepairStaff) + '</span>';
                }
                if (main && main.DispatchDate) {
                    html += '<span style="margin-left:6px;color:#888;font-size:12px;">\u6d3e\u5de5\u4e8e ' + fmtDate(main.DispatchDate) + '</span>';
                }
                html += '<span style="flex:1;"></span>';
                if (status === 0) {
                    html += '<button class="layui-btn layui-btn-sm" id="btnGoDispatch" style="background:#1e88e5;color:#fff;"><i class="layui-icon layui-icon-share"></i> \u6d3e\u5de5</button>';
                }
                if (status === 1) {
                    html += '<button class="layui-btn layui-btn-sm" id="btnStartM"><i class="layui-icon layui-icon-play"></i> \u5f00\u59cb\u4fdd\u517b</button>';
                }
                if (status === 2) {
                    html += '<button class="layui-btn layui-btn-sm layui-btn-normal" id="btnFinishM"><i class="layui-icon layui-icon-ok-circle"></i> \u5b8c\u5de5</button>';
                }
                if (status === 3) {
                    html += '<button class="layui-btn layui-btn-sm layui-btn-warm" id="btnAuditM"><i class="layui-icon layui-icon-auz"></i> \u5ba1\u6838\u901a\u8fc7</button>';
                }
                $('#billActions').html(html);

                $('#btnGoDispatch').on('click', function () {
                    layer.close(dlgIdx);
                    openDispatchDialog('single', { ids: [billId], row: main });
                });
                $('#btnStartM').on('click', function () {
                    layer.confirm('\u786e\u8ba4\u300c\u5f00\u59cb\u4fdd\u517b\u300d\uff1f\u300c\u5f00\u59cb\u65f6\u95f4\u300d\u5c06\u88ab\u5f53\u524d\u65f6\u95f4\u8986\u76d6', function (i) {
                        $.post(URL_START_MAINTAIN, { id: billId }, function (res) {
                            layer.close(i);
                            if (ok(res)) { layer.close(dlgIdx); refreshCurrentView(); toastOk('\u5df2\u5f00\u59cb\u4fdd\u517b'); }
                            else toastErr(res.msg || '\u64cd\u4f5c\u5931\u8d25');
                        });
                    });
                });
                $('#btnFinishM').on('click', function () {
                    layer.open({
                        type: 1, title: '\u5b8c\u5de5\u786e\u8ba4', area: ['520px', '320px'],
                        content: '<div style="padding:14px;">'
                            + '<div class="layui-form-item"><label class="layui-form-label">\u4fdd\u517b\u7ed3\u679c</label>'
                            + '<div class="layui-input-block"><select id="finIsOk"><option value="1">\u6b63\u5e38</option><option value="0">\u5f02\u5e38</option></select></div></div>'
                            + '<div class="layui-form-item"><label class="layui-form-label">\u5b8c\u5de5\u5907\u6ce8</label>'
                            + '<div class="layui-input-block"><textarea id="finRemark" rows="3" class="layui-textarea" placeholder="\u53ef\u9009"></textarea></div></div>'
                            + '</div>',
                        btn: ['\u63d0\u4ea4', '\u53d6\u6d88'],
                        success: function () { form.render(); },
                        yes: function (i) {
                            $.post(URL_FINISH_MAINTAIN, {
                                id: billId,
                                isOk: $('#finIsOk').val(),
                                finishRemark: $('#finRemark').val() || ''
                            }, function (res) {
                                layer.close(i);
                                if (ok(res)) { layer.close(dlgIdx); refreshCurrentView(); toastOk('\u5df2\u5b8c\u5de5'); }
                                else toastErr(res.msg || '\u64cd\u4f5c\u5931\u8d25');
                            });
                        }
                    });
                });
                $('#btnAuditM').on('click', function () {
                    layer.confirm('\u786e\u8ba4\u5ba1\u6838\u901a\u8fc7\uff1f', function (i) {
                        $.post(URL_AUDIT, { id: billId }, function (res) {
                            layer.close(i);
                            if (ok(res)) { layer.close(dlgIdx); refreshCurrentView(); toastOk('\u5df2\u5ba1\u6838'); }
                            else toastErr(res.msg || '\u64cd\u4f5c\u5931\u8d25');
                        });
                    });
                });
            }

            function openDetail(row, readOnly) {
                var dlgIdx = layer.open({
                    type: 1,
                    area: ['1000px', '720px'],
                    title: (readOnly ? '\u67e5\u770b' : '\u7f16\u8f91') + ' \u4fdd\u517b\u5355 ' + (row.BillNo || ''),
                    content: $('#tplBillDetail').html(),
                    btn: readOnly ? ['\u5173\u95ed'] : ['\u4fdd\u5b58', '\u5173\u95ed'],
                    success: function () {
                        form.render();
                        laydate.render({ elem: '#fld_BillDate', type: 'datetime' });
                        laydate.render({ elem: '#fld_BeginDate', type: 'datetime' });
                        laydate.render({ elem: '#fld_EndDate', type: 'datetime' });
                        $.get(URL_BILL_DETAIL, { id: row.Id }, function (res) {
                            if (!ok(res) || !res.data) { toastErr(res.msg || '\u52a0\u8f7d\u5931\u8d25'); return; }
                            var m = res.data.Main || {};
                            var rawCycle = (m.MaintainType || '').toUpperCase();
                            var rawStatus = parseInt(m.Status, 10); if (isNaN(rawStatus)) rawStatus = 0;
                            m.BillDate = fmtDate(m.BillDate);
                            m.BeginDate = fmtDate(m.BeginDate);
                            m.EndDate = fmtDate(m.EndDate);
                            m.MaintainType = rawCycle;
                            form.val('billForm', m);
                            $('#fld_BillNoText').text(m.BillNo || '');
                            $('#fld_MaintainTypeText').text(cycleText(rawCycle));
                            $('#fld_StatusText').text(statusText(rawStatus));
                            renderBillActions(row.Id, rawStatus, m, dlgIdx, readOnly);
                            if (readOnly) {
                                $('form[lay-filter=billForm] input').attr('readonly', true).attr('disabled', true);
                            }
                            table.render({
                                elem: '#GridBillSub',
                                data: res.data.Subs || [],
                                page: false,
                                cols: [[
                                    { type: 'numbers', title: '#' },
                                    { field: 'Project', title: '\u4fdd\u517b\u9879\u76ee', minWidth: 160 },
                                    { field: 'UpkeepMethod', title: '\u4fdd\u517b\u65b9\u6cd5', minWidth: 180 },
                                    { field: 'CheckMethod', title: '\u6807\u51c6\u63cf\u8ff0', minWidth: 160 },
                                    { field: 'MinValue', title: '\u6700\u5c0f\u503c', width: 80 },
                                    { field: 'MaxValue', title: '\u6700\u5927\u503c', width: 80 },
                                    { field: 'Result', title: '\u4fdd\u517b\u7ed3\u679c', width: 120 },
                                    { field: 'Remark', title: '\u5907\u6ce8', minWidth: 120 }
                                ]]
                            });
                            try { if (window.AttachmentWidget && row.Id) AttachmentWidget.mount({ container: '#maintAttachPanel', businessType: 'maintain', businessId: row.Id, readonly: readOnly }); } catch (e) {}
                        });
                    },
                    yes: function (idx) {
                        if (readOnly) { layer.close(idx); return; }
                        var data = form.val('billForm');
                        $.post(URL_UPDATE_BILL, data, function (res) {
                            if (ok(res)) {
                                layer.close(idx);
                                table.reload('GridMain');
                                toastOk('\u4fdd\u5b58\u6210\u529f');
                            } else toastErr(res.msg || '\u4fdd\u5b58\u5931\u8d25');
                        });
                    }
                });
            }

            function openPlanDialog() {
                planState = { cycle: 'MONTH', count: 1, startDate: formatToday(), devices: [] };
                layer.open({
                    type: 1,
                    area: ['1100px', '680px'],
                    title: '\u5efa\u7acb\u4fdd\u517b\u8ba1\u5212',
                    content: $('#tplPlan').html(),
                    btn: ['\u786e\u8ba4\u751f\u6210', '\u5173\u95ed'],
                    success: function () {
                        form.render();
                        laydate.render({ elem: '#planStartDate', value: planState.startDate });
                        syncPlanCycleFromDom();
                        $('#planCount').on('change', function () { planState.count = parseInt($(this).val(), 10) || 1; });
                        $('#planStartDate').on('blur', function () { planState.startDate = $(this).val(); });
                        $('#btnPickDevices').on('click', openPickDevices);
                        $('#btnRefreshStatus').on('click', refreshPlanGrid);
                        renderPlanGrid();
                    },
                    yes: function (idx) {
                        if (planState.devices.length === 0) { toastWarn('\u8bf7\u5148\u9009\u62e9\u8bbe\u5907'); return; }
                        var missing = planState.devices.filter(function (d) { return !d.HasTemplate; });
                        if (missing.length > 0) { toastErr('\u6709\u672a\u914d\u7f6e\u6a21\u677f\u7684\u8bbe\u5907\uff0c\u4e0d\u5141\u8bb8\u751f\u6210\uff0c\u8bf7\u5148\u53bb\u6a21\u677f\u91cc\u914d\u7f6e'); return; }
                        $.post(URL_BATCH_GENERATE, {
                            deviceIds: planState.devices.map(function (d) { return d.Id; }),
                            cycle: planState.cycle,
                            count: planState.count,
                            startDate: planState.startDate
                        }, function (res) {
                            if (ok(res)) {
                                layer.close(idx);
                                table.reload('GridMain');
                                toastOk(res.msg || '\u5df2\u751f\u6210');
                            } else toastErr(res.msg || '\u751f\u6210\u5931\u8d25');
                        });
                    }
                });
            }

            function renderPlanGrid() {
                syncPlanCycleFromDom();
                table.render({
                    elem: '#GridPlanDevices',
                    id: 'GridPlanDevices',
                    data: planState.devices,
                    page: false,
                    height: 380,
                    cols: [[
                        { field: 'FacilityCode', title: '\u8bbe\u5907\u7f16\u7801', width: 140 },
                        { field: 'FacilityName', title: '\u8bbe\u5907\u540d\u79f0', minWidth: 160 },
                        { field: 'Model', title: '\u8bbe\u5907\u578b\u53f7', width: 130 },
                        { field: 'WeekTempName', title: '\u5468\u4fdd\u517b\u6a21\u677f', width: 150, templet: tplCellTemplet('WeekTempName') },
                        { field: 'MonthTempName', title: '\u6708\u4fdd\u517b\u6a21\u677f', width: 150, templet: tplCellTemplet('MonthTempName') },
                        { field: 'SeasonTempName', title: '\u5b63\u5ea6\u4fdd\u517b\u6a21\u677f', width: 150, templet: tplCellTemplet('SeasonTempName') },
                        { field: 'HalfYearTempName', title: '\u534a\u5e74\u4fdd\u517b\u6a21\u677f', width: 150, templet: function (d) { return rowField(d, 'HalfYearTempName'); } },
                        { field: 'YearTempName', title: '\u5e74\u4fdd\u517b\u6a21\u677f', width: 150, templet: tplCellTemplet('YearTempName') },
                        { field: 'HasTemplate', title: '\u5f53\u524d\u5468\u671f', width: 110, templet: function (d) {
                            return d.HasTemplate
                                ? '<span class="layui-badge layui-bg-green">\u5df2\u914d\u7f6e</span>'
                                : '<span class="layui-badge">\u672a\u914d\u7f6e</span>';
                        } },
                        { title: '\u64cd\u4f5c', width: 80, templet: function (d) {
                            return '<a class="layui-btn layui-btn-xs layui-btn-danger" onclick="window.__removePlanDev(' + d.Id + ')">\u79fb\u9664</a>';
                        } }
                    ]],
                    done: function () { highlightMissingRows(); }
                });
            }

            function tplCellTemplet(field) {
                return function (d) {
                    var current = planState.cycle === 'MONTH' ? 'MonthTempName'
                                : planState.cycle === 'QUARTER' ? 'SeasonTempName'
                                : planState.cycle === 'WEEK' ? 'WeekTempName'
                                : 'YearTempName';
                    var v = rowField(d, field);
                    if (field === current && !v) return '<span style="color:#e53935;">\u672a\u914d\u7f6e</span>';
                    return v;
                };
            }

            function highlightMissingRows() {
                $('#GridPlanDevices').next('.layui-table-view').find('tbody tr').each(function (i) {
                    var row = planState.devices[i];
                    if (row && !row.HasTemplate) $(this).css('background-color', '#fde8e8');
                    else $(this).css('background-color', '');
                });
            }

            window.__removePlanDev = function (id) {
                planState.devices = planState.devices.filter(function (d) { return d.Id !== id; });
                renderPlanGrid();
            };

            function refreshPlanGrid() {
                if (planState.devices.length === 0) { renderPlanGrid(); return; }
                var ids = planState.devices.map(function (d) { return d.Id; });
                $.post(URL_CHECK_TEMPLATES, { 'deviceIds[]': ids, cycle: planState.cycle }, function (res) {
                    if (ok(res) && res.data) {
                        var byId = {};
                        res.data.forEach(function (s) {
                            var did = s.DeviceId != null ? s.DeviceId : s.deviceId;
                            if (did != null) byId[did] = s;
                        });
                        planState.devices.forEach(function (d) {
                            var did = rowId(d);
                            var s = byId[did];
                            d.HasTemplate = s ? (s.HasTemplate === true || s.HasTemplate === 1 || s.hasTemplate === true) : false;
                            d.TempId = s ? (s.TempId != null ? s.TempId : s.tempId) : null;
                        });
                        renderPlanGrid();
                    }
                });
            }

            function openPickDevices() {
                var picked = {};
                planState.devices.forEach(function (d) { picked[rowId(d)] = true; });
                layer.open({
                    type: 1,
                    area: ['1100px', '600px'],
                    title: '\u9009\u62e9\u8bbe\u5907',
                    content: $('#tplPickDevices').html(),
                    btn: ['\u786e\u8ba4\u6dfb\u52a0', '\u5173\u95ed'],
                    success: function () {
                        renderPickGrid();
                        $('#btnPickSearch').on('click', function () { table.reload('GridPickDevices', { where: getPickWhere() }); });
                        $('#pickKw').on('keydown', function (e) { if (e.keyCode === 13) $('#btnPickSearch').click(); });
                    },
                    yes: function (idx) {
                        var check = table.checkStatus('GridPickDevices').data || [];
                        if (check.length === 0) { toastWarn('\u8bf7\u52fe\u9009\u8bbe\u5907'); return; }
                        check.forEach(function (row) {
                            var rid = rowId(row);
                            if (!picked[rid]) {
                                planState.devices.push({
                                    Id: rid,
                                    FacilityCode: rowField(row, 'FacilityCode'),
                                    FacilityName: rowField(row, 'FacilityName'),
                                    Model: rowField(row, 'Model'),
                                    WeekTempName: rowField(row, 'WeekTempName'),
                                    MonthTempName: rowField(row, 'MonthTempName'),
                                    SeasonTempName: rowField(row, 'SeasonTempName'),
                                    HalfYearTempName: rowField(row, 'HalfYearTempName'),
                                    YearTempName: rowField(row, 'YearTempName'),
                                    HasTemplate: false,
                                    TempId: null
                                });
                                picked[rid] = true;
                            }
                        });
                        layer.close(idx);
                        refreshPlanGrid();
                    }
                });
            }

            function getPickWhere() {
                var list = [];
                var kw = $('#pickKw').val();
                if (kw) list.push({ field: 'FacilityName', conditional: 'like', value: kw });
                return { page: 1, limit: 20, searchParam: list };
            }

            function renderPickGrid() {
                table.render({
                    elem: '#GridPickDevices',
                    id: 'GridPickDevices',
                    url: URL_PLAN_DEVICES,
                    method: 'post',
                    where: getPickWhere(),
                    page: true,
                    height: 440,
                    cols: [[
                        { type: 'checkbox' },
                        { field: 'FacilityCode', title: '\u8bbe\u5907\u7f16\u7801', width: 140 },
                        { field: 'FacilityName', title: '\u8bbe\u5907\u540d\u79f0', minWidth: 160 },
                        { field: 'Model', title: '\u8bbe\u5907\u578b\u53f7', width: 130 },
                        { field: 'WeekTempName', title: '\u5468\u4fdd\u517b\u6a21\u677f', width: 120 },
                        { field: 'MonthTempName', title: '\u6708\u4fdd\u517b\u6a21\u677f', width: 120 },
                        { field: 'SeasonTempName', title: '\u5b63\u5ea6\u4fdd\u517b\u6a21\u677f', width: 120 },
                        { field: 'HalfYearTempName', title: '\u534a\u5e74\u4fdd\u517b\u6a21\u677f', width: 120, templet: function (d) { return rowField(d, 'HalfYearTempName'); } },
                        { field: 'YearTempName', title: '\u5e74\u4fdd\u517b\u6a21\u677f', width: 120 }
                    ]]
                });
            }

            function refreshCurrentView() {
                if (currentView === 'list') {
                    table.reload('GridMain', { where: getWhere() });
                } else if (currentView === 'kanban') {
                    loadAllBills(renderKanban);
                } else if (currentView === 'calendar') {
                    loadAllBills(renderCalendar);
                } else if (currentView === 'gantt') {
                    loadAllBills(renderGantt);
                }
            }

            $('#statusPills button').on('click', function () {
                $('#statusPills button').addClass('layui-btn-primary');
                $(this).removeClass('layui-btn-primary');
                currentStatus = $(this).data('status');
                refreshCurrentView();
            });

            form.on('select(planCycleSel)', function (data) {
                planState.cycle = (data.value || 'MONTH').toString().trim().toUpperCase();
                refreshPlanGrid();
            });

            $('#btnPlan').on('click', openPlanDialog);
            $('#btnReload').on('click', refreshCurrentView);
            $('#kw').on('keydown', function (e) { if (e.keyCode === 13) $('#btnReload').click(); });

            // list / kanban / calendar / gantt
            var currentView = 'list';
            var allBills = [];
            var calCursor = new Date();
            var ganttCursor = new Date();
            var ganttScale = 'MONTH';
            var ganttGroup = 'facility';

            function loadAllBills(cb) {
                var sp = [];
                var kw = $('#kw').val();
                if (kw) sp.push({ field: 'BillNo', conditional: 'like', value: kw });
                if (currentStatus !== '') sp.push({ field: 'Status', conditional: 'eq', value: currentStatus });
                $.post(URL_MAIN_LIST, { page: 1, limit: 9999, searchParam: sp }, function (res) {
                    allBills = (res && res.data) ? res.data : [];
                    if (cb) cb();
                });
            }

            $('#btnViewList').on('click', function () { showPane('list'); });
            $('#btnViewKanban').on('click', function () { showPane('kanban'); });
            $('#btnViewCalendar').on('click', function () { showPane('calendar'); });
            $('#btnViewGantt').on('click', function () { showPane('gantt'); });

            function syncViewButtons(active) {
                $('#btnViewList,#btnViewKanban,#btnViewCalendar,#btnViewGantt').addClass('layui-btn-primary');
                if (active === 'list') $('#btnViewList').removeClass('layui-btn-primary');
                if (active === 'kanban') $('#btnViewKanban').removeClass('layui-btn-primary');
                if (active === 'calendar') $('#btnViewCalendar').removeClass('layui-btn-primary');
                if (active === 'gantt') $('#btnViewGantt').removeClass('layui-btn-primary');
            }

            function showPane(name) {
                currentView = name;
                syncViewButtons(name);
                $('#paneList,#paneKanban,#paneCalendar,#paneGantt').hide();
                $('#paneList').toggle(name === 'list');
                if (name === 'list') { table.reload('GridMain', { where: getWhere() }); }
                if (name === 'kanban')  { $('#paneKanban').show();  loadAllBills(renderKanban); }
                if (name === 'calendar'){ $('#paneCalendar').show();loadAllBills(renderCalendar); }
                if (name === 'gantt')   {
                    $('#paneGantt').show();
                    rebuildGanttDatePicker();
                    syncGanttDateInput();
                    loadAllBills(renderGantt);
                }
            }

            // ---------------- Kanban ----------------
            function renderKanban() {
                var cols = [
                    { status: 0, name: '\u65b0\u5efa', color: '#f7b500' },
                    { status: 1, name: '\u5df2\u6d3e\u5de5', color: '#1e88e5' },
                    { status: 2, name: '\u4fdd\u517b\u4e2d', color: '#7c3aed' },
                    { status: 3, name: '\u5df2\u4fdd\u517b', color: '#16a34a' },
                    { status: 4, name: '\u5df2\u5ba1\u6838', color: '#475569' }
                ];
                var grouped = {};
                cols.forEach(function (c) { grouped[c.status] = []; });
                allBills.forEach(function (b) {
                    var sid = b.Status != null ? b.Status : b.status;
                    var s = parseInt(sid, 10);
                    if (isNaN(s)) s = 0;
                    if (grouped[s]) grouped[s].push(b);
                });
                var html = '';
                cols.forEach(function (c) {
                    var arr = grouped[c.status];
                    html += '<div class="kanban-col" style="flex:0 0 260px;background:#f7f8fa;border-radius:6px;padding:8px;">';
                    html += '<div style="font-weight:600;padding:4px 6px;border-bottom:2px solid ' + c.color + ';margin-bottom:8px;color:' + c.color + ';">'
                        + c.name + ' <span style="color:#888;font-weight:normal;">(' + arr.length + ')</span></div>';
                    arr.forEach(function (b) {
                        var mt = b.MaintainType != null && b.MaintainType !== '' ? b.MaintainType : (b.maintainType || '');
                        var cycle = cycleText(String(mt).toUpperCase());
                        var fid = b.FacilityID != null && b.FacilityID !== '' ? b.FacilityID : (b.facilityID || '');
                        html += '<div class="kanban-card" data-id="' + rowId(b) + '" '
                            + 'style="background:#fff;border:1px solid #e2e8f0;border-left:4px solid ' + c.color + ';'
                            + 'border-radius:4px;padding:8px;margin-bottom:8px;cursor:pointer;font-size:12px;">'
                            + '<div style="font-weight:600;color:#1f4d3b;">' + (b.BillNo || '') + '</div>'
                            + '<div style="margin-top:4px;color:#555;">\u8bbe\u5907\uff1a' + fid + '</div>'
                            + '<div style="color:#555;">\u7c7b\u578b\uff1a' + cycle + '</div>'
                            + '<div style="color:#888;">\u8ba1\u5212\uff1a' + fmtDate(b.BillDate) + '</div>'
                            + '</div>';
                    });
                    if (arr.length === 0) html += '<div style="color:#bbb;font-size:12px;text-align:center;padding:20px 0;">\u6682\u65e0</div>';
                    html += '</div>';
                });
                $('#kanbanBoard').html(html);
                $('#kanbanBoard .kanban-card').on('click', function () {
                    var id = String($(this).attr('data-id'));
                    var row = allBills.find(function (b) { return String(rowId(b)) === id; });
                    if (row) openDetail(row, true);
                });
            }

            // ---------------- Calendar ----------------
            function renderCalendar() {
                var year = calCursor.getFullYear(), month = calCursor.getMonth();
                $('#calTitle').text(year + '-' + pad2(month + 1));
                var first = new Date(year, month, 1);
                var startWeekday = first.getDay();
                var daysInMonth = new Date(year, month + 1, 0).getDate();
                var byDate = {};
                allBills.forEach(function (b) {
                    var bd = b.BillDate || b.billDate;
                    if (!bd) return;
                    var key = (bd + '').substring(0, 10);
                    if (!byDate[key]) byDate[key] = [];
                    byDate[key].push(b);
                });
                var html = '';
                var day = 1;
                for (var w = 0; w < 6; w++) {
                    html += '<tr>';
                    for (var d = 0; d < 7; d++) {
                        var idx = w * 7 + d;
                        if (idx < startWeekday || day > daysInMonth) {
                            html += '<td style="border:1px solid #e2e8f0;height:110px;vertical-align:top;background:#fafafa;"></td>';
                        } else {
                            var dateStr = year + '-' + pad2(month + 1) + '-' + pad2(day);
                            var items = byDate[dateStr] || [];
                            html += '<td style="border:1px solid #e2e8f0;height:110px;vertical-align:top;padding:4px;">';
                            html += '<div style="font-size:12px;color:#888;">' + day + '</div>';
                            items.slice(0, 4).forEach(function (b) {
                                var sid = b.Status != null ? b.Status : b.status;
                                var sn = parseInt(sid, 10);
                                if (isNaN(sn)) sn = 0;
                                var c = statusColor(sn);
                                html += '<div class="cal-item" data-id="' + rowId(b) + '" '
                                    + 'style="font-size:11px;background:' + c + '22;border-left:3px solid ' + c + ';'
                                    + 'padding:2px 4px;margin-top:2px;cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">'
                                    + (b.BillNo || '') + '</div>';
                            });
                            if (items.length > 4) html += '<div style="font-size:11px;color:#888;">+' + (items.length - 4) + '</div>';
                            html += '</td>';
                            day++;
                        }
                    }
                    html += '</tr>';
                    if (day > daysInMonth) break;
                }
                $('#calBody').html(html);
                $('#calBody .cal-item').on('click', function () {
                    var id = String($(this).attr('data-id'));
                    var row = allBills.find(function (b) { return String(rowId(b)) === id; });
                    if (row) openDetail(row, true);
                });
            }
            $('#calPrev').on('click', function () { calCursor = new Date(calCursor.getFullYear(), calCursor.getMonth() - 1, 1); renderCalendar(); });
            $('#calNext').on('click', function () { calCursor = new Date(calCursor.getFullYear(), calCursor.getMonth() + 1, 1); renderCalendar(); });
            $('#calToday').on('click', function () { calCursor = new Date(); renderCalendar(); });

            function statusColor(s) { return ({0:'#f7b500',1:'#1e88e5',2:'#7c3aed',3:'#16a34a',4:'#475569'})[s] || '#999'; }
            function pad2(n) { return n < 10 ? '0' + n : '' + n; }

            // ---------------- Gantt ----------------
            var __ganttDateInst = null;
            function ganttDateType() {
                if (ganttScale === 'YEAR')    return 'year';
                if (ganttScale === 'QUARTER') return 'month';
                if (ganttScale === 'MONTH')   return 'month';
                return 'date';
            }
            function ganttDateValue(d) {
                var p = function (n) { return n < 10 ? '0' + n : '' + n; };
                if (ganttScale === 'YEAR')    return d.getFullYear() + '';
                if (ganttScale === 'QUARTER' || ganttScale === 'MONTH') return d.getFullYear() + '-' + p(d.getMonth() + 1);
                return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate());
            }
            function syncGanttDateInput() {
                $('#ganttDate').val(ganttDateValue(ganttCursor));
            }
            function rebuildGanttDatePicker() {
                if (__ganttDateInst && __ganttDateInst.config && __ganttDateInst.config.elem) {
                    try { __ganttDateInst.hint && __ganttDateInst.hint(''); } catch (e) {}
                }
                __ganttDateInst = laydate.render({
                    elem: '#ganttDate',
                    type: ganttDateType(),
                    trigger: 'click',
                    theme: '#1F4D3B',
                    value: ganttDateValue(ganttCursor),
                    done: function (value) {
                        if (!value) return;
                        var parsed;
                        if (ganttScale === 'YEAR') {
                            parsed = new Date(parseInt(value, 10), 0, 1);
                        } else if (ganttScale === 'QUARTER' || ganttScale === 'MONTH') {
                            var seg = value.split('-');
                            parsed = new Date(parseInt(seg[0], 10), parseInt(seg[1], 10) - 1, 1);
                        } else {
                            parsed = new Date(value.replace(/-/g, '/'));
                        }
                        if (!isNaN(parsed.getTime())) {
                            ganttCursor = parsed;
                            renderGantt();
                        }
                    }
                });
            }

            $('.gantt-scale').on('click', function () {
                $('.gantt-scale').addClass('layui-btn-primary');
                $(this).removeClass('layui-btn-primary');
                ganttScale = $(this).data('scale');
                rebuildGanttDatePicker();
                renderGantt();
            });
            $('.gantt-group').on('click', function () {
                $('.gantt-group').addClass('layui-btn-primary');
                $(this).removeClass('layui-btn-primary');
                ganttGroup = $(this).data('group');
                renderGantt();
            });
            $('#ganttPrev').on('click', function () { shiftGantt(-1); });
            $('#ganttNext').on('click', function () { shiftGantt(1); });
            $('#ganttToday').on('click', function () { ganttCursor = new Date(); syncGanttDateInput(); renderGantt(); });
            function shiftGantt(dir) {
                if (ganttScale === 'WEEK')    ganttCursor.setDate(ganttCursor.getDate() + dir * 7);
                if (ganttScale === 'MONTH')   ganttCursor.setMonth(ganttCursor.getMonth() + dir);
                if (ganttScale === 'QUARTER') ganttCursor.setMonth(ganttCursor.getMonth() + dir * 3);
                if (ganttScale === 'YEAR')    ganttCursor.setFullYear(ganttCursor.getFullYear() + dir);
                syncGanttDateInput();
                renderGantt();
            }

            function getGanttRange() {
                var s = new Date(ganttCursor), e = new Date(ganttCursor);
                if (ganttScale === 'WEEK')    { var diff = ((s.getDay() + 6) % 7); s.setDate(s.getDate() - diff); e = new Date(s); e.setDate(s.getDate() + 6); }
                if (ganttScale === 'MONTH')   { s = new Date(s.getFullYear(), s.getMonth(), 1); e = new Date(s.getFullYear(), s.getMonth() + 1, 0); }
                if (ganttScale === 'QUARTER') { var q = Math.floor(s.getMonth() / 3); s = new Date(s.getFullYear(), q * 3, 1); e = new Date(s.getFullYear(), q * 3 + 3, 0); }
                if (ganttScale === 'YEAR')    { s = new Date(s.getFullYear(), 0, 1); e = new Date(s.getFullYear(), 11, 31); }
                s.setHours(0, 0, 0, 0); e.setHours(23, 59, 59, 999);
                return { start: s, end: e };
            }

            function renderGantt() {
                var range = getGanttRange();
                var startMs = range.start.getTime(), endMs = range.end.getTime();
                var todayMs = (function () { var t = new Date(); t.setHours(0,0,0,0); return t.getTime(); })();
                $('#ganttRange').text(formatRangeLabel(range.start, range.end));

                // 跨格渲染：用单据的 [BeginDate, EndDate] 区间和当前可视窗口求交集
                var bills = allBills.filter(function (b) {
                    var s = new Date(b.BeginDate || b.beginDate || b.BillDate || b.billDate || 0).getTime();
                    var e = new Date(b.EndDate   || b.endDate   || b.BillDate || b.billDate || 0).getTime();
                    if (!s) return false;
                    if (!e || e < s) e = s + 86400000;
                    return e >= startMs && s <= endMs;
                });

                var groups = {};
                var groupOrder = [];
                bills.forEach(function (b) {
                    var fid = b.FacilityID != null && b.FacilityID !== '' ? b.FacilityID : (b.facilityID || '-');
                    var key = ganttGroup === 'facility'
                        ? ('\u8bbe\u5907 ' + fid)
                        : (b.BillNo || '\u65e0\u5355\u53f7');
                    if (!groups[key]) { groups[key] = []; groupOrder.push(key); }
                    groups[key].push(b);
                });

                // ===== 计算两层表头数据 =====
                var cells = [], majorSpans = [];
                var weekdayCN = ['\u65e5','\u4e00','\u4e8c','\u4e09','\u56db','\u4e94','\u516d'];
                if (ganttScale === 'WEEK' || ganttScale === 'MONTH') {
                    // minor = 每天；major = 月份聚合
                    var totalDays = Math.round((endMs - startMs) / 86400000) + 1;
                    var curMajor = null;
                    for (var i = 0; i < totalDays; i++) {
                        var d = new Date(startMs + i * 86400000);
                        var dow = d.getDay();
                        cells.push({
                            day: d.getDate(),
                            weekday: weekdayCN[dow],
                            isWeekend: dow === 0 || dow === 6,
                            isToday: d.getTime() === todayMs,
                            start: d.getTime(), end: d.getTime() + 86400000 - 1
                        });
                        var majKey = d.getFullYear() + '-' + (d.getMonth() + 1);
                        if (curMajor && curMajor.key === majKey) curMajor.span++;
                        else { curMajor = { key: majKey, label: d.getFullYear() + '\u5e74' + pad2(d.getMonth() + 1) + '\u6708', span: 1 }; majorSpans.push(curMajor); }
                    }
                } else if (ganttScale === 'QUARTER') {
                    // minor = 每周（周一起）；major = 月份聚合
                    var curMajor2 = null;
                    var cur = new Date(range.start);
                    var diff = ((cur.getDay() + 6) % 7);
                    cur.setDate(cur.getDate() - diff); // 对齐到周一
                    while (cur <= range.end) {
                        var ws = new Date(cur), we = new Date(cur); we.setDate(we.getDate() + 6);
                        if (we < range.start || ws > range.end) { cur.setDate(cur.getDate() + 7); continue; }
                        cells.push({
                            day: pad2(ws.getMonth() + 1) + '/' + pad2(ws.getDate()),
                            weekday: '',
                            isWeekend: false,
                            isToday: todayMs >= ws.getTime() && todayMs <= we.getTime() + 86399999,
                            start: ws.getTime(), end: we.getTime() + 86399999
                        });
                        var monthKey = ws.getFullYear() + '-' + (ws.getMonth() + 1);
                        if (curMajor2 && curMajor2.key === monthKey) curMajor2.span++;
                        else { curMajor2 = { key: monthKey, label: ws.getFullYear() + '\u5e74' + pad2(ws.getMonth() + 1) + '\u6708', span: 1 }; majorSpans.push(curMajor2); }
                        cur.setDate(cur.getDate() + 7);
                    }
                } else {
                    // YEAR: minor = 月份；major = 季度
                    var qNames = ['\u4e00\u5b63\u5ea6','\u4e8c\u5b63\u5ea6','\u4e09\u5b63\u5ea6','\u56db\u5b63\u5ea6'];
                    for (var q = 0; q < 4; q++) majorSpans.push({ label: range.start.getFullYear() + '\u5e74 ' + qNames[q], span: 3 });
                    for (var m = 0; m < 12; m++) {
                        var ms = new Date(range.start.getFullYear(), m, 1);
                        var me = new Date(range.start.getFullYear(), m + 1, 0);
                        cells.push({
                            day: (m + 1) + '\u6708',
                            weekday: '',
                            isWeekend: false,
                            isToday: todayMs >= ms.getTime() && todayMs <= me.getTime() + 86399999,
                            start: ms.getTime(), end: me.getTime() + 86399999
                        });
                    }
                }

                var labelW = 180;
                var cellW = ganttScale === 'YEAR' ? 90
                          : ganttScale === 'QUARTER' ? 70
                          : ganttScale === 'WEEK' ? 90
                          : 38;
                var totalW = labelW + cells.length * cellW;
                var rowH = 30;

                function layoutBars(arr) {
                    var sorted = arr.slice().sort(function (a, b) {
                        var sa = new Date(a.BeginDate || a.BillDate || 0).getTime();
                        var sb = new Date(b.BeginDate || b.BillDate || 0).getTime();
                        return sa - sb;
                    });
                    var lanes = [];
                    sorted.forEach(function (b) {
                        var s = new Date(b.BeginDate || b.BillDate || 0).getTime();
                        var e = new Date(b.EndDate   || b.BillDate || 0).getTime();
                        if (!e || e < s) e = s + 86400000;
                        var laneIdx = -1;
                        for (var i = 0; i < lanes.length; i++) {
                            if (s > lanes[i]) { laneIdx = i; break; }
                        }
                        if (laneIdx < 0) { laneIdx = lanes.length; lanes.push(e); }
                        else lanes[laneIdx] = e;
                        b.__lane = laneIdx;
                    });
                    return { items: sorted, lanes: Math.max(1, lanes.length) };
                }

                // ===== 构建 HTML =====
                var html = '<table style="width:' + totalW + 'px;table-layout:fixed;">';

                // 表头：major 行
                html += '<thead>';
                html += '<tr class="row-major">';
                html += '<th class="gantt-corner" rowspan="2" style="width:' + labelW + 'px;">'
                     + (ganttGroup === 'facility' ? '\u8bbe\u5907' : '\u4fdd\u517b\u5355') + '</th>';
                majorSpans.forEach(function (m) {
                    html += '<th colspan="' + m.span + '" style="width:' + (m.span * cellW) + 'px;">' + m.label + '</th>';
                });
                html += '</tr>';

                // 表头：minor 行
                html += '<tr class="row-minor">';
                cells.forEach(function (c) {
                    var cls = 'row-minor-cell';
                    if (c.isWeekend) cls += ' is-weekend';
                    if (c.isToday) cls += ' is-today';
                    html += '<th class="' + cls + '" style="width:' + cellW + 'px;">'
                          + '<div style="line-height:1.4;">' + c.day + '</div>'
                          + (c.weekday ? '<div style="font-size:10px;opacity:.75;">' + c.weekday + '</div>' : '')
                          + '</th>';
                });
                html += '</tr></thead><tbody>';

                if (groupOrder.length === 0) {
                    html += '<tr><td colspan="' + (cells.length + 1) + '" style="padding:32px;text-align:center;color:#94a3b8;background:#fff;">'
                          + '<i class="layui-icon layui-icon-face-cry" style="font-size:32px;display:block;margin-bottom:6px;opacity:.5;"></i>'
                          + '\u5f53\u524d\u533a\u95f4\u6682\u65e0\u4fdd\u517b\u5355\u636e</td></tr>';
                } else {
                    groupOrder.forEach(function (key) {
                        var layout = layoutBars(groups[key]);
                        var rowHeight = Math.max(rowH + 6, layout.lanes * rowH + 6);
                        html += '<tr style="height:' + rowHeight + 'px;">';
                        html += '<td class="gantt-label" style="width:' + labelW + 'px;">' + key
                             + ' <span style="color:#94a3b8;font-size:11px;font-weight:normal;">\u00d7' + layout.items.length + '</span></td>';
                        html += '<td class="gantt-track" colspan="' + cells.length + '" style="height:' + rowHeight + 'px;">';
                        html += '<div class="track-bg" style="position:relative;height:100%;width:' + (cells.length * cellW) + 'px;'
                             + 'background-image:linear-gradient(to right, #f1f5f9 0, #f1f5f9 1px, transparent 1px);background-size:' + cellW + 'px 100%;">';
                        // 周末浅灰背景列
                        cells.forEach(function (c, idx) {
                            if (c.isWeekend) {
                                html += '<div class="weekend-cell" style="left:' + (idx * cellW) + 'px;width:' + cellW + 'px;"></div>';
                            }
                        });
                        // 今日竖线
                        if (todayMs >= startMs && todayMs <= endMs) {
                            var todayLeft = ((todayMs - startMs) / (endMs - startMs)) * (cells.length * cellW);
                            html += '<div class="today-line" style="left:' + todayLeft + 'px;"></div>';
                        }
                        // bars
                        layout.items.forEach(function (b) {
                            var sid = b.Status != null ? b.Status : b.status;
                            var sn = parseInt(sid, 10); if (isNaN(sn)) sn = 0;
                            var s = new Date(b.BeginDate || b.BillDate || 0).getTime();
                            var e = new Date(b.EndDate   || b.BillDate || 0).getTime();
                            if (!e || e < s) e = s + 86400000;
                            var sClamp = Math.max(s, startMs);
                            var eClamp = Math.min(e, endMs);
                            var totalMs = endMs - startMs;
                            var leftPx = ((sClamp - startMs) / totalMs) * (cells.length * cellW);
                            var widthPx = Math.max(12, ((eClamp - sClamp) / totalMs) * (cells.length * cellW));
                            var topPx = b.__lane * rowH + 3;
                            var staffTxt = b.RepairStaff ? (' \u00b7 ' + (staffNameMap[b.RepairStaff] || b.RepairStaff)) : '';
                            html += '<div class="gantt-bar status-' + sn + '" data-id="' + rowId(b) + '" '
                                  + 'title="' + (b.BillNo || '') + ' \u00b7 ' + statusText(sn) + staffTxt + '\u000a' + fmtDate(b.BeginDate) + '  ~  ' + fmtDate(b.EndDate) + '" '
                                  + 'style="left:' + leftPx + 'px;width:' + widthPx + 'px;top:' + topPx + 'px;">'
                                  + '<span class="gb-icon"></span>'
                                  + (b.BillNo || '').replace(/^TPM0*/, 'TPM')
                                  + '</div>';
                        });
                        html += '</div></td></tr>';
                    });
                }
                html += '</tbody></table>';
                $('#ganttContainer').html(html);
                $('#ganttContainer .gantt-bar').on('click', function () {
                    var id = String($(this).attr('data-id'));
                    var row = allBills.find(function (b) { return String(rowId(b)) === id; });
                    if (row) openDetail(row, true);
                });
            }

            function formatRangeLabel(s, e) {
                var p = function (n) { return n < 10 ? '0' + n : '' + n; };
                if (ganttScale === 'YEAR') return s.getFullYear() + '\u5e74';
                if (ganttScale === 'QUARTER') return s.getFullYear() + '\u5e74 ' + ['\u4e00','\u4e8c','\u4e09','\u56db'][Math.floor(s.getMonth() / 3)] + '\u5b63\u5ea6';
                if (ganttScale === 'MONTH') return s.getFullYear() + '\u5e74' + p(s.getMonth() + 1) + '\u6708';
                // WEEK
                return s.getFullYear() + '-' + p(s.getMonth() + 1) + '-' + p(s.getDate())
                     + '   ~   ' + e.getFullYear() + '-' + p(e.getMonth() + 1) + '-' + p(e.getDate());
            }

            table.on('tool(GridMain)', function (obj) {
                if (obj.event === 'view') openDetail(obj.data, true);
                if (obj.event === 'edit') openDetail(obj.data, false);
                if (obj.event === 'dispatch') openDispatchDialog('single', { ids: [obj.data.Id], row: obj.data });
                if (obj.event === 'del') {
                    layer.confirm('\u786e\u8ba4\u5220\u9664\u8be5\u4fdd\u517b\u5355\uff08\u5df2\u6d3e\u5de5\u4e0d\u5141\u8bb8\u5220\u9664\uff09\uff1f', function (idx) {
                        $.post(URL_DELETE_BILL, { id: obj.data.Id }, function (res) {
                            layer.close(idx);
                            if (ok(res)) { obj.del(); toastOk('\u5220\u9664\u6210\u529f'); }
                            else toastErr(res.msg || '\u5220\u9664\u5931\u8d25');
                        });
                    });
                }
            });

            $('#btnBatchDispatch').on('click', function () {
                var chk = table.checkStatus('GridMain').data || [];
                if (chk.length === 0) { toastWarn('\u8bf7\u5148\u52fe\u9009\u8981\u6d3e\u5de5\u7684\u4fdd\u517b\u5355'); return; }
                var bad = chk.filter(function (r) { var s = parseInt(r.Status, 10) || 0; return s !== 0; });
                if (bad.length > 0) { toastErr('\u9009\u4e2d\u7684\u5355\u4e2d\u6709 ' + bad.length + ' \u5f20\u4e0d\u662f\u300c\u65b0\u5efa\u300d\u72b6\u6001\uff0c\u4e0d\u5141\u8bb8\u6d3e\u5de5'); return; }
                openDispatchDialog('batch', { ids: chk.map(function (r) { return r.Id; }) });
            });

            function nowStr() {
                var d = new Date(), p = function (n) { return n < 10 ? '0' + n : '' + n; };
                return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds());
            }

            var __dispState = { selected: null };
            function openDispatchDialog(mode, payload) {
                __dispState = { selected: null };
                layer.open({
                    type: 1,
                    title: mode === 'batch' ? '\u6279\u91cf\u6d3e\u5de5 (' + payload.ids.length + ' \u5f20)' : ('\u6d3e\u5de5 ' + ((payload.row && payload.row.BillNo) || '')),
                    area: ['860px', '580px'],
                    content: $('#tplDispatch').html(),
                    btn: ['\u786e\u8ba4\u6d3e\u5de5', '\u53d6\u6d88'],
                    success: function () {
                        if (mode === 'batch') {
                            $('#dispBatchHint').show().text('\u6279\u91cf\u6d3e\u5de5\uff1a\u9009\u4e2d\u7684 ' + payload.ids.length + ' \u5f20\u5355\u4f1a\u88ab\u6307\u5b9a\u7ed9\u540c\u4e00\u4f4d\u5458\u5de5');
                        }
                        laydate.render({ elem: '#disp_DispatchDate', type: 'datetime', value: nowStr() });
                        laydate.render({ elem: '#disp_BeginDate', type: 'datetime' });
                        laydate.render({ elem: '#disp_EndDate', type: 'datetime' });
                        // 单据派工时如果已知 BeginDate/EndDate，回填
                        if (mode === 'single' && payload.row) {
                            if (payload.row.BeginDate) $('#disp_BeginDate').val(fmtDate(payload.row.BeginDate));
                            if (payload.row.EndDate)   $('#disp_EndDate').val(fmtDate(payload.row.EndDate));
                        }
                        renderDispEmpGrid();
                        $('#btnDispSearch').on('click', renderDispEmpGrid);
                        $('#dispKw').on('keydown', function (e) { if (e.keyCode === 13) renderDispEmpGrid(); });
                    },
                    yes: function (idx) {
                        if (!__dispState.selected) { toastWarn('\u8bf7\u5728\u5217\u8868\u4e2d\u70b9\u51fb\u9009\u4e2d\u88ab\u6d3e\u5458\u5de5'); return; }
                        var repairStaff = __dispState.selected.EmployeeNumber || __dispState.selected.Name;
                        var common = {
                            repairStaff: repairStaff,
                            dispatchDate: $('#disp_DispatchDate').val() || '',
                            beginDate: $('#disp_BeginDate').val() || '',
                            endDate: $('#disp_EndDate').val() || '',
                            dispatchRemark: $('#disp_Remark').val() || ''
                        };
                        if (mode === 'batch') {
                            var data = Object.assign({}, common, {});
                            // 数组要按 key=val&key=val 提交
                            var fd = new FormData();
                            payload.ids.forEach(function (id) { fd.append('ids', id); });
                            Object.keys(common).forEach(function (k) { fd.append(k, common[k]); });
                            $.ajax({ url: URL_BATCH_DISPATCH, type: 'POST', data: fd, processData: false, contentType: false })
                                .done(function (res) {
                                    if (ok(res)) { layer.close(idx); toastOk(res.msg); refreshCurrentView(); }
                                    else toastErr(res.msg || '\u6279\u91cf\u6d3e\u5de5\u5931\u8d25');
                                });
                        } else {
                            $.post(URL_DISPATCH, Object.assign({ id: payload.ids[0] }, common), function (res) {
                                if (ok(res)) { layer.close(idx); toastOk('\u6d3e\u5de5\u6210\u529f'); refreshCurrentView(); }
                                else toastErr(res.msg || '\u6d3e\u5de5\u5931\u8d25');
                            });
                        }
                    }
                });
            }

            function renderDispEmpGrid() {
                table.render({
                    elem: '#GridDispEmp',
                    id: 'GridDispEmp',
                    url: URL_EMPLOYEES,
                    method: 'get',
                    where: { kw: $('#dispKw').val() || '' },
                    page: false,
                    height: 320,
                    cols: [[
                        { field: 'EmployeeNumber', title: '\u5de5\u53f7', width: 110 },
                        { field: 'Name', title: '\u59d3\u540d', width: 120 },
                        { field: 'DeptName', title: '\u90e8\u95e8', width: 160 },
                        { field: 'PendingCount', title: '\u5f53\u524d\u5f85\u529e\u4fdd\u517b', width: 130, templet: function (d) {
                            var c = parseInt(d.PendingCount, 10) || 0;
                            if (c === 0) return '<span style="color:#888;">0</span>';
                            if (c >= 3) return '<span class="layui-badge" style="background:#dc2626;">' + c + '</span>';
                            return '<span class="layui-badge layui-bg-orange">' + c + '</span>';
                        } }
                    ]],
                    done: function () {
                        if (__dispState.selected) {
                            // 重渲染后保留高亮
                            $('#GridDispEmp').next('.layui-table-view').find('tbody tr').each(function () {
                                var name = $(this).find('td[data-field=EmployeeNumber] div').text();
                                if (name === __dispState.selected.EmployeeNumber) $(this).addClass('layui-table-click');
                            });
                        }
                    }
                });
            }

            // 行点击选中（layui table 内置事件）
            table.on('row(GridDispEmp)', function (obj) {
                __dispState.selected = obj.data;
                obj.tr.addClass('layui-table-click').siblings().removeClass('layui-table-click');
            });

            function formatToday() {
                var d = new Date();
                var pad = function (n) { return n < 10 ? '0' + n : '' + n; };
                return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
            }

            loadStaffMap();
            renderList();
            form.render();
        });
    </script>
}
