@{
    ViewData["Title"] = "\u8bbe\u5907\u4fdd\u517b\u5355\u5217\u8868";
}
<div class="layui-fluid" style="padding:12px;">
    <div class="layui-card">
        <div class="layui-card-header">
            <strong>@("\u8bbe\u5907\u4fdd\u517b\u5355\u5217\u8868")</strong>
            <span class="layui-btn-group" style="float:right;">
                <button class="layui-btn layui-btn-sm" id="btnViewList"><i class="layui-icon layui-icon-list"></i> @("\u5217\u8868")</button>
                <button class="layui-btn layui-btn-sm layui-btn-primary" id="btnViewKanban"><i class="layui-icon layui-icon-template-1"></i> @("\u72b6\u6001\u770b\u677f")</button>
                <button class="layui-btn layui-btn-sm layui-btn-primary" id="btnViewCalendar"><i class="layui-icon layui-icon-date"></i> @("\u65e5\u5386")</button>
                <button class="layui-btn layui-btn-sm layui-btn-primary" id="btnViewGantt"><i class="layui-icon layui-icon-chart"></i> @("\u7518\u7279\u56fe")</button>
            </span>
        </div>
        <div class="layui-card-body">
            <div class="layui-form layui-row layui-col-space10" style="margin-bottom:8px;">
                <div class="layui-col-md4">
                    <input type="text" id="kw" class="layui-input" placeholder="@("\u8f93\u5165\u5355\u53f7/\u8bbe\u5907\u7f16\u7801/\u8bbe\u5907\u540d\u79f0\u67e5\u8be2")">
                </div>
                <div class="layui-col-md4" id="statusPills">
                    <button class="layui-btn layui-btn-sm" data-status="">@("\u5168\u90e8")</button>
                    <button class="layui-btn layui-btn-sm layui-btn-primary" data-status="0">@("\u65b0\u5efa")</button>
                    <button class="layui-btn layui-btn-sm layui-btn-primary" data-status="1">@("\u5df2\u6d3e\u5de5")</button>
                    <button class="layui-btn layui-btn-sm layui-btn-primary" data-status="2">@("\u4fdd\u517b\u4e2d")</button>
                    <button class="layui-btn layui-btn-sm layui-btn-primary" data-status="3">@("\u5df2\u4fdd\u517b")</button>
                    <button class="layui-btn layui-btn-sm layui-btn-primary" data-status="4">@("\u5df2\u5ba1\u6838")</button>
                </div>
                <div class="layui-col-md4" style="text-align:right;">
                    <button class="layui-btn layui-btn-sm" id="btnPlan"><i class="layui-icon layui-icon-add-1"></i> @("\u5efa\u7acb\u4fdd\u517b\u8ba1\u5212")</button>
                    <button class="layui-btn layui-btn-sm layui-btn-primary" id="btnReload"><i class="layui-icon layui-icon-refresh-3"></i> @("\u5237\u65b0")</button>
                </div>
            </div>

            <div id="paneList">
                <table id="GridMain" lay-filter="GridMain"></table>
            </div>

            <div id="paneKanban" style="display:none;">
                <div id="kanbanBoard" style="display:flex;gap:10px;overflow-x:auto;align-items:flex-start;min-height:520px;"></div>
            </div>

            <div id="paneCalendar" style="display:none;">
                <div style="margin-bottom:8px;display:flex;align-items:center;gap:8px;">
                    <button class="layui-btn layui-btn-sm layui-btn-primary" id="calPrev"><i class="layui-icon layui-icon-left"></i></button>
                    <span id="calTitle" style="font-size:16px;font-weight:600;min-width:120px;text-align:center;"></span>
                    <button class="layui-btn layui-btn-sm layui-btn-primary" id="calNext"><i class="layui-icon layui-icon-right"></i></button>
                    <button class="layui-btn layui-btn-sm" id="calToday">@("\u4eca\u65e5")</button>
                </div>
                <table id="calGrid" style="width:100%;border-collapse:collapse;table-layout:fixed;">
                    <thead>
                        <tr style="background:#f5f5f5;">
                            <th style="padding:6px;border:1px solid #e2e8f0;width:14.28%;">@("\u5468\u65e5")</th>
                            <th style="padding:6px;border:1px solid #e2e8f0;width:14.28%;">@("\u5468\u4e00")</th>
                            <th style="padding:6px;border:1px solid #e2e8f0;width:14.28%;">@("\u5468\u4e8c")</th>
                            <th style="padding:6px;border:1px solid #e2e8f0;width:14.28%;">@("\u5468\u4e09")</th>
                            <th style="padding:6px;border:1px solid #e2e8f0;width:14.28%;">@("\u5468\u56db")</th>
                            <th style="padding:6px;border:1px solid #e2e8f0;width:14.28%;">@("\u5468\u4e94")</th>
                            <th style="padding:6px;border:1px solid #e2e8f0;width:14.28%;">@("\u5468\u516d")</th>
                        </tr>
                    </thead>
                    <tbody id="calBody"></tbody>
                </table>
            </div>

            <div id="paneGantt" style="display:none;">
                <div style="margin-bottom:8px;display:flex;align-items:center;gap:8px;">
                    <span>@("\u65f6\u95f4\u7c92\u5ea6")</span>
                    <button class="layui-btn layui-btn-sm gantt-scale" data-scale="WEEK">@("\u5468")</button>
                    <button class="layui-btn layui-btn-sm layui-btn-primary gantt-scale" data-scale="MONTH">@("\u6708")</button>
                    <button class="layui-btn layui-btn-sm layui-btn-primary gantt-scale" data-scale="QUARTER">@("\u5b63")</button>
                    <button class="layui-btn layui-btn-sm layui-btn-primary gantt-scale" data-scale="YEAR">@("\u5e74")</button>
                    <span style="margin-left:16px;">@("\u5206\u7ec4")</span>
                    <button class="layui-btn layui-btn-sm gantt-group" data-group="bill">@("\u6309\u4fdd\u517b\u5355")</button>
                    <button class="layui-btn layui-btn-sm layui-btn-primary gantt-group" data-group="facility">@("\u6309\u8bbe\u5907")</button>
                    <button class="layui-btn layui-btn-sm layui-btn-primary" id="ganttPrev" style="margin-left:16px;"><i class="layui-icon layui-icon-left"></i></button>
                    <span id="ganttRange" style="font-weight:600;min-width:200px;text-align:center;"></span>
                    <button class="layui-btn layui-btn-sm layui-btn-primary" id="ganttNext"><i class="layui-icon layui-icon-right"></i></button>
                </div>
                <div id="ganttContainer" style="overflow:auto;max-height:560px;border:1px solid #e2e8f0;"></div>
            </div>
        </div>
    </div>
</div>

<script type="text/html" id="barRow">
    <a class="layui-btn layui-btn-xs" lay-event="view">&#x67e5;&#x770b;</a>
    {{# if(d.Status == 0 || d.Status == null){ }}
    <a class="layui-btn layui-btn-xs layui-btn-normal" lay-event="edit">&#x7f16;&#x8f91;</a>
    <a class="layui-btn layui-btn-xs layui-btn-danger" lay-event="del">&#x5220;&#x9664;</a>
    {{# } }}
</script>

<script type="text/html" id="tplBillDetail">
    <div style="padding:14px;">
        <form class="layui-form" lay-filter="billForm">
            <input type="hidden" name="Id">
            <input type="hidden" name="MaintainType">
            <input type="hidden" name="Status">
            <input type="hidden" name="FacilityID">
            <input type="hidden" name="TempID">
            <input type="hidden" name="BillNo">
            <div class="layui-form-item">
                <div class="layui-inline">
                    <label class="layui-form-label">&#x4fdd;&#x517b;&#x5355;&#x53f7;</label>
                    <div class="layui-input-inline" style="padding-top:8px;"><span id="fld_BillNoText"></span></div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label">&#x4fdd;&#x517b;&#x7c7b;&#x578b;</label>
                    <div class="layui-input-inline" style="padding-top:8px;"><span id="fld_MaintainTypeText"></span></div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label">&#x72b6;&#x6001;</label>
                    <div class="layui-input-inline" style="padding-top:8px;"><span id="fld_StatusText"></span></div>
                </div>
            </div>
            <div class="layui-form-item">
                <div class="layui-inline">
                    <label class="layui-form-label">&#x8ba1;&#x5212;&#x65e5;&#x671f;</label>
                    <div class="layui-input-inline"><input name="BillDate" class="layui-input" id="fld_BillDate"></div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label">&#x5f00;&#x59cb;&#x65f6;&#x95f4;</label>
                    <div class="layui-input-inline"><input name="BeginDate" class="layui-input" id="fld_BeginDate"></div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label">&#x7ed3;&#x675f;&#x65f6;&#x95f4;</label>
                    <div class="layui-input-inline"><input name="EndDate" class="layui-input" id="fld_EndDate"></div>
                </div>
            </div>
            <div class="layui-form-item">
                <div class="layui-inline">
                    <label class="layui-form-label">&#x4fdd;&#x517b;&#x4eba;</label>
                    <div class="layui-input-inline"><input name="RepairStaff" class="layui-input"></div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label">&#x91d1;&#x989d;</label>
                    <div class="layui-input-inline"><input name="Amount" type="number" step="0.01" class="layui-input"></div>
                </div>
            </div>
            <div class="layui-form-item">
                <label class="layui-form-label">&#x5907;&#x6ce8;</label>
                <div class="layui-input-block"><input name="Remark" class="layui-input"></div>
            </div>
        </form>
        <div style="margin:8px 0 4px;font-weight:600;">&#x4fdd;&#x517b;&#x9879;&#x76ee;&#x660e;&#x7ec6;</div>
        <table id="GridBillSub" lay-filter="GridBillSub"></table>
        <div style="margin:14px 0 4px;font-weight:600;">附件</div>
        <div id="maintAttachPanel"></div>
    </div>
</script>

<script type="text/html" id="tplPlan">
    <div style="padding:14px;">
        <form class="layui-form layui-row layui-col-space10" lay-filter="planForm">
            <div class="layui-col-md3">
                <label class="layui-form-label">&#x4fdd;&#x517b;&#x7c7b;&#x578b;</label>
                <div class="layui-input-block">
                    <select id="planCycle" name="planCycle" lay-filter="planCycleSel">
                        <option value="MONTH">&#x6708;</option>
                        <option value="QUARTER">&#x5b63;&#x5ea6;</option>
                        <option value="WEEK">&#x5468;</option>
                        <option value="YEAR">&#x5e74;</option>
                    </select>
                </div>
            </div>
            <div class="layui-col-md2">
                <label class="layui-form-label">&#x751f;&#x6210;&#x6b21;&#x6570;</label>
                <div class="layui-input-block">
                    <input id="planCount" type="number" value="1" min="1" class="layui-input">
                </div>
            </div>
            <div class="layui-col-md3">
                <label class="layui-form-label">&#x5f00;&#x59cb;&#x65e5;&#x671f;</label>
                <div class="layui-input-block"><input id="planStartDate" class="layui-input"></div>
            </div>
            <div class="layui-col-md4" style="text-align:right;padding-top:24px;">
                <button type="button" class="layui-btn layui-btn-sm" id="btnPickDevices"><i class="layui-icon layui-icon-add-1"></i> &#x9009;&#x62e9;&#x8bbe;&#x5907;</button>
                <button type="button" class="layui-btn layui-btn-sm layui-btn-warm" id="btnRefreshStatus"><i class="layui-icon layui-icon-refresh-3"></i> &#x5237;&#x65b0;&#x72b6;&#x6001;</button>
            </div>
        </form>
        <div style="margin:8px 0 4px;font-weight:600;">&#x5df2;&#x9009;&#x8bbe;&#x5907;&#xff08;&#x7ea2;&#x8272;&#x3d;&#x672a;&#x914d;&#x7f6e;&#x8be5;&#x4fdd;&#x517b;&#x7c7b;&#x578b;&#x6a21;&#x677f;&#xff0c;&#x4e0d;&#x5141;&#x8bb8;&#x751f;&#x6210;&#xff09;</div>
        <table id="GridPlanDevices" lay-filter="GridPlanDevices"></table>
    </div>
</script>

<script type="text/html" id="tplPickDevices">
    <div style="padding:14px;">
        <div class="layui-form layui-row layui-col-space10" style="margin-bottom:8px;">
            <div class="layui-col-md6">
                <input type="text" id="pickKw" class="layui-input" placeholder="&#x8f93;&#x5165;&#x8bbe;&#x5907;&#x7f16;&#x7801; / &#x540d;&#x79f0; / &#x578b;&#x53f7;&#x67e5;&#x8be2;">
            </div>
            <div class="layui-col-md6" style="text-align:right;">
                <button type="button" class="layui-btn layui-btn-sm" id="btnPickSearch"><i class="layui-icon layui-icon-search"></i> &#x67e5;&#x8be2;</button>
            </div>
        </div>
        <table id="GridPickDevices" lay-filter="GridPickDevices"></table>
    </div>
</script>

@section Script{
    <script>
        var URL_MAIN_LIST       = '@Url.Action("GetMainList")';
        var URL_BILL_DETAIL     = '@Url.Action("GetBillDetail")';
        var URL_UPDATE_BILL     = '@Url.Action("UpdateBill")';
        var URL_DELETE_BILL     = '@Url.Action("DeleteBill")';
        var URL_BATCH_GENERATE  = '@Url.Action("BatchGenerate")';
        var URL_CHECK_TEMPLATES = '@Url.Action("CheckTemplates")';
        var URL_PLAN_DEVICES    = '@Url.Action("GetPlanDevices")';

        layui.use(['table', 'form', 'layer', 'laydate'], function () {
            var table = layui.table, form = layui.form, layer = layui.layer, laydate = layui.laydate;
            function ok(res) { return res && (res.code === 0 || res.code === 200); }
            function toast(msg) { layer.msg(msg || ''); }
            function toastOk(msg) { layer.msg(msg || '\u64cd\u4f5c\u6210\u529f', { icon: 1 }); }
            function toastErr(msg) { layer.msg(msg || '\u64cd\u4f5c\u5931\u8d25', { icon: 2 }); }
            function toastWarn(msg) { layer.msg(msg || '', { icon: 0 }); }
            function fmtDate(s) { return s ? (s + '').replace('T', ' ').substring(0, 19) : ''; }
            function statusText(s) { return ({0:'\u65b0\u5efa',1:'\u5df2\u6d3e\u5de5',2:'\u4fdd\u517b\u4e2d',3:'\u5df2\u4fdd\u517b',4:'\u5df2\u5ba1\u6838'})[s] || (s + ''); }
            function cycleText(c) { c = (c||'').toUpperCase(); return ({YEAR:'\u5e74',QUARTER:'\u5b63\u5ea6',MONTH:'\u6708',WEEK:'\u5468'})[c] || c; }

            function billMaintainTypeCell(d) {
                var raw = d.MaintainType != null && d.MaintainType !== '' ? d.MaintainType : (d.maintainType || '');
                return '<span>' + cycleText(String(raw).toUpperCase()) + '</span>';
            }
            function billStatusCell(d) {
                var s = d.Status != null ? d.Status : d.status;
                var n = parseInt(s, 10);
                if (isNaN(n)) n = 0;
                var colors = { 0: '#f7b500', 1: '#1e88e5', 2: '#7c3aed', 3: '#16a34a', 4: '#475569' };
                var bg = colors[n] != null ? colors[n] : '#999';
                return '<span class="layui-badge" style="background-color:' + bg + ';">' + statusText(n) + '</span>';
            }

            /** Layui/JSON may use camelCase; template columns use PascalCase */
            function rowField(obj, name) {
                if (!obj || typeof obj !== 'object') return '';
                var v = obj[name];
                if (v !== undefined && v !== null && String(v) !== '') return v;
                var camel = name.charAt(0).toLowerCase() + name.slice(1);
                v = obj[camel];
                if (v !== undefined && v !== null && String(v) !== '') return v;
                return '';
            }
            function rowId(obj) {
                if (!obj) return 0;
                if (obj.Id !== undefined && obj.Id !== null) return obj.Id;
                if (obj.id !== undefined && obj.id !== null) return obj.id;
                return 0;
            }
            function syncPlanCycleFromDom() {
                var v = ($('#planCycle').val() || planState.cycle || 'MONTH').toString().trim().toUpperCase();
                if (v !== 'MONTH' && v !== 'QUARTER' && v !== 'WEEK' && v !== 'YEAR') v = 'MONTH';
                planState.cycle = v;
            }

            var currentStatus = '';
            var planState = { cycle: 'MONTH', count: 1, startDate: '', devices: [] };

            function getWhere() {
                var list = [];
                var kw = $('#kw').val();
                if (kw) list.push({ field: 'BillNo', conditional: 'like', value: kw });
                if (currentStatus !== '') list.push({ field: 'Status', conditional: 'eq', value: currentStatus });
                return { page: 1, limit: 20, searchParam: list };
            }

            function renderList() {
                table.render({
                    elem: '#GridMain',
                    id: 'GridMain',
                    url: URL_MAIN_LIST,
                    method: 'post',
                    where: getWhere(),
                    page: true,
                    height: 'full-260',
                    cols: [[
                        { type: 'numbers', title: '#' },
                        { field: 'BillNo', title: '\u4fdd\u517b\u5355\u53f7', width: 160 },
                        { field: 'FacilityID', title: '\u8bbe\u5907ID', width: 110 },
                        { field: 'MaintainType', title: '\u4fdd\u517b\u7c7b\u578b', width: 100, templet: billMaintainTypeCell },
                        { field: 'BillDate', title: '\u8ba1\u5212\u65e5\u671f', width: 160, templet: function (d) { return fmtDate(d.BillDate); } },
                        { field: 'BeginDate', title: '\u5f00\u59cb\u65f6\u95f4', width: 160, templet: function (d) { return fmtDate(d.BeginDate); } },
                        { field: 'EndDate', title: '\u7ed3\u675f\u65f6\u95f4', width: 160, templet: function (d) { return fmtDate(d.EndDate); } },
                        { field: 'Status', title: '\u72b6\u6001', width: 100, templet: billStatusCell },
                        { field: 'RepairStaff', title: '\u4fdd\u517b\u4eba', width: 110 },
                        { field: 'Remark', title: '\u5907\u6ce8', minWidth: 160 },
                        { title: '\u64cd\u4f5c', width: 200, toolbar: '#barRow', fixed: 'right' }
                    ]]
                });
            }

            function openDetail(row, readOnly) {
                layer.open({
                    type: 1,
                    area: ['1000px', '680px'],
                    title: (readOnly ? '\u67e5\u770b' : '\u7f16\u8f91') + ' \u4fdd\u517b\u5355 ' + (row.BillNo || ''),
                    content: $('#tplBillDetail').html(),
                    btn: readOnly ? ['\u5173\u95ed'] : ['\u4fdd\u5b58', '\u5173\u95ed'],
                    success: function () {
                        form.render();
                        laydate.render({ elem: '#fld_BillDate', type: 'datetime' });
                        laydate.render({ elem: '#fld_BeginDate', type: 'datetime' });
                        laydate.render({ elem: '#fld_EndDate', type: 'datetime' });
                        $.get(URL_BILL_DETAIL, { id: row.Id }, function (res) {
                            if (!ok(res) || !res.data) { toastErr(res.msg || '\u52a0\u8f7d\u5931\u8d25'); return; }
                            var m = res.data.Main || {};
                            var rawCycle = (m.MaintainType || '').toUpperCase();
                            var rawStatus = m.Status == null ? 0 : m.Status;
                            m.BillDate = fmtDate(m.BillDate);
                            m.BeginDate = fmtDate(m.BeginDate);
                            m.EndDate = fmtDate(m.EndDate);
                            m.MaintainType = rawCycle;
                            form.val('billForm', m);
                            $('#fld_BillNoText').text(m.BillNo || '');
                            $('#fld_MaintainTypeText').text(cycleText(rawCycle));
                            $('#fld_StatusText').text(statusText(rawStatus));
                            if (readOnly) {
                                $('form[lay-filter=billForm] input').attr('readonly', true).attr('disabled', true);
                            }
                            table.render({
                                elem: '#GridBillSub',
                                data: res.data.Subs || [],
                                page: false,
                                cols: [[
                                    { type: 'numbers', title: '#' },
                                    { field: 'Project', title: '\u4fdd\u517b\u9879\u76ee', minWidth: 160 },
                                    { field: 'UpkeepMethod', title: '\u4fdd\u517b\u65b9\u6cd5', minWidth: 180 },
                                    { field: 'CheckMethod', title: '\u6807\u51c6\u63cf\u8ff0', minWidth: 160 },
                                    { field: 'MinValue', title: '\u6700\u5c0f\u503c', width: 80 },
                                    { field: 'MaxValue', title: '\u6700\u5927\u503c', width: 80 },
                                    { field: 'Result', title: '\u4fdd\u517b\u7ed3\u679c', width: 120 },
                                    { field: 'Remark', title: '\u5907\u6ce8', minWidth: 120 }
                                ]]
                            });
                            try { if (window.AttachmentWidget && row.Id) AttachmentWidget.mount({ container: '#maintAttachPanel', businessType: 'maintain', businessId: row.Id, readonly: readOnly }); } catch (e) {}
                        });
                    },
                    yes: function (idx) {
                        if (readOnly) { layer.close(idx); return; }
                        var data = form.val('billForm');
                        $.post(URL_UPDATE_BILL, data, function (res) {
                            if (ok(res)) {
                                layer.close(idx);
                                table.reload('GridMain');
                                toastOk('\u4fdd\u5b58\u6210\u529f');
                            } else toastErr(res.msg || '\u4fdd\u5b58\u5931\u8d25');
                        });
                    }
                });
            }

            function openPlanDialog() {
                planState = { cycle: 'MONTH', count: 1, startDate: formatToday(), devices: [] };
                layer.open({
                    type: 1,
                    area: ['1100px', '680px'],
                    title: '\u5efa\u7acb\u4fdd\u517b\u8ba1\u5212',
                    content: $('#tplPlan').html(),
                    btn: ['\u786e\u8ba4\u751f\u6210', '\u5173\u95ed'],
                    success: function () {
                        form.render();
                        laydate.render({ elem: '#planStartDate', value: planState.startDate });
                        syncPlanCycleFromDom();
                        $('#planCount').on('change', function () { planState.count = parseInt($(this).val(), 10) || 1; });
                        $('#planStartDate').on('blur', function () { planState.startDate = $(this).val(); });
                        $('#btnPickDevices').on('click', openPickDevices);
                        $('#btnRefreshStatus').on('click', refreshPlanGrid);
                        renderPlanGrid();
                    },
                    yes: function (idx) {
                        if (planState.devices.length === 0) { toastWarn('\u8bf7\u5148\u9009\u62e9\u8bbe\u5907'); return; }
                        var missing = planState.devices.filter(function (d) { return !d.HasTemplate; });
                        if (missing.length > 0) { toastErr('\u6709\u672a\u914d\u7f6e\u6a21\u677f\u7684\u8bbe\u5907\uff0c\u4e0d\u5141\u8bb8\u751f\u6210\uff0c\u8bf7\u5148\u53bb\u6a21\u677f\u91cc\u914d\u7f6e'); return; }
                        $.post(URL_BATCH_GENERATE, {
                            deviceIds: planState.devices.map(function (d) { return d.Id; }),
                            cycle: planState.cycle,
                            count: planState.count,
                            startDate: planState.startDate
                        }, function (res) {
                            if (ok(res)) {
                                layer.close(idx);
                                table.reload('GridMain');
                                toastOk(res.msg || '\u5df2\u751f\u6210');
                            } else toastErr(res.msg || '\u751f\u6210\u5931\u8d25');
                        });
                    }
                });
            }

            function renderPlanGrid() {
                syncPlanCycleFromDom();
                table.render({
                    elem: '#GridPlanDevices',
                    id: 'GridPlanDevices',
                    data: planState.devices,
                    page: false,
                    height: 380,
                    cols: [[
                        { field: 'FacilityCode', title: '\u8bbe\u5907\u7f16\u7801', width: 140 },
                        { field: 'FacilityName', title: '\u8bbe\u5907\u540d\u79f0', minWidth: 160 },
                        { field: 'Model', title: '\u8bbe\u5907\u578b\u53f7', width: 130 },
                        { field: 'WeekTempName', title: '\u5468\u4fdd\u517b\u6a21\u677f', width: 150, templet: tplCellTemplet('WeekTempName') },
                        { field: 'MonthTempName', title: '\u6708\u4fdd\u517b\u6a21\u677f', width: 150, templet: tplCellTemplet('MonthTempName') },
                        { field: 'SeasonTempName', title: '\u5b63\u5ea6\u4fdd\u517b\u6a21\u677f', width: 150, templet: tplCellTemplet('SeasonTempName') },
                        { field: 'HalfYearTempName', title: '\u534a\u5e74\u4fdd\u517b\u6a21\u677f', width: 150, templet: function (d) { return rowField(d, 'HalfYearTempName'); } },
                        { field: 'YearTempName', title: '\u5e74\u4fdd\u517b\u6a21\u677f', width: 150, templet: tplCellTemplet('YearTempName') },
                        { field: 'HasTemplate', title: '\u5f53\u524d\u5468\u671f', width: 110, templet: function (d) {
                            return d.HasTemplate
                                ? '<span class="layui-badge layui-bg-green">\u5df2\u914d\u7f6e</span>'
                                : '<span class="layui-badge">\u672a\u914d\u7f6e</span>';
                        } },
                        { title: '\u64cd\u4f5c', width: 80, templet: function (d) {
                            return '<a class="layui-btn layui-btn-xs layui-btn-danger" onclick="window.__removePlanDev(' + d.Id + ')">\u79fb\u9664</a>';
                        } }
                    ]],
                    done: function () { highlightMissingRows(); }
                });
            }

            function tplCellTemplet(field) {
                return function (d) {
                    var current = planState.cycle === 'MONTH' ? 'MonthTempName'
                                : planState.cycle === 'QUARTER' ? 'SeasonTempName'
                                : planState.cycle === 'WEEK' ? 'WeekTempName'
                                : 'YearTempName';
                    var v = rowField(d, field);
                    if (field === current && !v) return '<span style="color:#e53935;">\u672a\u914d\u7f6e</span>';
                    return v;
                };
            }

            function highlightMissingRows() {
                $('#GridPlanDevices').next('.layui-table-view').find('tbody tr').each(function (i) {
                    var row = planState.devices[i];
                    if (row && !row.HasTemplate) $(this).css('background-color', '#fde8e8');
                    else $(this).css('background-color', '');
                });
            }

            window.__removePlanDev = function (id) {
                planState.devices = planState.devices.filter(function (d) { return d.Id !== id; });
                renderPlanGrid();
            };

            function refreshPlanGrid() {
                if (planState.devices.length === 0) { renderPlanGrid(); return; }
                var ids = planState.devices.map(function (d) { return d.Id; });
                $.post(URL_CHECK_TEMPLATES, { 'deviceIds[]': ids, cycle: planState.cycle }, function (res) {
                    if (ok(res) && res.data) {
                        var byId = {};
                        res.data.forEach(function (s) {
                            var did = s.DeviceId != null ? s.DeviceId : s.deviceId;
                            if (did != null) byId[did] = s;
                        });
                        planState.devices.forEach(function (d) {
                            var did = rowId(d);
                            var s = byId[did];
                            d.HasTemplate = s ? (s.HasTemplate === true || s.HasTemplate === 1 || s.hasTemplate === true) : false;
                            d.TempId = s ? (s.TempId != null ? s.TempId : s.tempId) : null;
                        });
                        renderPlanGrid();
                    }
                });
            }

            function openPickDevices() {
                var picked = {};
                planState.devices.forEach(function (d) { picked[rowId(d)] = true; });
                layer.open({
                    type: 1,
                    area: ['1100px', '600px'],
                    title: '\u9009\u62e9\u8bbe\u5907',
                    content: $('#tplPickDevices').html(),
                    btn: ['\u786e\u8ba4\u6dfb\u52a0', '\u5173\u95ed'],
                    success: function () {
                        renderPickGrid();
                        $('#btnPickSearch').on('click', function () { table.reload('GridPickDevices', { where: getPickWhere() }); });
                        $('#pickKw').on('keydown', function (e) { if (e.keyCode === 13) $('#btnPickSearch').click(); });
                    },
                    yes: function (idx) {
                        var check = table.checkStatus('GridPickDevices').data || [];
                        if (check.length === 0) { toastWarn('\u8bf7\u52fe\u9009\u8bbe\u5907'); return; }
                        check.forEach(function (row) {
                            var rid = rowId(row);
                            if (!picked[rid]) {
                                planState.devices.push({
                                    Id: rid,
                                    FacilityCode: rowField(row, 'FacilityCode'),
                                    FacilityName: rowField(row, 'FacilityName'),
                                    Model: rowField(row, 'Model'),
                                    WeekTempName: rowField(row, 'WeekTempName'),
                                    MonthTempName: rowField(row, 'MonthTempName'),
                                    SeasonTempName: rowField(row, 'SeasonTempName'),
                                    HalfYearTempName: rowField(row, 'HalfYearTempName'),
                                    YearTempName: rowField(row, 'YearTempName'),
                                    HasTemplate: false,
                                    TempId: null
                                });
                                picked[rid] = true;
                            }
                        });
                        layer.close(idx);
                        refreshPlanGrid();
                    }
                });
            }

            function getPickWhere() {
                var list = [];
                var kw = $('#pickKw').val();
                if (kw) list.push({ field: 'FacilityName', conditional: 'like', value: kw });
                return { page: 1, limit: 20, searchParam: list };
            }

            function renderPickGrid() {
                table.render({
                    elem: '#GridPickDevices',
                    id: 'GridPickDevices',
                    url: URL_PLAN_DEVICES,
                    method: 'post',
                    where: getPickWhere(),
                    page: true,
                    height: 440,
                    cols: [[
                        { type: 'checkbox' },
                        { field: 'FacilityCode', title: '\u8bbe\u5907\u7f16\u7801', width: 140 },
                        { field: 'FacilityName', title: '\u8bbe\u5907\u540d\u79f0', minWidth: 160 },
                        { field: 'Model', title: '\u8bbe\u5907\u578b\u53f7', width: 130 },
                        { field: 'WeekTempName', title: '\u5468\u4fdd\u517b\u6a21\u677f', width: 120 },
                        { field: 'MonthTempName', title: '\u6708\u4fdd\u517b\u6a21\u677f', width: 120 },
                        { field: 'SeasonTempName', title: '\u5b63\u5ea6\u4fdd\u517b\u6a21\u677f', width: 120 },
                        { field: 'HalfYearTempName', title: '\u534a\u5e74\u4fdd\u517b\u6a21\u677f', width: 120, templet: function (d) { return rowField(d, 'HalfYearTempName'); } },
                        { field: 'YearTempName', title: '\u5e74\u4fdd\u517b\u6a21\u677f', width: 120 }
                    ]]
                });
            }

            function refreshCurrentView() {
                if (currentView === 'list') {
                    table.reload('GridMain', { where: getWhere() });
                } else if (currentView === 'kanban') {
                    loadAllBills(renderKanban);
                } else if (currentView === 'calendar') {
                    loadAllBills(renderCalendar);
                } else if (currentView === 'gantt') {
                    loadAllBills(renderGantt);
                }
            }

            $('#statusPills button').on('click', function () {
                $('#statusPills button').addClass('layui-btn-primary');
                $(this).removeClass('layui-btn-primary');
                currentStatus = $(this).data('status');
                refreshCurrentView();
            });

            form.on('select(planCycleSel)', function (data) {
                planState.cycle = (data.value || 'MONTH').toString().trim().toUpperCase();
                refreshPlanGrid();
            });

            $('#btnPlan').on('click', openPlanDialog);
            $('#btnReload').on('click', refreshCurrentView);
            $('#kw').on('keydown', function (e) { if (e.keyCode === 13) $('#btnReload').click(); });

            // list / kanban / calendar / gantt
            var currentView = 'list';
            var allBills = [];
            var calCursor = new Date();
            var ganttCursor = new Date();
            var ganttScale = 'MONTH';
            var ganttGroup = 'facility';

            function loadAllBills(cb) {
                var sp = [];
                var kw = $('#kw').val();
                if (kw) sp.push({ field: 'BillNo', conditional: 'like', value: kw });
                if (currentStatus !== '') sp.push({ field: 'Status', conditional: 'eq', value: currentStatus });
                $.post(URL_MAIN_LIST, { page: 1, limit: 9999, searchParam: sp }, function (res) {
                    allBills = (res && res.data) ? res.data : [];
                    if (cb) cb();
                });
            }

            $('#btnViewList').on('click', function () { showPane('list'); });
            $('#btnViewKanban').on('click', function () { showPane('kanban'); });
            $('#btnViewCalendar').on('click', function () { showPane('calendar'); });
            $('#btnViewGantt').on('click', function () { showPane('gantt'); });

            function syncViewButtons(active) {
                $('#btnViewList,#btnViewKanban,#btnViewCalendar,#btnViewGantt').addClass('layui-btn-primary');
                if (active === 'list') $('#btnViewList').removeClass('layui-btn-primary');
                if (active === 'kanban') $('#btnViewKanban').removeClass('layui-btn-primary');
                if (active === 'calendar') $('#btnViewCalendar').removeClass('layui-btn-primary');
                if (active === 'gantt') $('#btnViewGantt').removeClass('layui-btn-primary');
            }

            function showPane(name) {
                currentView = name;
                syncViewButtons(name);
                $('#paneList,#paneKanban,#paneCalendar,#paneGantt').hide();
                $('#paneList').toggle(name === 'list');
                if (name === 'list') { table.reload('GridMain', { where: getWhere() }); }
                if (name === 'kanban')  { $('#paneKanban').show();  loadAllBills(renderKanban); }
                if (name === 'calendar'){ $('#paneCalendar').show();loadAllBills(renderCalendar); }
                if (name === 'gantt')   { $('#paneGantt').show();   loadAllBills(renderGantt); }
            }

            // ---------------- Kanban ----------------
            function renderKanban() {
                var cols = [
                    { status: 0, name: '\u65b0\u5efa', color: '#f7b500' },
                    { status: 1, name: '\u5df2\u6d3e\u5de5', color: '#1e88e5' },
                    { status: 2, name: '\u4fdd\u517b\u4e2d', color: '#7c3aed' },
                    { status: 3, name: '\u5df2\u4fdd\u517b', color: '#16a34a' },
                    { status: 4, name: '\u5df2\u5ba1\u6838', color: '#475569' }
                ];
                var grouped = {};
                cols.forEach(function (c) { grouped[c.status] = []; });
                allBills.forEach(function (b) {
                    var sid = b.Status != null ? b.Status : b.status;
                    var s = parseInt(sid, 10);
                    if (isNaN(s)) s = 0;
                    if (grouped[s]) grouped[s].push(b);
                });
                var html = '';
                cols.forEach(function (c) {
                    var arr = grouped[c.status];
                    html += '<div class="kanban-col" style="flex:0 0 260px;background:#f7f8fa;border-radius:6px;padding:8px;">';
                    html += '<div style="font-weight:600;padding:4px 6px;border-bottom:2px solid ' + c.color + ';margin-bottom:8px;color:' + c.color + ';">'
                        + c.name + ' <span style="color:#888;font-weight:normal;">(' + arr.length + ')</span></div>';
                    arr.forEach(function (b) {
                        var mt = b.MaintainType != null && b.MaintainType !== '' ? b.MaintainType : (b.maintainType || '');
                        var cycle = cycleText(String(mt).toUpperCase());
                        var fid = b.FacilityID != null && b.FacilityID !== '' ? b.FacilityID : (b.facilityID || '');
                        html += '<div class="kanban-card" data-id="' + rowId(b) + '" '
                            + 'style="background:#fff;border:1px solid #e2e8f0;border-left:4px solid ' + c.color + ';'
                            + 'border-radius:4px;padding:8px;margin-bottom:8px;cursor:pointer;font-size:12px;">'
                            + '<div style="font-weight:600;color:#1f4d3b;">' + (b.BillNo || '') + '</div>'
                            + '<div style="margin-top:4px;color:#555;">\u8bbe\u5907\uff1a' + fid + '</div>'
                            + '<div style="color:#555;">\u7c7b\u578b\uff1a' + cycle + '</div>'
                            + '<div style="color:#888;">\u8ba1\u5212\uff1a' + fmtDate(b.BillDate) + '</div>'
                            + '</div>';
                    });
                    if (arr.length === 0) html += '<div style="color:#bbb;font-size:12px;text-align:center;padding:20px 0;">\u6682\u65e0</div>';
                    html += '</div>';
                });
                $('#kanbanBoard').html(html);
                $('#kanbanBoard .kanban-card').on('click', function () {
                    var id = $(this).data('id');
                    var row = allBills.find(function (b) { return rowId(b) === id; });
                    if (row) openDetail(row, true);
                });
            }

            // ---------------- Calendar ----------------
            function renderCalendar() {
                var year = calCursor.getFullYear(), month = calCursor.getMonth();
                $('#calTitle').text(year + '-' + pad2(month + 1));
                var first = new Date(year, month, 1);
                var startWeekday = first.getDay();
                var daysInMonth = new Date(year, month + 1, 0).getDate();
                var byDate = {};
                allBills.forEach(function (b) {
                    var bd = b.BillDate || b.billDate;
                    if (!bd) return;
                    var key = (bd + '').substring(0, 10);
                    if (!byDate[key]) byDate[key] = [];
                    byDate[key].push(b);
                });
                var html = '';
                var day = 1;
                for (var w = 0; w < 6; w++) {
                    html += '<tr>';
                    for (var d = 0; d < 7; d++) {
                        var idx = w * 7 + d;
                        if (idx < startWeekday || day > daysInMonth) {
                            html += '<td style="border:1px solid #e2e8f0;height:110px;vertical-align:top;background:#fafafa;"></td>';
                        } else {
                            var dateStr = year + '-' + pad2(month + 1) + '-' + pad2(day);
                            var items = byDate[dateStr] || [];
                            html += '<td style="border:1px solid #e2e8f0;height:110px;vertical-align:top;padding:4px;">';
                            html += '<div style="font-size:12px;color:#888;">' + day + '</div>';
                            items.slice(0, 4).forEach(function (b) {
                                var sid = b.Status != null ? b.Status : b.status;
                                var sn = parseInt(sid, 10);
                                if (isNaN(sn)) sn = 0;
                                var c = statusColor(sn);
                                html += '<div class="cal-item" data-id="' + rowId(b) + '" '
                                    + 'style="font-size:11px;background:' + c + '22;border-left:3px solid ' + c + ';'
                                    + 'padding:2px 4px;margin-top:2px;cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">'
                                    + (b.BillNo || '') + '</div>';
                            });
                            if (items.length > 4) html += '<div style="font-size:11px;color:#888;">+' + (items.length - 4) + '</div>';
                            html += '</td>';
                            day++;
                        }
                    }
                    html += '</tr>';
                    if (day > daysInMonth) break;
                }
                $('#calBody').html(html);
                $('#calBody .cal-item').on('click', function () {
                    var id = $(this).data('id');
                    var row = allBills.find(function (b) { return rowId(b) === id; });
                    if (row) openDetail(row, true);
                });
            }
            $('#calPrev').on('click', function () { calCursor = new Date(calCursor.getFullYear(), calCursor.getMonth() - 1, 1); renderCalendar(); });
            $('#calNext').on('click', function () { calCursor = new Date(calCursor.getFullYear(), calCursor.getMonth() + 1, 1); renderCalendar(); });
            $('#calToday').on('click', function () { calCursor = new Date(); renderCalendar(); });

            function statusColor(s) { return ({0:'#f7b500',1:'#1e88e5',2:'#7c3aed',3:'#16a34a',4:'#475569'})[s] || '#999'; }
            function pad2(n) { return n < 10 ? '0' + n : '' + n; }

            // ---------------- Gantt ----------------
            $('.gantt-scale').on('click', function () {
                $('.gantt-scale').addClass('layui-btn-primary');
                $(this).removeClass('layui-btn-primary');
                ganttScale = $(this).data('scale');
                renderGantt();
            });
            $('.gantt-group').on('click', function () {
                $('.gantt-group').addClass('layui-btn-primary');
                $(this).removeClass('layui-btn-primary');
                ganttGroup = $(this).data('group');
                renderGantt();
            });
            $('#ganttPrev').on('click', function () { shiftGantt(-1); });
            $('#ganttNext').on('click', function () { shiftGantt(1); });
            function shiftGantt(dir) {
                if (ganttScale === 'WEEK')    ganttCursor.setDate(ganttCursor.getDate() + dir * 7);
                if (ganttScale === 'MONTH')   ganttCursor.setMonth(ganttCursor.getMonth() + dir);
                if (ganttScale === 'QUARTER') ganttCursor.setMonth(ganttCursor.getMonth() + dir * 3);
                if (ganttScale === 'YEAR')    ganttCursor.setFullYear(ganttCursor.getFullYear() + dir);
                renderGantt();
            }

            function getGanttRange() {
                var s = new Date(ganttCursor), e = new Date(ganttCursor);
                if (ganttScale === 'WEEK')    { s.setDate(s.getDate() - s.getDay()); e = new Date(s); e.setDate(s.getDate() + 6); }
                if (ganttScale === 'MONTH')   { s = new Date(s.getFullYear(), s.getMonth(), 1); e = new Date(s.getFullYear(), s.getMonth() + 1, 0); }
                if (ganttScale === 'QUARTER') { var q = Math.floor(s.getMonth() / 3); s = new Date(s.getFullYear(), q * 3, 1); e = new Date(s.getFullYear(), q * 3 + 3, 0); }
                if (ganttScale === 'YEAR')    { s = new Date(s.getFullYear(), 0, 1); e = new Date(s.getFullYear(), 11, 31); }
                s.setHours(0, 0, 0, 0); e.setHours(23, 59, 59, 999);
                return { start: s, end: e };
            }

            function renderGantt() {
                var range = getGanttRange();
                var startMs = range.start.getTime(), endMs = range.end.getTime();
                var totalDays = Math.round((endMs - startMs) / 86400000) + 1;
                $('#ganttRange').text(fmtDate(range.start) + ' ~ ' + fmtDate(range.end));

                var bills = allBills.filter(function (b) {
                    var bd = b.BillDate || b.billDate;
                    var bs = bd ? new Date(bd).getTime() : 0;
                    return bs >= startMs && bs <= endMs;
                });

                var groups = {};
                var groupOrder = [];
                bills.forEach(function (b) {
                    var fid = b.FacilityID != null && b.FacilityID !== '' ? b.FacilityID : (b.facilityID || '-');
                    var key = ganttGroup === 'facility'
                        ? ('\u8bbe\u5907 ' + fid)
                        : (b.BillNo || '\u65e0\u5355\u53f7');
                    if (!groups[key]) { groups[key] = []; groupOrder.push(key); }
                    groups[key].push(b);
                });

                var cells = [];
                if (ganttScale === 'WEEK' || ganttScale === 'MONTH') {
                    for (var i = 0; i < totalDays; i++) {
                        var d = new Date(startMs + i * 86400000);
                        cells.push({ label: pad2(d.getMonth() + 1) + '/' + pad2(d.getDate()), start: d.getTime(), end: d.getTime() + 86400000 - 1 });
                    }
                } else if (ganttScale === 'QUARTER') {
                    for (var w = new Date(range.start); w <= range.end; w.setDate(w.getDate() + 7)) {
                        var ws = new Date(w), we = new Date(w); we.setDate(we.getDate() + 6);
                        cells.push({ label: pad2(ws.getMonth() + 1) + '/' + pad2(ws.getDate()), start: ws.getTime(), end: we.getTime() });
                    }
                } else {
                    for (var m = 0; m < 12; m++) {
                        var ms = new Date(range.start.getFullYear(), m, 1);
                        var me = new Date(range.start.getFullYear(), m + 1, 0);
                        cells.push({ label: (m + 1) + '\u6708', start: ms.getTime(), end: me.getTime() + 86399999 });
                    }
                }

                var labelW = 160, cellW = ganttScale === 'YEAR' ? 80 : (ganttScale === 'QUARTER' ? 60 : 36);
                var totalW = labelW + cells.length * cellW;

                var html = '<table style="border-collapse:collapse;width:' + totalW + 'px;font-size:12px;">';
                html += '<thead><tr><th style="position:sticky;left:0;background:#f5f5f5;border:1px solid #e2e8f0;padding:6px;width:' + labelW + 'px;text-align:left;">' + (ganttGroup === 'facility' ? '\u8bbe\u5907' : '\u4fdd\u517b\u5355') + '</th>';
                cells.forEach(function (c) {
                    html += '<th style="border:1px solid #e2e8f0;padding:4px 2px;width:' + cellW + 'px;background:#f5f5f5;font-weight:normal;">' + c.label + '</th>';
                });
                html += '</tr></thead><tbody>';

                if (groupOrder.length === 0) {
                    html += '<tr><td colspan="' + (cells.length + 1) + '" style="padding:24px;text-align:center;color:#888;">\u6682\u65e0\u6570\u636e</td></tr>';
                } else {
                    groupOrder.forEach(function (key) {
                        html += '<tr><td style="position:sticky;left:0;background:#fff;border:1px solid #e2e8f0;padding:6px;">' + key + '</td>';
                        cells.forEach(function (c) {
                            var items = groups[key].filter(function (b) {
                                var bd = b.BillDate || b.billDate;
                                var bs = bd ? new Date(bd).getTime() : 0;
                                return bs >= c.start && bs <= c.end;
                            });
                            html += '<td style="border:1px solid #e2e8f0;padding:1px;position:relative;">';
                            items.forEach(function (b) {
                                var sid = b.Status != null ? b.Status : b.status;
                                var sn = parseInt(sid, 10);
                                if (isNaN(sn)) sn = 0;
                                var color = statusColor(sn);
                                html += '<div class="gantt-bar" data-id="' + rowId(b) + '" title="' + (b.BillNo || '') + '" '
                                    + 'style="background:' + color + ';color:#fff;font-size:10px;border-radius:3px;'
                                    + 'padding:2px 4px;margin-bottom:1px;cursor:pointer;white-space:nowrap;overflow:hidden;'
                                    + 'text-overflow:ellipsis;">' + (b.BillNo || '').replace(/^TPM0*/, 'TPM') + '</div>';
                            });
                            html += '</td>';
                        });
                        html += '</tr>';
                    });
                }
                html += '</tbody></table>';
                $('#ganttContainer').html(html);
                $('#ganttContainer .gantt-bar').on('click', function () {
                    var id = $(this).data('id');
                    var row = allBills.find(function (b) { return rowId(b) === id; });
                    if (row) openDetail(row, true);
                });
            }

            table.on('tool(GridMain)', function (obj) {
                if (obj.event === 'view') openDetail(obj.data, true);
                if (obj.event === 'edit') openDetail(obj.data, false);
                if (obj.event === 'del') {
                    layer.confirm('\u786e\u8ba4\u5220\u9664\u8be5\u4fdd\u517b\u5355\uff08\u5df2\u6d3e\u5de5\u4e0d\u5141\u8bb8\u5220\u9664\uff09\uff1f', function (idx) {
                        $.post(URL_DELETE_BILL, { id: obj.data.Id }, function (res) {
                            layer.close(idx);
                            if (ok(res)) { obj.del(); toastOk('\u5220\u9664\u6210\u529f'); }
                            else toastErr(res.msg || '\u5220\u9664\u5931\u8d25');
                        });
                    });
                }
            });

            function formatToday() {
                var d = new Date();
                var pad = function (n) { return n < 10 ? '0' + n : '' + n; };
                return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
            }

            renderList();
            form.render();
        });
    </script>
}
