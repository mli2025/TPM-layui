@{
    ViewData["Title"] = "保养工单列表";
}
<div class="layui-fluid" style="padding:12px;">
    <div class="layui-card">
        <div class="layui-card-header"><strong>保养工单列表</strong></div>
        <div class="layui-card-body">
            <div class="layui-form layui-row layui-col-space10" style="margin-bottom:8px;">
                <div class="layui-col-md5">
                    <input type="text" id="kwBill" class="layui-input" placeholder="按单据编号模糊查询">
                </div>
                <div class="layui-col-md7" style="text-align:right;">
                    <button type="button" class="layui-btn layui-btn-sm" id="btnBillAdd"><i class="layui-icon layui-icon-add-1"></i> 新增</button>
                    <button type="button" class="layui-btn layui-btn-sm layui-btn-primary" id="btnBillReload"><i class="layui-icon layui-icon-refresh-3"></i> 刷新</button>
                    <button type="button" class="layui-btn layui-btn-sm layui-btn-warm" id="btnBillExport">导出</button>
                </div>
            </div>
            <table id="GridBillMain" lay-filter="GridBillMain"></table>
        </div>
    </div>
</div>

<script type="text/html" id="barBill">
    <a class="layui-btn layui-btn-xs layui-btn-normal" lay-event="view">查看</a>
    <a class="layui-btn layui-btn-xs" lay-event="edit">编辑</a>
    <a class="layui-btn layui-btn-xs layui-btn-danger" lay-event="del">删除</a>
</script>

<script type="text/html" id="tplBillForm">
    <form class="layui-form" lay-filter="billForm" style="padding:14px 16px 0 0;">
        <input type="hidden" name="Id">
        <div class="layui-form-item">
            <label class="layui-form-label">单据编号</label>
            <div class="layui-input-block" style="display:flex;gap:8px;align-items:center;">
                <input name="BillNo" required lay-verify="required" class="layui-input" placeholder="必填，可点右侧生成" style="flex:1;">
                <button type="button" class="layui-btn layui-btn-primary layui-btn-sm" id="btnGenBillNo">生成编号</button>
            </div>
        </div>
        <div class="layui-form-item">
            <label class="layui-form-label">单据日期</label>
            <div class="layui-input-block"><input name="BillDate" id="billDateInput" class="layui-input" lay-verify="required"></div>
        </div>
        <div class="layui-form-item">
            <label class="layui-form-label">单据类型</label>
            <div class="layui-input-block"><input name="BillType" class="layui-input" placeholder="如 MAINTENANCE"></div>
        </div>
        <div class="layui-form-item">
            <label class="layui-form-label">开始时间</label>
            <div class="layui-input-block"><input name="BeginDate" id="billBeginInput" class="layui-input"></div>
        </div>
        <div class="layui-form-item">
            <label class="layui-form-label">结束时间</label>
            <div class="layui-input-block"><input name="EndDate" id="billEndInput" class="layui-input"></div>
        </div>
        <div class="layui-form-item">
            <label class="layui-form-label">设备ID</label>
            <div class="layui-input-block"><input name="FacilityID" type="number" class="layui-input" placeholder="设备主键"></div>
        </div>
        <div class="layui-form-item">
            <label class="layui-form-label">模板ID</label>
            <div class="layui-input-block"><input name="TempID" type="number" class="layui-input" placeholder="保养模板主表Id"></div>
        </div>
        <div class="layui-form-item">
            <label class="layui-form-label">保养方式</label>
            <div class="layui-input-block"><input name="MaintainType" class="layui-input" placeholder="英文或业务编码"></div>
        </div>
        <div class="layui-form-item">
            <label class="layui-form-label">状态</label>
            <div class="layui-input-block">
                <select name="Status">
                    <option value="0">草稿</option>
                    <option value="1">进行中</option>
                    <option value="2">已完成</option>
                    <option value="9">已关闭</option>
                </select>
            </div>
        </div>
        <div class="layui-form-item">
            <label class="layui-form-label">备注</label>
            <div class="layui-input-block"><input name="Remark" class="layui-input"></div>
        </div>
    </form>
</script>

@section Script{
    <script>
        layui.use(['table', 'form', 'layer', 'laydate'], function () {
            var table = layui.table, form = layui.form, layer = layui.layer, laydate = layui.laydate;
            function ok(res) { return res && (res.code === 0 || res.code === 200); }

            function pick() {
                for (var i = 0; i < arguments.length; i++) {
                    var v = arguments[i];
                    if (v !== undefined && v !== null) return v;
                }
                return undefined;
            }
            function normalizeBillRow(d) {
                if (!d || typeof d !== 'object') return d;
                return {
                    Id: pick(d.Id, d.id),
                    BillNo: pick(d.BillNo, d.billNo),
                    BillDate: pick(d.BillDate, d.billDate),
                    BillType: pick(d.BillType, d.billType),
                    BeginDate: pick(d.BeginDate, d.beginDate),
                    EndDate: pick(d.EndDate, d.endDate),
                    FacilityID: pick(d.FacilityID, d.facilityID),
                    TempID: pick(d.TempID, d.tempID),
                    MaintainType: pick(d.MaintainType, d.maintainType),
                    Status: pick(d.Status, d.status),
                    Remark: pick(d.Remark, d.remark)
                };
            }

            function billStatusText(s) {
                var n = parseInt(s, 10);
                if (n === 0) return '草稿';
                if (n === 1) return '进行中';
                if (n === 2) return '已完成';
                if (n === 9) return '已关闭';
                return s === undefined || s === null || s === '' ? '' : String(s);
            }

            function getBillWhere() {
                var list = [];
                var kw = ($('#kwBill').val() || '').trim();
                if (kw) list.push({ field: 'BillNo', conditional: 'like', value: kw });
                return { searchParam: list };
            }

            function reloadBillGrid() {
                table.reload('GridBillMain', { page: { curr: 1 }, where: getBillWhere() });
            }

            function bindBillLaydateIn(wrap) {
                var $w = wrap && wrap.length ? wrap : $(document);
                var e1 = $w.find('#billDateInput')[0], e2 = $w.find('#billBeginInput')[0], e3 = $w.find('#billEndInput')[0];
                if (e1) laydate.render({ elem: e1, type: 'datetime' });
                if (e2) laydate.render({ elem: e2, type: 'datetime' });
                if (e3) laydate.render({ elem: e3, type: 'datetime' });
            }

            function formatDt(v) {
                if (!v) return '';
                return String(v).substring(0, 16).replace('T', ' ');
            }

            function openBillForm(data) {
                var isNew = !data;
                var payload = data ? normalizeBillRow(data) : {
                    Id: 0,
                    BillNo: '',
                    BillDate: new Date().toISOString().substring(0, 16).replace('T', ' '),
                    BillType: 'MAINTENANCE',
                    Status: 0,
                    Remark: ''
                };
                layer.open({
                    type: 1,
                    title: isNew ? '新增保养工单' : '编辑保养工单',
                    area: ['560px', '620px'],
                    content: $('#tplBillForm').html(),
                    btn: ['保存', '关闭'],
                    success: function (layero, idx) {
                        var wrap = $(layero);
                        form.render();
                        bindBillLaydateIn(wrap);
                        form.val('billForm', payload);
                        wrap.find('#btnGenBillNo').off('click').on('click', function () {
                            $.get('@Url.Action("NextBillNo")', function (res) {
                                if (ok(res) && res.data) {
                                    wrap.find('input[name="BillNo"]').val(res.data);
                                    App.success('已生成编号');
                                } else App.error((res && res.msg) || '生成失败');
                            });
                        });
                    },
                    yes: function (idx) {
                        var row = form.val('billForm');
                        row.FacilityID = row.FacilityID === '' || row.FacilityID === undefined ? '' : row.FacilityID;
                        row.TempID = row.TempID === '' || row.TempID === undefined ? '' : row.TempID;
                        row.Status = row.Status === '' || row.Status === undefined ? '0' : row.Status;
                        $.post('@Url.Action("SaveMain")', row, function (res) {
                            if (ok(res)) {
                                layer.close(idx);
                                reloadBillGrid();
                                App.success('保存成功');
                            } else App.error(res.msg || '保存失败');
                        });
                    },
                    btn2: function (idx) { layer.close(idx); }
                });
            }

            table.render({
                elem: '#GridBillMain',
                id: 'GridBillMain',
                url: '@Url.Action("GetMainList")',
                method: 'post',
                where: getBillWhere(),
                page: true,
                limit: 20,
                limits: [10, 20, 50],
                height: 'full-220',
                parseData: function (res) {
                    var raw = res && res.data ? res.data : [];
                    var data = [];
                    for (var i = 0; i < raw.length; i++) data.push(normalizeBillRow(raw[i]));
                    return {
                        code: res ? (res.code === 200 ? 0 : res.code) : 1,
                        msg: (res && res.msg) || '',
                        count: res && res.count != null ? res.count : 0,
                        data: data
                    };
                },
                cols: [[
                    { type: 'numbers', title: '#' },
                    { field: 'BillNo', title: '单据编号', width: 150 },
                    { field: 'BillDate', title: '单据日期', width: 160, templet: function (d) { return formatDt(d.BillDate); } },
                    { field: 'BillType', title: '单据类型', width: 120 },
                    { field: 'BeginDate', title: '开始时间', width: 160, templet: function (d) { return formatDt(d.BeginDate); } },
                    { field: 'EndDate', title: '结束时间', width: 160, templet: function (d) { return formatDt(d.EndDate); } },
                    { field: 'FacilityID', title: '设备ID', width: 100 },
                    { field: 'TempID', title: '模板ID', width: 100 },
                    { field: 'MaintainType', title: '保养方式', width: 110 },
                    { field: 'Status', title: '状态', width: 90, templet: function (d) { return billStatusText(d.Status); } },
                    { field: 'Remark', title: '备注', minWidth: 140 },
                    { title: '操作', width: 200, toolbar: '#barBill', fixed: 'right' }
                ]]
            });

            $('#btnBillAdd').on('click', function () { openBillForm(null); });
            $('#btnBillReload').on('click', function () { reloadBillGrid(); });
            $('#kwBill').on('keydown', function (e) { if (e.keyCode === 13) reloadBillGrid(); });
            $('#btnBillExport').on('click', function () {
                var f = $('<form>', { method: 'post', action: '@Url.Action("ExportExcel")', target: '_blank' });
                var p = getBillWhere().searchParam || [];
                for (var i = 0; i < p.length; i++) {
                    f.append($('<input>', { type: 'hidden', name: 'searchParam[' + i + '].field', value: p[i].field || '' }));
                    f.append($('<input>', { type: 'hidden', name: 'searchParam[' + i + '].conditional', value: p[i].conditional || '' }));
                    f.append($('<input>', { type: 'hidden', name: 'searchParam[' + i + '].value', value: p[i].value || '' }));
                }
                f.appendTo(document.body).trigger('submit').remove();
            });

            table.on('tool(GridBillMain)', function (obj) {
                if (obj.event === 'view') {
                    layer.open({
                        type: 2,
                        title: '保养工单查看',
                        area: ['90%', '90%'],
                        content: '@Url.Action("ViewList")?id=' + obj.data.Id
                    });
                }
                if (obj.event === 'edit') openBillForm(obj.data);
                if (obj.event === 'del') {
                    layer.confirm('确认删除该工单？', function (i2) {
                        $.post('@Url.Action("DeleteMain")', { id: obj.data.Id }, function (res) {
                            layer.close(i2);
                            if (ok(res)) {
                                obj.del();
                                App.success('删除成功');
                            } else App.error(res.msg || '删除失败');
                        });
                    });
                }
            });

            form.render();
        });
    </script>
}
