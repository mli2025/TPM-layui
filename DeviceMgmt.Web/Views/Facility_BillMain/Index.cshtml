    <a class="layui-btn layui-btn-xs layui-btn-danger" lay-event="del">删除</a>
    {{# } }}
</script>

<script type="text/html" id="statusTpl">
    {{# var map = {0:'新建',1:'已派�?,2:'保养�?,3:'已保�?,4:'已审�?}; }}
    {{# var color = {0:'#f7b500',1:'#1e88e5',2:'#7c3aed',3:'#16a34a',4:'#475569'}; }}
    {{# var s = (d.Status == null) ? 0 : d.Status; }}
    <span class="layui-badge" style="background-color:{{= color[s] || '#999' }};">{{= map[s] || s }}</span>
</script>

<script type="text/html" id="cycleTpl">
    {{# var c = (d.MaintainType||'').toUpperCase(); }}
    {{# var name = {YEAR:'�?,QUARTER:'季度',MONTH:'�?,WEEK:'�?}[c] || c; }}
    <span>{{= name }}</span>
</script>

