@{
    ViewData["Title"] = "设备保养单列�?;
}
<div class="layui-fluid" style="padding:12px;">
    <div class="layui-card">
        <div class="layui-card-header">
            <strong>设备保养单列�?/strong>
            <span class="layui-btn-group" style="float:right;">
                <button class="layui-btn layui-btn-sm" id="btnViewList"><i class="layui-icon layui-icon-list"></i> 列表</button>
                <button class="layui-btn layui-btn-sm layui-btn-primary" id="btnViewKanban"><i class="layui-icon layui-icon-template-1"></i> 状态看�?/button>
                <button class="layui-btn layui-btn-sm layui-btn-primary" id="btnViewCalendar"><i class="layui-icon layui-icon-date"></i> 日历</button>
                <button class="layui-btn layui-btn-sm layui-btn-primary" id="btnViewGantt"><i class="layui-icon layui-icon-chart"></i> 甘特�?/button>
            </span>
        </div>
        <div class="layui-card-body">
            <div class="layui-form layui-row layui-col-space10" style="margin-bottom:8px;">
                <div class="layui-col-md4">
                    <input type="text" id="kw" class="layui-input" placeholder="输入单号/设备编码/设备名称查询">
                </div>
                <div class="layui-col-md4" id="statusPills">
                    <button class="layui-btn layui-btn-sm" data-status="">全部</button>
                    <button class="layui-btn layui-btn-sm layui-btn-primary" data-status="0">新建</button>
                    <button class="layui-btn layui-btn-sm layui-btn-primary" data-status="1">已派�?/button>
                    <button class="layui-btn layui-btn-sm layui-btn-primary" data-status="2">保养�?/button>
                    <button class="layui-btn layui-btn-sm layui-btn-primary" data-status="3">已保�?/button>
                    <button class="layui-btn layui-btn-sm layui-btn-primary" data-status="4">已审�?/button>
                </div>
                <div class="layui-col-md4" style="text-align:right;">
                    <button class="layui-btn layui-btn-sm" id="btnPlan"><i class="layui-icon layui-icon-add-1"></i> 建立保养计划</button>
                    <button class="layui-btn layui-btn-sm layui-btn-primary" id="btnReload"><i class="layui-icon layui-icon-refresh-3"></i> 刷新</button>
                </div>
            </div>

            <div id="paneList">
                <table id="GridMain" lay-filter="GridMain"></table>
            </div>
            <div id="panePlaceholder" style="display:none;padding:48px;text-align:center;color:#888;font-size:14px;">
                <i class="layui-icon" style="font-size:48px;color:#ccc;"></i>
                <div style="margin-top:12px;" id="placeholderText">该视图开发中...</div>
            </div>
        </div>
    </div>
</div>

<script type="text/html" id="barRow">
