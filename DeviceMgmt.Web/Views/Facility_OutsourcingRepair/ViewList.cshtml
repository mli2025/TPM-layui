@{
    ViewData["Title"] = "澶栧缁翠慨 Facility_OutsourcingRepair - 鏌ョ湅";
    var id = (long)(ViewBag.Id ?? 0L);
}
<div class="layui-fluid" style="padding:14px;">
    <div class="layui-card">
        <div class="layui-card-header"><b>澶栧缁翠慨 Facility_OutsourcingRepair</b> &nbsp;<span style="color:#999;font-size:12px;">Id = @id</span></div>
        <div class="layui-card-body">
            <form id="viewFormMain" class="layui-form layui-form-pane">
                <div class="layui-row layui-col-space10">
                    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>Id</label><div class='layui-input-block'><input type='text' name='Id' class='layui-input' readonly /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>RepairBillMainid</label><div class='layui-input-block'><input type='text' name='RepairBillMainid' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>Number</label><div class='layui-input-block'><input type='text' name='Number' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>Unit</label><div class='layui-input-block'><input type='text' name='Unit' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>FaultDescription</label><div class='layui-input-block'><input type='text' name='FaultDescription' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>Status</label><div class='layui-input-block'><input type='text' name='Status' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>Creater</label><div class='layui-input-block'><input type='text' name='Creater' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>Acceptance</label><div class='layui-input-block'><input type='text' name='Acceptance' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>Appendix</label><div class='layui-input-block'><input type='text' name='Appendix' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>CreaterDate</label><div class='layui-input-block'><input type='text' name='CreaterDate' class='layui-input' lay-verify='datetime' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>AcceptanceDate</label><div class='layui-input-block'><input type='text' name='AcceptanceDate' class='layui-input' lay-verify='datetime' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>AcceptanceComments</label><div class='layui-input-block'><input type='text' name='AcceptanceComments' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>FaultLocation</label><div class='layui-input-block'><input type='text' name='FaultLocation' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>FaultCategory</label><div class='layui-input-block'><input type='text' name='FaultCategory' class='layui-input' /></div></div></div>
    <div class='layui-col-md4 layui-col-sm6'><div class='layui-form-item'><label class='layui-form-label'>Amount</label><div class='layui-input-block'><input type='text' name='Amount' class='layui-input' /></div></div></div>
                </div>
            </form>
        </div>
    </div>
</div>
@section Script{
    <script>
        layui.use(['form','laydate'], function () {
            var form = layui.form, laydate = layui.laydate;
            $('input[lay-verify*=datetime]').each(function () { laydate.render({ type: 'datetime', elem: this }); });
            $.get('@Url.Action("GetMainInfo")', { Id: @id }, function (res) {
                if (res && res.data) {
                    for (var k in res.data) {
                        $("#viewFormMain *[name='" + k + "']").val(res.data[k]);
                    }
                    $("#viewFormMain input, #viewFormMain textarea, #viewFormMain select").attr('readonly', 'readonly').attr('disabled', 'disabled');
                    form.render();
                }
            });
        });
    </script>
}