@{
    ViewData["Title"] = "维保标准库";
}
<div class="layui-fluid" style="padding:12px;">
    <div class="layui-card">
        <div class="layui-card-header"><strong>维保标准库</strong>
            <button class="layui-btn layui-btn-sm" id="btnAdd" style="float:right;margin-top:6px;">新增标准</button>
        </div>
        <div class="layui-card-body">
            <table id="GridMain" lay-filter="GridMain"></table>
        </div>
    </div>
</div>

<script type="text/html" id="barRow">
    <a class="layui-btn layui-btn-xs" lay-event="edit">编辑</a>
    <a class="layui-btn layui-btn-xs layui-btn-danger" lay-event="del">删除</a>
</script>

<script type="text/html" id="tplForm">
    <div style="padding:16px;">
        <form class="layui-form" lay-filter="stdForm">
            <input type="hidden" name="Id" />
            <div class="layui-form-item">
                <div class="layui-inline"><label class="layui-form-label">标准编号</label><div class="layui-input-inline"><input type="text" name="StdNo" class="layui-input"></div></div>
                <div class="layui-inline"><label class="layui-form-label">设备名称</label><div class="layui-input-inline"><input type="text" name="FacilityName" class="layui-input"></div></div>
                <div class="layui-inline"><label class="layui-form-label">设备类型</label><div class="layui-input-inline"><input type="text" name="FacilityType" class="layui-input"></div></div>
            </div>
            <div class="layui-form-item">
                <div class="layui-inline"><label class="layui-form-label">周期类型</label><div class="layui-input-inline">
                    <select name="CycleType"><option value="日常">日常</option><option value="周">周</option><option value="月度">月度</option><option value="季度">季度</option><option value="年度">年度</option></select>
                </div></div>
                <div class="layui-inline"><label class="layui-form-label">维保方式</label><div class="layui-input-inline">
                    <select name="EntrustType"><option value="自维">自维</option><option value="外委">外委</option></select>
                </div></div>
                <div class="layui-inline"><label class="layui-form-label">设备Id</label><div class="layui-input-inline"><input type="number" name="FacilityId" class="layui-input"></div></div>
            </div>
            <fieldset class="layui-elem-field layui-field-title" style="margin-top:6px;"><legend>保养项明细
                <button class="layui-btn layui-btn-xs" type="button" id="btnAddSub" style="margin-left:10px;">添加项</button>
            </legend></fieldset>
            <table class="layui-table" style="margin:0;"><thead><tr><th>保养项</th><th style="width:120px;">备件Id</th><th style="width:120px;">数量</th><th style="width:60px;">操作</th></tr></thead><tbody id="SubsBody"></tbody></table>
            <div style="text-align:center;margin-top:14px;">
                <button class="layui-btn" lay-submit lay-filter="stdSave">保存</button>
                <button class="layui-btn layui-btn-primary" type="button" id="stdCancel">关闭</button>
            </div>
        </form>
    </div>
</script>

@section Script{
    <script>
        var URL_LIST = '@Url.Action("GetMainList")', URL_GET = '@Url.Action("GetDetail")', URL_SAVE = '@Url.Action("Save")', URL_DEL = '@Url.Action("Delete")';
        layui.use(['table', 'form', 'layer'], function () {
            var table = layui.table, form = layui.form, layer = layui.layer, $ = layui.$;
            function ok(r) { return r && (r.code === 0 || r.code === 200); }
            function addSub(s) {
                s = s || {};
                $('#SubsBody').append('<tr>' +
                    '<td><input class="layui-input s-item" value="' + (s.ItemName || '') + '"></td>' +
                    '<td><input class="layui-input s-spare" type="number" value="' + (s.SpareId || '') + '"></td>' +
                    '<td><input class="layui-input s-qty" type="number" value="' + (s.SpareQty != null ? s.SpareQty : '') + '"></td>' +
                    '<td style="text-align:center;"><a class="layui-btn layui-btn-xs layui-btn-danger sub-del">删</a></td></tr>');
            }
            function collectSubs() {
                var subs = [];
                $('#SubsBody tr').each(function () {
                    var item = $(this).find('.s-item').val();
                    if (!item) return;
                    subs.push({ ItemName: item, SpareId: $(this).find('.s-spare').val() ? parseInt($(this).find('.s-spare').val(), 10) : null, SpareQty: $(this).find('.s-qty').val() ? parseFloat($(this).find('.s-qty').val()) : null });
                });
                return subs;
            }
            function renderList() {
                table.render({
                    elem: '#GridMain', id: 'GridMain', url: URL_LIST, method: 'post',
                    where: { page: 1, limit: 20, searchParam: [] }, page: true, height: 'full-150',
                    cols: [[
                        { type: 'numbers', title: '#' },
                        { field: 'StdNo', title: '标准编号', width: 150 },
                        { field: 'FacilityName', title: '设备名称', width: 160 },
                        { field: 'FacilityType', title: '设备类型', width: 130 },
                        { field: 'CycleType', title: '周期', width: 100 },
                        { field: 'EntrustType', title: '维保方式', width: 100 },
                        { field: 'Status', title: '状态', width: 80, templet: function (d) { return d.Status == 1 ? '启用' : '停用'; } },
                        { title: '操作', width: 140, toolbar: '#barRow', fixed: 'right' }
                    ]]
                });
            }
            function openForm(row) {
                row = row || {};
                layer.open({
                    type: 1, area: ['820px', 'auto'], title: row.Id ? '编辑标准' : '新增标准', content: $('#tplForm').html(),
                    success: function (layero, idx) {
                        $('#SubsBody').empty();
                        $('#btnAddSub').on('click', function () { addSub({}); });
                        $('#SubsBody').on('click', '.sub-del', function () { $(this).closest('tr').remove(); });
                        $('#stdCancel').on('click', function () { layer.close(idx); });
                        if (row.Id) {
                            $.get(URL_GET, { id: row.Id }, function (res) {
                                var d = res.data || {}, m = d.Main || {}, subs = d.Subs || [];
                                form.val('stdForm', { Id: m.Id, StdNo: m.StdNo || '', FacilityName: m.FacilityName || '', FacilityType: m.FacilityType || '', CycleType: m.CycleType || '日常', EntrustType: m.EntrustType || '自维', FacilityId: m.FacilityId || '' });
                                subs.forEach(addSub); form.render();
                            });
                        } else { form.val('stdForm', { Id: 0, CycleType: '日常', EntrustType: '自维' }); form.render(); }
                        form.on('submit(stdSave)', function (data) {
                            var f = data.field;
                            var payload = {
                                Main: { Id: parseInt(f.Id || 0, 10), StdNo: f.StdNo || null, FacilityName: f.FacilityName || null, FacilityType: f.FacilityType || null, CycleType: f.CycleType, EntrustType: f.EntrustType, FacilityId: f.FacilityId ? parseInt(f.FacilityId, 10) : null, Status: 1 },
                                Subs: collectSubs()
                            };
                            $.ajax({ url: URL_SAVE, method: 'POST', contentType: 'application/json', data: JSON.stringify(payload) })
                                .done(function (res) { if (ok(res)) { layer.msg('已保存', { icon: 1 }); layer.close(idx); table.reload('GridMain'); } else layer.msg((res && res.msg) || '失败', { icon: 2 }); });
                            return false;
                        });
                    }
                });
            }
            $('#btnAdd').on('click', function () { openForm({}); });
            table.on('tool(GridMain)', function (obj) {
                if (obj.event === 'edit') openForm(obj.data);
                else if (obj.event === 'del') layer.confirm('确认删除(含明细)?', function (idx) { $.post(URL_DEL, { id: obj.data.Id }, function () { layer.close(idx); obj.del(); }); });
            });
            renderList();
        });
    </script>
}
